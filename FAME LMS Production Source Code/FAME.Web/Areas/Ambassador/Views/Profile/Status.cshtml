@model First_Aid_Made_Easy.Models.AmbassadorStatusVM
@{
    ViewBag.Title = "Application Status";
    Layout = "~/Views/Shared/_LayoutAmbassador.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            @if (Model.Status == "Pending")
            {
                <!-- Pending Status -->
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <div class="icon-circle bg-warning text-white mx-auto" style="width: 80px; height: 80px;">
                                <i class="material-icons" style="font-size: 2.5rem;">hourglass_empty</i>
                            </div>
                        </div>
                        <h4 class="mb-2">Application Under Review</h4>
                        <p class="text-muted mb-4">
                            Thank you for applying to become a FAME Ambassador! <br>
                            Your application is currently being reviewed by our team.
                        </p>
                        <div class="bg-light rounded p-3 mb-4">
                            <div class="row text-center">
                                <div class="col-6">
                                    <small class="text-muted d-block">Applied On</small>
                                    <strong>@Model.AppliedAt?.ToString("MMM dd, yyyy")</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Status</small>
                                    <span class="badge badge-warning">Pending Review</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small mb-0">
                            <i class="material-icons align-middle mr-1" style="font-size: 1rem;">schedule</i>
                            Typically reviewed within 24-48 hours
                        </p>
                    </div>
                </div>

                <!-- What's Next -->
                <div class="card mt-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">What happens next?</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-3 d-flex">
                                <span class="badge badge-success mr-3 mt-1">1</span>
                                <div>
                                    <strong>Application submitted</strong>
                                    <br>
                                    <small class="text-muted">Completed on @Model.AppliedAt?.ToString("MMM dd")</small>
                                </div>
                            </li>
                            <li class="mb-3 d-flex">
                                <span class="badge badge-warning mr-3 mt-1">2</span>
                                <div>
                                    <strong>Under review</strong>
                                    <br>
                                    <small class="text-muted">Our team is reviewing your application</small>
                                </div>
                            </li>
                            <li class="mb-3 d-flex">
                                <span class="badge badge-secondary mr-3 mt-1">3</span>
                                <div>
                                    <strong>Decision notification</strong>
                                    <br>
                                    <small class="text-muted">You'll receive an email with the decision</small>
                                </div>
                            </li>
                            <li class="d-flex">
                                <span class="badge badge-secondary mr-3 mt-1">4</span>
                                <div>
                                    <strong>Start promoting!</strong>
                                    <br>
                                    <small class="text-muted">Get your unique link and start earning</small>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            else if (Model.Status == "Rejected")
            {
                <!-- Rejected Status -->
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <div class="icon-circle bg-danger text-white mx-auto" style="width: 80px; height: 80px;">
                                <i class="material-icons" style="font-size: 2.5rem;">close</i>
                            </div>
                        </div>
                        <h4 class="mb-2">Application Not Approved</h4>
                        <p class="text-muted mb-4">
                            Unfortunately, your ambassador application was not approved at this time.
                        </p>
                        @if (!string.IsNullOrEmpty(Model.RejectionReason))
                        {
                            <div class="alert alert-light border text-left mb-4">
                                <strong>Reason:</strong>
                                <p class="mb-0 mt-1">@Model.RejectionReason</p>
                            </div>
                        }
                        <p class="text-muted small">
                            If you believe this was a mistake or have questions,
                            please contact our support team.
                        </p>
                        <a href="mailto:support@firstaidmadeeasy.com" class="btn btn-outline-primary">
                            <i class="material-icons align-middle mr-1">email</i>
                            Contact Support
                        </a>
                    </div>
                </div>
            }
            else if (Model.Status == "Suspended")
            {
                <!-- Suspended Status -->
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <div class="icon-circle bg-secondary text-white mx-auto" style="width: 80px; height: 80px;">
                                <i class="material-icons" style="font-size: 2.5rem;">pause_circle</i>
                            </div>
                        </div>
                        <h4 class="mb-2">Account Suspended</h4>
                        <p class="text-muted mb-4">
                            Your ambassador account has been temporarily suspended.
                        </p>
                        @if (!string.IsNullOrEmpty(Model.SuspensionReason))
                        {
                            <div class="alert alert-warning text-left mb-4">
                                <strong><i class="material-icons align-middle mr-1">info</i> Reason:</strong>
                                <p class="mb-0 mt-1">@Model.SuspensionReason</p>
                            </div>
                        }
                        <p class="text-muted small mb-3">
                            During suspension:
                        </p>
                        <ul class="list-unstyled text-muted small mb-4">
                            <li><i class="material-icons align-middle mr-1 text-warning" style="font-size: 1rem;">close</i> Referral link is inactive</li>
                            <li><i class="material-icons align-middle mr-1 text-warning" style="font-size: 1rem;">close</i> No new commissions earned</li>
                            <li><i class="material-icons align-middle mr-1 text-success" style="font-size: 1rem;">check</i> Existing balance preserved</li>
                        </ul>
                        <a href="mailto:support@firstaidmadeeasy.com" class="btn btn-outline-primary">
                            <i class="material-icons align-middle mr-1">support_agent</i>
                            Appeal Suspension
                        </a>
                    </div>
                </div>

                <!-- Account Summary -->
                <div class="card mt-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-secondary">Account Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <h5 class="mb-0">@Model.TotalReferrals</h5>
                                <small class="text-muted">Referrals</small>
                            </div>
                            <div class="col-4">
                                <h5 class="mb-0 text-success">@Model.Currency @Model.TotalEarned.ToString("N0")</h5>
                                <small class="text-muted">Earned</small>
                            </div>
                            <div class="col-4">
                                <h5 class="mb-0 text-warning">@Model.Currency @Model.PendingBalance.ToString("N0")</h5>
                                <small class="text-muted">Balance</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Unknown/Other Status -->
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="material-icons text-muted" style="font-size: 4rem;">help_outline</i>
                        <h4 class="mt-3 mb-2">Status Unknown</h4>
                        <p class="text-muted">
                            Unable to determine your ambassador status.
                            Please contact support for assistance.
                        </p>
                        <a href="mailto:support@firstaidmadeeasy.com" class="btn btn-primary">
                            Contact Support
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .icon-circle {
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
