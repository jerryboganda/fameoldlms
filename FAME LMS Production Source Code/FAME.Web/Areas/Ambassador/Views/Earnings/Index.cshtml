@model First_Aid_Made_Easy.Models.EarningsPageVM
@{
    ViewBag.Title = "My Earnings";
    Layout = "~/Views/Shared/_LayoutAmbassador.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">My Earnings</h4>
            <p class="text-muted mb-0">Track your commissions and earnings ledger</p>
        </div>
        <div>
            @if (Model.Balance.CanRequestPayout)
            {
                <a href="@Url.Action("Request", "Payouts")" class="btn btn-success mr-2">
                    <i class="material-icons align-middle mr-1">payments</i>
                    Request Payout
                </a>
            }
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary">
                <i class="material-icons align-middle mr-1">arrow_back</i>
                Dashboard
            </a>
        </div>
    </div>

    <!-- Balance Cards -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
            <div class="card h-100 border-left-warning">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending</div>
                    <div class="h4 mb-0 font-weight-bold">@Model.Balance.Currency @Model.Balance.PendingBalance.ToString("N0")</div>
                    <small class="text-muted">7-day grace period</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
            <div class="card h-100 border-left-success">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Available</div>
                    <div class="h4 mb-0 font-weight-bold text-success">@Model.Balance.Currency @Model.Balance.AvailableBalance.ToString("N0")</div>
                    <small class="text-muted">Ready for payout</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
            <div class="card h-100 border-left-info">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Requested</div>
                    <div class="h4 mb-0 font-weight-bold">@Model.Balance.Currency @Model.Balance.RequestedBalance.ToString("N0")</div>
                    <small class="text-muted">Payout in progress</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-left-primary">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Paid Out</div>
                    <div class="h4 mb-0 font-weight-bold">@Model.Balance.Currency @Model.Balance.TotalPaidOut.ToString("N0")</div>
                    <small class="text-muted">All time</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Minimum Payout Notice -->
    @if (!Model.Balance.CanRequestPayout)
    {
        <div class="alert alert-info d-flex align-items-center mb-4">
            <i class="material-icons mr-2">info</i>
            <span>
                Minimum payout amount is <strong>@Model.Balance.Currency @Model.Balance.MinPayoutAmount.ToString("N0")</strong>. 
                You need <strong>@Model.Balance.Currency @((Model.Balance.MinPayoutAmount - Model.Balance.AvailableBalance).ToString("N0"))</strong> more to request a payout.
            </span>
        </div>
    }

    <!-- Earnings Ledger -->
    <div class="card">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="material-icons align-middle mr-1">receipt_long</i>
                Earnings Ledger
            </h6>
        </div>
        <div class="card-body p-0">
            @if (Model.Earnings != null && Model.Earnings.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th class="text-right">Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var earning in Model.Earnings)
                            {
                                <tr>
                                    <td>
                                        @earning.CreatedAt.ToString("MMM dd, yyyy")
                                        <br>
                                        <small class="text-muted">@earning.CreatedAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <i class="material-icons align-middle mr-1 text-muted" style="font-size: 1.2rem;">@earning.TypeIcon</i>
                                        @earning.Type
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(earning.Description))
                                        {
                                            @earning.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">Commission from referral conversion</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <span class="@earning.AmountClass font-weight-bold">
                                            @earning.AmountDisplay @earning.Currency
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @earning.StatusBadgeClass">@earning.Status</span>
                                        @if (earning.Status == "Pending" && earning.AvailableAt.HasValue)
                                        {
                                            <br>
                                            <small class="text-muted">Available @earning.AvailableAt.Value.ToString("MMM dd")</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                @if (Model.Page > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.Page - 1 })">
                                            <i class="material-icons align-middle">chevron_left</i>
                                        </a>
                                    </li>
                                }
                                @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                                    </li>
                                }
                                @if (Model.Page < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.Page + 1 })">
                                            <i class="material-icons align-middle">chevron_right</i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="material-icons text-muted" style="font-size: 4rem;">account_balance_wallet</i>
                    <h5 class="mt-3">No earnings yet</h5>
                    <p class="text-muted">When your referrals make purchases, your commissions will appear here.</p>
                    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary">
                        <i class="material-icons align-middle mr-1">link</i>
                        Share Your Referral Link
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .border-left-warning { border-left: 4px solid #f6c23e !important; }
    .border-left-success { border-left: 4px solid #1cc88a !important; }
    .border-left-info { border-left: 4px solid #36b9cc !important; }
    .border-left-primary { border-left: 4px solid #4e73df !important; }
    .text-xs { font-size: 0.7rem; }
</style>
