@model First_Aid_Made_Easy.Models.ReferralListPageVM
@{
    ViewBag.Title = "My Referrals";
    Layout = "~/Views/Shared/_LayoutAmbassador.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">My Referrals</h4>
            <p class="text-muted mb-0">Track students who registered using your referral link</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary">
                <i class="material-icons align-middle mr-1">arrow_back</i>
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Stats Summary -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3 mb-md-0">
            <div class="card bg-primary text-white">
                <div class="card-body py-3 text-center">
                    <h3 class="mb-0">@Model.TotalCount</h3>
                    <small>Total Referrals</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3 mb-md-0">
            <div class="card bg-warning text-white">
                <div class="card-body py-3 text-center">
                    <h3 class="mb-0">@Model.Referrals.Count(r => r.Status == "Registered")</h3>
                    <small>Registered</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3 mb-md-0">
            <div class="card bg-info text-white">
                <div class="card-body py-3 text-center">
                    <h3 class="mb-0">@Model.Referrals.Count(r => r.Status == "Verified")</h3>
                    <small>Verified</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body py-3 text-center">
                    <h3 class="mb-0">@Model.Referrals.Count(r => r.Status == "Converted")</h3>
                    <small>Converted</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <form method="get" class="row align-items-end">
                <div class="col-md-3 mb-2 mb-md-0">
                    <label class="small text-muted">Status</label>
                    <select name="status" class="form-control">
                        <option value="">All Statuses</option>
                        <option value="Registered" @(Model.Filter.Status == "Registered" ? "selected" : "")>Registered</option>
                        <option value="Verified" @(Model.Filter.Status == "Verified" ? "selected" : "")>Verified</option>
                        <option value="Converted" @(Model.Filter.Status == "Converted" ? "selected" : "")>Converted</option>
                        <option value="Invalid" @(Model.Filter.Status == "Invalid" ? "selected" : "")>Invalid</option>
                    </select>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <label class="small text-muted">Source</label>
                    <select name="source" class="form-control">
                        <option value="">All Sources</option>
                        <option value="Link" @(Model.Filter.Source == "Link" ? "selected" : "")>Referral Link</option>
                        <option value="Code" @(Model.Filter.Source == "Code" ? "selected" : "")>Referral Code</option>
                        <option value="Manual" @(Model.Filter.Source == "Manual" ? "selected" : "")>Manual</option>
                    </select>
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <label class="small text-muted">Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Search by email..." value="@Model.Filter.SearchTerm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="material-icons align-middle">search</i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Referrals Table -->
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Referrals != null && Model.Referrals.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>User</th>
                                <th>Registered</th>
                                <th>Source</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var referral in Model.Referrals)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-sm bg-light rounded-circle mr-2 d-flex align-items-center justify-content-center">
                                                <i class="material-icons text-muted">person</i>
                                            </div>
                                            <div>
                                                <span class="font-weight-medium">@(referral.ReferredUserName ?? "User")</span>
                                                <br>
                                                <small class="text-muted">@referral.ReferredUserEmail</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @referral.RegisteredAt.ToString("MMM dd, yyyy")
                                        <br>
                                        <small class="text-muted">@referral.RegisteredAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <i class="material-icons align-middle text-muted mr-1" style="font-size: 1rem;">@referral.SourceIcon</i>
                                        @referral.Source
                                    </td>
                                    <td>
                                        <span class="badge @referral.StatusBadgeClass">@referral.Status</span>
                                        @if (referral.Status == "Converted" && referral.Conversion != null)
                                        {
                                            <br>
                                            <small class="text-success">@referral.Currency @referral.Conversion.Amount.ToString("N0")</small>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <a href="@Url.Action("Details", new { id = referral.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="material-icons align-middle" style="font-size: 1rem;">visibility</i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                @if (Model.Filter.Page > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.Filter.Page - 1, status = Model.Filter.Status, source = Model.Filter.Source, search = Model.Filter.SearchTerm })">
                                            <i class="material-icons align-middle">chevron_left</i>
                                        </a>
                                    </li>
                                }
                                @for (int i = Math.Max(1, Model.Filter.Page - 2); i <= Math.Min(Model.TotalPages, Model.Filter.Page + 2); i++)
                                {
                                    <li class="page-item @(i == Model.Filter.Page ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, status = Model.Filter.Status, source = Model.Filter.Source, search = Model.Filter.SearchTerm })">@i</a>
                                    </li>
                                }
                                @if (Model.Filter.Page < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.Filter.Page + 1, status = Model.Filter.Status, source = Model.Filter.Source, search = Model.Filter.SearchTerm })">
                                            <i class="material-icons align-middle">chevron_right</i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="material-icons text-muted" style="font-size: 4rem;">people_outline</i>
                    <h5 class="mt-3">No referrals yet</h5>
                    <p class="text-muted">Share your referral link to start tracking your referrals.</p>
                    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary">
                        <i class="material-icons align-middle mr-1">link</i>
                        Get Your Referral Link
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar {
        width: 40px;
        height: 40px;
    }
    .avatar-sm {
        width: 32px;
        height: 32px;
    }
</style>
