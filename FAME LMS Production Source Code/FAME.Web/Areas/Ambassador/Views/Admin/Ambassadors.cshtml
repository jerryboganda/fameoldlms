@model First_Aid_Made_Easy.Models.AdminAmbassadorListVM
@{
    ViewBag.Title = "Manage Ambassadors";
    Layout = "~/Views/Shared/_LayoutAmbassador.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Manage Ambassadors</h4>
            <p class="text-muted mb-0">View and manage all ambassadors in the program</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="material-icons align-middle mr-1">arrow_back</i>
            Back to Dashboard
        </a>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form action="@Url.Action("Ambassadors")" method="get" class="row align-items-end">
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-medium">Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Name, email, or code..." value="@Model.SearchTerm">
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-medium">Status</label>
                    <select name="status" class="form-control">
                        <option value="">All Statuses</option>
                        <option value="Active" @(Model.StatusFilter == "Active" ? "selected" : "")>Active</option>
                        <option value="Pending" @(Model.StatusFilter == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Suspended" @(Model.StatusFilter == "Suspended" ? "selected" : "")>Suspended</option>
                        <option value="Rejected" @(Model.StatusFilter == "Rejected" ? "selected" : "")>Rejected</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-medium">Tier</label>
                    <select name="tier" class="form-control">
                        <option value="">All Tiers</option>
                        <option value="Bronze" @(Model.TierFilter == "Bronze" ? "selected" : "")>Bronze</option>
                        <option value="Silver" @(Model.TierFilter == "Silver" ? "selected" : "")>Silver</option>
                        <option value="Gold" @(Model.TierFilter == "Gold" ? "selected" : "")>Gold</option>
                        <option value="Platinum" @(Model.TierFilter == "Platinum" ? "selected" : "")>Platinum</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-medium">Sort By</label>
                    <select name="sortBy" class="form-control">
                        <option value="newest" @(Model.SortBy == "newest" ? "selected" : "")>Newest First</option>
                        <option value="oldest" @(Model.SortBy == "oldest" ? "selected" : "")>Oldest First</option>
                        <option value="referrals" @(Model.SortBy == "referrals" ? "selected" : "")>Most Referrals</option>
                        <option value="earnings" @(Model.SortBy == "earnings" ? "selected" : "")>Highest Earnings</option>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="material-icons align-middle mr-1">filter_list</i>
                        Filter
                    </button>
                    <a href="@Url.Action("Ambassadors")" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Ambassadors Table -->
    <div class="card">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="material-icons align-middle mr-1">people</i>
                Ambassadors (@Model.TotalCount)
            </h6>
            <a href="#" class="btn btn-sm btn-outline-secondary disabled" title="Coming soon">
                <i class="material-icons align-middle mr-1" style="font-size: 1rem;">download</i>
                Export
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.Ambassadors != null && Model.Ambassadors.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Ambassador</th>
                                <th>Referral Code</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Tier</th>
                                <th class="text-center">Referrals</th>
                                <th class="text-right">Earnings</th>
                                <th class="text-center">Joined</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var amb in Model.Ambassadors)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary text-white mr-2">
                                                @amb.Initials
                                            </div>
                                            <div>
                                                <strong>@amb.FullName</strong>
                                                <br>
                                                <small class="text-muted">@amb.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <code>@amb.ReferralCode</code>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @amb.StatusBadgeClass">@amb.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-pill @amb.TierBadgeClass">@amb.Tier</span>
                                    </td>
                                    <td class="text-center">
                                        <strong>@amb.TotalReferrals</strong>
                                        <br>
                                        <small class="text-muted">(@amb.ConvertedReferrals converted)</small>
                                    </td>
                                    <td class="text-right">
                                        <strong class="text-success">@amb.Currency @amb.TotalEarnings.ToString("N0")</strong>
                                        <br>
                                        <small class="text-muted">@amb.Currency @amb.AvailableBalance.ToString("N0") available</small>
                                    </td>
                                    <td class="text-center">
                                        @amb.JoinedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-right">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown">
                                                Actions
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <a href="@Url.Action("ViewAmbassador", new { id = amb.Id })" class="dropdown-item">
                                                    <i class="material-icons align-middle mr-2" style="font-size: 1rem;">visibility</i>
                                                    View Details
                                                </a>
                                                @if (amb.Status == "Active")
                                                {
                                                    <a href="#" class="dropdown-item" onclick="suspendAmbassador(@amb.Id); return false;">
                                                        <i class="material-icons align-middle mr-2" style="font-size: 1rem;">pause</i>
                                                        Suspend
                                                    </a>
                                                }
                                                @if (amb.Status == "Suspended")
                                                {
                                                    <a href="#" class="dropdown-item" onclick="reactivateAmbassador(@amb.Id); return false;">
                                                        <i class="material-icons align-middle mr-2" style="font-size: 1rem;">play_arrow</i>
                                                        Reactivate
                                                    </a>
                                                }
                                                <div class="dropdown-divider"></div>
                                                <a href="#" class="dropdown-item" onclick="changeTier(@amb.Id); return false;">
                                                    <i class="material-icons align-middle mr-2" style="font-size: 1rem;">upgrade</i>
                                                    Change Tier
                                                </a>
                                                <a href="#" class="dropdown-item disabled" title="Coming soon">
                                                    <i class="material-icons align-middle mr-2" style="font-size: 1rem;">account_balance</i>
                                                    View Earnings
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                // Pagination
                if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                @if (Model.Page > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Ambassadors", new { page = Model.Page - 1, search = Model.SearchTerm, status = Model.StatusFilter, tier = Model.TierFilter, sortBy = Model.SortBy })">
                                            <i class="material-icons align-middle">chevron_left</i>
                                        </a>
                                    </li>
                                }
                                @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Ambassadors", new { page = i, search = Model.SearchTerm, status = Model.StatusFilter, tier = Model.TierFilter, sortBy = Model.SortBy })">@i</a>
                                    </li>
                                }
                                @if (Model.Page < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Ambassadors", new { page = Model.Page + 1, search = Model.SearchTerm, status = Model.StatusFilter, tier = Model.TierFilter, sortBy = Model.SortBy })">
                                            <i class="material-icons align-middle">chevron_right</i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="material-icons text-muted" style="font-size: 4rem;">people_outline</i>
                    <h5 class="mt-3">No ambassadors found</h5>
                    <p class="text-muted">Try adjusting your search or filter criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Suspend Modal -->
<div class="modal fade" id="suspendModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Suspend Ambassador</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form id="suspendForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="suspendAmbassadorId">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Reason for suspension</label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="Enter reason..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Suspend</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Change Tier Modal -->
<div class="modal fade" id="tierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Change Ambassador Tier</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form id="tierForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="tierAmbassadorId">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Select New Tier</label>
                        <select name="tier" class="form-control" required>
                            <option value="Bronze">Bronze</option>
                            <option value="Silver">Silver</option>
                            <option value="Gold">Gold</option>
                            <option value="Platinum">Platinum</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Tier</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function suspendAmbassador(id) {
            $('#suspendAmbassadorId').val(id);
            $('#suspendForm').attr('action', '@Url.Action("Suspend")');
            $('#suspendModal').modal('show');
        }

        function reactivateAmbassador(id) {
            if (!confirm('Are you sure you want to reactivate this ambassador?')) return;
            
            $.post('@Url.Action("Reactivate")', {
                id: id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function (response) {
                if (response.success) {
                    toastr.success('Ambassador reactivated.');
                    location.reload();
                } else {
                    toastr.error(response.message || 'Failed to reactivate.');
                }
            });
        }

        function changeTier(id) {
            $('#tierAmbassadorId').val(id);
            $('#tierForm').attr('action', '@Url.Action("UpdateTier")');
            $('#tierModal').modal('show');
        }
    </script>
}

<style>
    .avatar-sm {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        font-weight: bold;
    }
</style>
