@using First_Aid_Made_Easy.Models
@model LoginViewModel
@{
    Layout = "";
    ViewBag.Title = "Ambassador Login | FAME";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Ambassador Login | First Aid Made Easy</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Login to your FAME Ambassador Dashboard. Track referrals, earnings, and manage your ambassador profile." />
    <link rel="shortcut icon" type="image/x-icon" href="~/Content/assets/images/fame-favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />
    <link href="~/Content/assetsn/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assetsn/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <style>
        :root {
            --amb-primary: #3B82F6;
            --amb-primary-dark: #2563EB;
            --amb-cta: #F97316;
            --amb-bg: #F8FAFC;
            --amb-text: #1E293B;
            --amb-muted: #64748B;
            --amb-border: #E2E8F0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--amb-bg);
            margin: 0;
            min-height: 100vh;
        }

        .amb-login-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Left panel - branding */
        .amb-login-brand {
            flex: 0 0 45%;
            background: linear-gradient(135deg, #1E3A5F 0%, #0F172A 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px;
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        .amb-login-brand::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%);
        }

        .amb-login-brand::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -30%;
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(249,115,22,0.1) 0%, transparent 70%);
        }

        .amb-brand-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 420px;
        }

        .amb-brand-logo {
            width: 80px;
            height: 80px;
            margin-bottom: 2rem;
            filter: brightness(0) invert(1);
            opacity: 0.9;
        }

        .amb-brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            background: rgba(59,130,246,0.2);
            border: 1px solid rgba(59,130,246,0.3);
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #93C5FD;
            margin-bottom: 1.5rem;
        }

        .amb-brand-title {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 1rem;
            letter-spacing: -0.02em;
        }

        .amb-brand-desc {
            font-size: 1rem;
            line-height: 1.7;
            color: #94A3B8;
            margin-bottom: 2.5rem;
        }

        .amb-brand-stats {
            display: flex;
            gap: 2rem;
            justify-content: center;
        }

        .amb-brand-stat {
            text-align: center;
        }

        .amb-brand-stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: #F97316;
        }

        .amb-brand-stat-label {
            font-size: 0.75rem;
            color: #94A3B8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Right panel - form */
        .amb-login-form-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        .amb-login-form-container {
            width: 100%;
            max-width: 440px;
        }

        .amb-login-header {
            margin-bottom: 2.5rem;
        }

        .amb-login-header h1 {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--amb-text);
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .amb-login-header p {
            color: var(--amb-muted);
            font-size: 0.95rem;
            margin: 0;
        }

        .amb-form-group {
            margin-bottom: 1.25rem;
        }

        .amb-form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--amb-text);
            margin-bottom: 0.5rem;
        }

        .amb-form-input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--amb-border);
            border-radius: 10px;
            font-size: 0.95rem;
            color: var(--amb-text);
            background: #fff;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
            box-sizing: border-box;
        }

        .amb-form-input:focus {
            border-color: var(--amb-primary);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

        .amb-form-input::placeholder {
            color: #A0AEC0;
        }

        .amb-btn-login {
            width: 100%;
            padding: 14px;
            background: var(--amb-primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 0.5rem;
        }

        .amb-btn-login:hover {
            background: var(--amb-primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }

        .amb-btn-login:active {
            transform: translateY(0);
        }

        .amb-login-links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            font-size: 0.85rem;
        }

        .amb-login-links a {
            color: var(--amb-primary);
            text-decoration: none;
            font-weight: 500;
        }

        .amb-login-links a:hover {
            text-decoration: underline;
        }

        .amb-divider {
            display: flex;
            align-items: center;
            margin: 2rem 0;
            color: var(--amb-muted);
            font-size: 0.8rem;
        }

        .amb-divider::before,
        .amb-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--amb-border);
        }

        .amb-divider span {
            padding: 0 1rem;
        }

        .amb-register-section {
            text-align: center;
        }

        .amb-register-section p {
            color: var(--amb-muted);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .amb-btn-apply {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            background: #fff;
            color: var(--amb-cta);
            border: 2px solid var(--amb-cta);
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }

        .amb-btn-apply:hover {
            background: var(--amb-cta);
            color: #fff;
            transform: translateY(-1px);
            text-decoration: none;
        }

        .amb-back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 2rem;
            color: var(--amb-muted);
            font-size: 0.85rem;
            text-decoration: none;
        }

        .amb-back-link:hover {
            color: var(--amb-primary);
            text-decoration: none;
        }

        .amb-alert {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .amb-alert-error {
            background: #FEF2F2;
            color: #991B1B;
            border: 1px solid #FECACA;
        }

        .amb-alert-success {
            background: #F0FDF4;
            color: #166534;
            border: 1px solid #BBF7D0;
        }

        .amb-alert-info {
            background: #EFF6FF;
            color: #1E40AF;
            border: 1px solid #BFDBFE;
        }

        .amb-password-wrapper {
            position: relative;
        }

        .amb-password-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--amb-muted);
            padding: 4px;
        }

        .amb-password-toggle:hover {
            color: var(--amb-text);
        }

        /* Mobile responsive */
        @@media (max-width: 991px) {
            .amb-login-brand {
                display: none;
            }
            .amb-login-form-panel {
                padding: 24px;
            }
            .amb-mobile-logo {
                display: block;
                text-align: center;
                margin-bottom: 1.5rem;
            }
            .amb-mobile-logo img {
                height: 50px;
            }
        }

        @@media (min-width: 992px) {
            .amb-mobile-logo {
                display: none;
            }
        }

        .amb-spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            margin-left: 8px;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>

<body>
    <div class="amb-login-wrapper">
        <!-- Left Brand Panel -->
        <div class="amb-login-brand">
            <div class="amb-brand-content">
                <img src="~/Content/assets/images/fame-logo.png" alt="FAME" class="amb-brand-logo" />
                <div class="amb-brand-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                    Ambassador Program
                </div>
                <h2 class="amb-brand-title">Welcome Back, Ambassador</h2>
                <p class="amb-brand-desc">
                    Access your personalized dashboard to track referrals, monitor earnings, 
                    and grow your ambassador career with FAME.
                </p>
                <div class="amb-brand-stats">
                    <div class="amb-brand-stat">
                        <div class="amb-brand-stat-value">Live</div>
                        <div class="amb-brand-stat-label">Referrals</div>
                    </div>
                    <div class="amb-brand-stat">
                        <div class="amb-brand-stat-value">Live</div>
                        <div class="amb-brand-stat-label">Tracking</div>
                    </div>
                    <div class="amb-brand-stat">
                        <div class="amb-brand-stat-value">Clear</div>
                        <div class="amb-brand-stat-label">Reporting</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="amb-login-form-panel">
            <div class="amb-login-form-container">
                <!-- Mobile Logo -->
                <div class="amb-mobile-logo">
                    <img src="~/Content/assets/images/fame-logo.png" alt="FAME" />
                    <p style="color: var(--amb-primary); font-weight: 700; font-size: 0.8rem; margin-top: 8px; text-transform: uppercase; letter-spacing: 0.08em;">Ambassador Program</p>
                </div>

                <div class="amb-login-header">
                    <h1>Ambassador Login</h1>
                    <p>Sign in to your ambassador dashboard</p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="amb-alert amb-alert-error">
                        <strong>@TempData["Error"]</strong>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="amb-alert amb-alert-success">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Info"] != null)
                {
                    <div class="amb-alert" style="background:#eef6ff;color:#16324f;border:1px solid #bfd7f5;">
                        @TempData["Info"]
                    </div>
                }

                @Html.ValidationSummary(true, "", new { @class = "amb-alert amb-alert-error" })

                @using (Html.BeginForm("Login", "AmbassadorAccount", new { area = "Ambassador", ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @id = "ambassadorLoginForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="amb-form-group">
                        <label for="Email">Email Address</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "amb-form-input", @placeholder = "Enter your email", @autocomplete = "email", @id = "Email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger", style = "font-size: 0.8rem; margin-top: 4px; display: block;" })
                    </div>

                    <div class="amb-form-group">
                        <label for="Password">Password</label>
                        <div class="amb-password-wrapper">
                            @Html.PasswordFor(m => m.Password, new { @class = "amb-form-input", @placeholder = "Enter your password", @id = "Password" })
                            <button type="button" class="amb-password-toggle" onclick="togglePassword()">
                                <svg id="eyeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", style = "font-size: 0.8rem; margin-top: 4px; display: block;" })
                    </div>

                    <div class="amb-login-links">
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 0; font-weight: 400;">
                            @Html.CheckBoxFor(m => m.RememberMe, new { style = "accent-color: var(--amb-primary);" }) Remember me
                        </label>
                        <a href="/Account/ForgotPassword">Forgot Password?</a>
                    </div>

                    <button type="submit" class="amb-btn-login" id="btnLogin">
                        <span id="btnLoginText">Sign In to Dashboard</span>
                        <span class="amb-spinner" id="btnLoginSpinner"></span>
                    </button>
                }

                <div class="amb-divider"><span>Not an ambassador yet?</span></div>

                <div class="amb-register-section">
                    <p>Join the Ambassador Program to track referrals, conversions, and payout requests in one place.</p>
                    <a href="@Url.Action("Join", "Home", new { area = "Ambassador" })" class="amb-btn-apply">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Apply for Ambassador Program
                    </a>
                </div>

                <div style="text-align: center;">
                    <a href="@Url.Action("Index", "Home", new { area = "Ambassador" })" class="amb-back-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        Back to Ambassador Program
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/assets/vendor/jquery.min.js"></script>
    <script>
        function togglePassword() {
            var input = document.getElementById('Password');
            var icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        $('#ambassadorLoginForm').on('submit', function () {
            var btn = document.getElementById('btnLogin');
            var text = document.getElementById('btnLoginText');
            var spinner = document.getElementById('btnLoginSpinner');
            btn.disabled = true;
            text.textContent = 'Signing in...';
            spinner.style.display = 'inline-block';
        });
    </script>
</body>
</html>
