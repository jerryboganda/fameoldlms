@model First_Aid_Made_Easy.Models.PayoutMethodsPageVM
@{
    ViewBag.Title = "Payout Methods";
    Layout = "~/Views/Shared/_LayoutAmbassador.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Payout Methods</h4>
            <p class="text-muted mb-0">Manage your withdrawal accounts</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="material-icons align-middle mr-1">arrow_back</i>
            Back to Payouts
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="material-icons align-middle mr-1">check_circle</i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="material-icons align-middle mr-1">error</i>
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="material-icons align-middle mr-1">warning</i>
            @TempData["Warning"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="row">
        <!-- Current Methods -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="material-icons align-middle mr-1">account_balance_wallet</i>
                        Your Payout Methods
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Methods != null && Model.Methods.Count > 0)
                    {
                        <div class="row">
                            @foreach (var method in Model.Methods)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 @(method.IsDefault ? "border-primary" : "")">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="d-flex align-items-center">
                                                    <div class="icon-circle @(method.IsVerified ? "bg-success" : "bg-warning") text-white mr-2">
                                                        <i class="material-icons" style="font-size: 1.25rem;">@method.MethodIcon</i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0">@method.MethodTypeDisplay</h6>
                                                        @if (method.IsDefault)
                                                        {
                                                            <span class="badge badge-primary badge-sm">Default</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-link text-muted p-0" data-toggle="dropdown">
                                                        <i class="material-icons">more_vert</i>
                                                    </button>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        @if (!method.IsDefault)
                                                        {
                                                            <a href="#" class="dropdown-item" onclick="setDefault(@method.Id); return false;">
                                                                <i class="material-icons align-middle mr-2" style="font-size: 1rem;">check_circle</i>
                                                                Set as Default
                                                            </a>
                                                        }
                                                        <a href="#" class="dropdown-item text-danger" onclick="deleteMethod(@method.Id); return false;">
                                                            <i class="material-icons align-middle mr-2" style="font-size: 1rem;">delete</i>
                                                            Remove
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-muted mb-2">
                                                <small>@method.AccountHolderName</small>
                                                <br>
                                                <span class="font-monospace">@method.MaskedAccountNumber</span>
                                            </div>
                                            @if (!method.IsVerified)
                                            {
                                                <span class="badge badge-warning">
                                                    <i class="material-icons align-middle mr-1" style="font-size: 0.75rem;">warning</i>
                                                    Pending Verification
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-success">
                                                    <i class="material-icons align-middle mr-1" style="font-size: 0.75rem;">verified</i>
                                                    Verified
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="material-icons text-muted" style="font-size: 3rem;">account_balance</i>
                            <h6 class="mt-3">No payout methods added</h6>
                            <p class="text-muted mb-0">Add a payout method to start receiving your earnings.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Add New Method -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="material-icons align-middle mr-1">add_circle</i>
                        Add Payout Method
                    </h6>
                </div>
                <div class="card-body">
                    <form id="addMethodForm" action="@Url.Action("AddMethod")" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="form-group">
                            <label for="methodType" class="font-weight-medium">Method Type <span class="text-danger">*</span></label>
                            <select id="methodType" name="MethodType" class="form-control" required>
                                <option value="">Select method type...</option>
                                <option value="BankTransfer">Bank Transfer</option>
                                <option value="MobileMoney">Mobile Money</option>
                            </select>
                        </div>

                        <!-- Bank Transfer Fields -->
                        <div id="bankFields" style="display: none;">
                            <div class="form-group">
                                <label class="font-weight-medium">Bank Name <span class="text-danger">*</span></label>
                                <input type="text" name="BankName" class="form-control" placeholder="e.g., CBE, Awash, Abyssinia">
                            </div>
                            <div class="form-group">
                                <label class="font-weight-medium">Account Number <span class="text-danger">*</span></label>
                                <input type="text" name="AccountNumber" class="form-control" placeholder="Enter account number">
                            </div>
                            <div class="form-group">
                                <label class="font-weight-medium">Account Holder Name <span class="text-danger">*</span></label>
                                <input type="text" name="AccountHolderName" class="form-control" placeholder="Name as on bank account">
                            </div>
                        </div>

                        <!-- Mobile Money Fields -->
                        <div id="mobileFields" style="display: none;">
                            <div class="form-group">
                                <label class="font-weight-medium">Provider <span class="text-danger">*</span></label>
                                <select name="MobileProvider" class="form-control">
                                    <option value="">Select provider...</option>
                                    <option value="Telebirr">Telebirr</option>
                                    <option value="CBEBirr">CBE Birr</option>
                                    <option value="MPesa">M-Pesa</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-medium">Phone Number <span class="text-danger">*</span></label>
                                <input type="tel" name="AccountNumber" class="form-control" placeholder="e.g., 0911234567">
                            </div>
                            <div class="form-group">
                                <label class="font-weight-medium">Registered Name <span class="text-danger">*</span></label>
                                <input type="text" name="AccountHolderName" class="form-control" placeholder="Name registered with provider">
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="setAsDefault" name="IsDefault" value="true">
                                <label class="custom-control-label" for="setAsDefault">Set as default payout method</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block" id="addBtn">
                            <i class="material-icons align-middle mr-1">add</i>
                            Add Method
                        </button>
                    </form>
                </div>
            </div>

            <!-- Info Card -->
            <div class="card mt-4 border-left-info">
                <div class="card-body">
                    <h6 class="text-info mb-2">
                        <i class="material-icons align-middle mr-1">info</i>
                        Important Notes
                    </h6>
                    <ul class="small text-muted mb-0 pl-3">
                        <li>Bank transfers may take 1-3 business days</li>
                        <li>Mobile money transfers are usually instant</li>
                        <li>Ensure account details are accurate</li>
                        <li>New methods require admin verification</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle fields based on method type
            $('#methodType').change(function () {
                var type = $(this).val();
                $('#bankFields, #mobileFields').hide();
                if (type === 'BankTransfer') {
                    $('#bankFields').show();
                } else if (type === 'MobileMoney') {
                    $('#mobileFields').show();
                }
            });

            // Form validation
            $('#addMethodForm').submit(function (e) {
                var type = $('#methodType').val();
                if (!type) {
                    e.preventDefault();
                    toastr.warning('Please select a method type.');
                    return false;
                }
            });
        });

        function setDefault(methodId) {
            $.ajax({
                url: '@Url.Action("SetDefault")',
                type: 'POST',
                data: {
                    methodId: methodId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        toastr.success('Default method updated.');
                        location.reload();
                    } else {
                        toastr.error(response.message || 'Failed to update.');
                    }
                },
                error: function () {
                    toastr.error('An error occurred.');
                }
            });
        }

        function deleteMethod(methodId) {
            if (!confirm('Are you sure you want to remove this payout method?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteMethod")',
                type: 'POST',
                data: {
                    methodId: methodId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        toastr.success('Payout method removed.');
                        location.reload();
                    } else {
                        toastr.error(response.message || 'Failed to remove.');
                    }
                },
                error: function () {
                    toastr.error('An error occurred.');
                }
            });
        }
    </script>
}

<style>
    .icon-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .border-left-info {
        border-left: 4px solid #36b9cc !important;
    }
</style>
