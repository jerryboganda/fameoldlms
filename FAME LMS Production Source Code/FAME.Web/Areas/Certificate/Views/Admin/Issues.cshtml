@model First_Aid_Made_Easy.Models.Certificate.CertificateIssueListPageVM
@{
    ViewBag.Title = "Issued Certificates";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-list-check me-2"></i>Issued Certificates</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin", new { area = "Certificate" })">Certificate Manager</a></li>
                    <li class="breadcrumb-item active">Issues</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Issued" @(ViewBag.StatusFilter == "Issued" ? "selected" : "")>Issued</option>
                        <option value="PendingApproval" @(ViewBag.StatusFilter == "PendingApproval" ? "selected" : "")>Pending Approval</option>
                        <option value="Revoked" @(ViewBag.StatusFilter == "Revoked" ? "selected" : "")>Revoked</option>
                        <option value="Expired" @(ViewBag.StatusFilter == "Expired" ? "selected" : "")>Expired</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search learner or cert ID..." value="@ViewBag.SearchQuery" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
                    <a href="@Url.Action("Issues", "Admin", new { area = "Certificate" })" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Issues Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Certificate ID</th>
                        <th>Learner</th>
                        <th>Course</th>
                        <th>Template</th>
                        <th>Status</th>
                        <th>Issued Date</th>
                        <th>Expiry</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in Model.Issues)
                    {
                        <tr>
                            <td class="font-monospace small">@issue.PublicId</td>
                            <td class="fw-medium">@issue.LearnerName</td>
                            <td>@issue.CourseName</td>
                            <td class="text-muted small">@issue.TemplateName</td>
                            <td>
                                @switch (issue.Status)
                                {
                                    case "Issued":
                                        <span class="badge bg-success">Issued</span>
                                        break;
                                    case "PendingApproval":
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case "Revoked":
                                        <span class="badge bg-danger">Revoked</span>
                                        break;
                                    case "Expired":
                                        <span class="badge bg-secondary">Expired</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@issue.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small">@(issue.IssuedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td class="text-muted small">@(issue.ExpiresAt?.ToString("MMM dd, yyyy") ?? "No expiry")</td>
                            <td>
                                <a href="@Url.Action("IssueDetail", "Admin", new { area = "Certificate", id = issue.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Issues.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No certificates found matching your criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Issues", "Admin", new { area = "Certificate", page = p, status = ViewBag.StatusFilter, search = ViewBag.SearchQuery })">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
