@using First_Aid_Made_Easy.Models.Certificate
@{
    ViewBag.Title = "Correction Requests";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    var corrections = ViewBag.Corrections as List<CertificateCorrectionVM> ?? new List<CertificateCorrectionVM>();
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2"></i>Correction Requests</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin", new { area = "Certificate" })">Certificate Manager</a></li>
                    <li class="breadcrumb-item active">Corrections</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (!corrections.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-check-circle" style="font-size: 48px; opacity: 0.3;"></i>
            <p class="mt-3">No open correction requests. All good!</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cert ID</th>
                            <th>Learner</th>
                            <th>Issue Description</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in corrections)
                        {
                            <tr>
                                <td class="font-monospace small">@c.CertificatePublicId</td>
                                <td class="fw-medium">@c.LearnerName</td>
                                <td class="text-truncate" style="max-width: 300px;">@c.Description</td>
                                <td>
                                    @if (c.Status == "Open")
                                    {
                                        <span class="badge bg-warning text-dark">Open</span>
                                    }
                                    else if (c.Status == "Resolved")
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@c.Status</span>
                                    }
                                </td>
                                <td class="text-muted small">@c.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (c.Status == "Open")
                                    {
                                        <div class="d-flex gap-1">
                                            <form method="post" action="@Url.Action("ResolveCorrection", "Admin", new { area = "Certificate" })">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <input type="hidden" name="resolution" value="Reviewed and corrected" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Mark Resolved"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                            <a href="@Url.Action("IssueDetail", "Admin", new { area = "Certificate", id = c.CertificateIssueId })" class="btn btn-sm btn-outline-primary" title="View Certificate">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
