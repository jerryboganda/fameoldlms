@model First_Aid_Made_Easy.Models.Certificate.GoogleSheetListVM
@{
    ViewBag.Title = "Google Sheets";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

@section styles {
<style>
    .gsl-page { max-width: 900px; margin: 0 auto; padding: 28px 16px; }

    .gsl-header {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 12px; margin-bottom: 24px;
    }
    .gsl-header h4 { margin: 0; font-weight: 700; color: #1E293B; font-size: 20px; }
    .gsl-header p  { margin: 2px 0 0; color: #94A3B8; font-size: 13px; }

    .btn-add-sheet {
        display: inline-flex; align-items: center; gap: 5px;
        background: #0F766E; color: #fff; border: none; border-radius: 6px;
        padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .btn-add-sheet:hover { background: #0D6E67; color: #fff; text-decoration: none; }

    /* Card grid */
    .gs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
    }
    .gs-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 20px;
        transition: box-shadow 0.2s;
        position: relative;
    }
    .gs-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .gs-card-title {
        font-size: 15px; font-weight: 700; color: #1E293B;
        margin-bottom: 6px;
        display: flex; align-items: center; gap: 6px;
    }
    .gs-card-title .material-icons { font-size: 20px; color: #0F766E; }
    .gs-card-meta { font-size: 11px; color: #94A3B8; margin-bottom: 14px; }
    .gs-card-actions { display: flex; gap: 8px; }
    .gs-card .btn-view {
        display: inline-flex; align-items: center; gap: 4px;
        background: #0F766E; color: #fff; border: none; border-radius: 5px;
        padding: 5px 14px; font-size: 12px; font-weight: 600; text-decoration: none;
    }
    .gs-card .btn-view:hover { background: #0D6E67; color: #fff; }
    .gs-card .btn-del {
        display: inline-flex; align-items: center; gap: 3px;
        background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; border-radius: 5px;
        padding: 5px 10px; font-size: 12px; font-weight: 600; cursor: pointer;
    }
    .gs-card .btn-del:hover { background: #FEE2E2; }

    /* Empty state */
    .gs-empty {
        text-align: center; padding: 60px 20px;
        background: #fff; border: 1px solid #E2E8F0; border-radius: 10px;
    }
    .gs-empty .material-icons { font-size: 56px; color: #CBD5E1; }
    .gs-empty h5 { color: #64748B; margin: 12px 0 4px; }
    .gs-empty p { color: #94A3B8; font-size: 13px; }

    /* Modal tweaks */
    #addSheetModal .modal-header {
        background: #0F766E; color: #fff; border-radius: 10px 10px 0 0;
    }
    #addSheetModal .modal-content { border: none; box-shadow: 0 10px 40px rgba(0,0,0,0.2); border-radius: 10px; }
    .form-label-sm { font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase; }
</style>
}

<div class="gsl-page">
    <div class="gsl-header">
        <div>
            <h4>
                <span class="material-icons" style="font-size:24px; vertical-align:middle; color:#0F766E; margin-right:4px;">table_chart</span>
                Google Sheets
            </h4>
            <p>Select a sheet to view its data, or add a new one.</p>
        </div>
        <button type="button" class="btn-add-sheet" id="btnOpenAdd">
            <span class="material-icons" style="font-size:16px;">add_circle</span> Add New Sheet
        </button>
    </div>

    @if (Model.Sheets.Any())
    {
        <div class="gs-grid">
            @foreach (var s in Model.Sheets)
            {
                <div class="gs-card" id="card-@s.Id">
                    <div class="gs-card-title">
                        <span class="material-icons">description</span>
                        @s.SheetName
                    </div>
                    <div class="gs-card-meta">
                        Added @s.CreatedAt.ToString("MMM dd, yyyy")
                    </div>
                    <div class="gs-card-actions">
                        <a href="@Url.Action("GoogleSheetData", "Admin", new { area = "Certificate", id = s.Id })" class="btn-view">
                            <span class="material-icons" style="font-size:14px;">visibility</span> View Data
                        </a>
                        <button type="button" class="btn-del" data-id="@s.Id" data-name="@s.SheetName">
                            <span class="material-icons" style="font-size:14px;">delete</span> Remove
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="gs-empty">
            <span class="material-icons">cloud_off</span>
            <h5>No sheets added yet</h5>
            <p>Click "Add New Sheet" to link a Google Sheet.</p>
        </div>
    }
</div>

@section modals {
<!-- Add Sheet Modal -->
<div class="modal fade" id="addSheetModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-weight:700; font-size:16px;">
                    <span class="material-icons" style="font-size:20px; vertical-align:middle; margin-right:6px;">add_circle</span>
                    Add Google Sheet
                </h5>
                <button type="button" class="close" data-dismiss="modal" style="color:#fff; opacity:0.8; text-shadow:none;">
                    <span>&times;</span>
                </button>
            </div>
            <form id="addSheetForm">
                @Html.AntiForgeryToken()
                <div class="modal-body" style="padding:24px;">
                    <div class="form-group">
                        <label class="form-label-sm">Sheet Name <span style="color:#DC2626;">*</span></label>
                        <input type="text" name="sheetName" id="inpSheetName" class="form-control form-control-sm"
                               placeholder="e.g. Research Applicants 2026" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-sm">Google Sheet URL <span style="color:#DC2626;">*</span></label>
                        <input type="text" name="sheetUrl" id="inpSheetUrl" class="form-control form-control-sm"
                               placeholder="Paste the full Google Sheet URL here" required />
                        <small style="font-size:11px; color:#94A3B8;">
                            e.g. https://docs.google.com/spreadsheets/d/abc123.../edit#gid=0<br />
                            The sheet must be publicly accessible (Anyone with the link → Viewer).
                        </small>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:none; padding-top:0;">
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm" id="btnSaveSheet" style="background:#0F766E; color:#fff; font-weight:600;">
                        <span class="material-icons" style="font-size:16px; vertical-align:middle;">save</span> Save Sheet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
}

@section scripts {
<script>
    $(function () {
        // Open add modal
        $('#btnOpenAdd').on('click', function () {
            $('#inpSheetName').val('');
            $('#inpSheetUrl').val('');
            $('#addSheetModal').modal('show');
        });

        // Submit add sheet
        $('#addSheetForm').on('submit', function (e) {
            e.preventDefault();
            var btn = $('#btnSaveSheet');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Saving...');

            $.ajax({
                url: '@Url.Action("AddGoogleSheet", "Admin", new { area = "Certificate" })',
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    btn.prop('disabled', false).html('<span class="material-icons" style="font-size:16px;vertical-align:middle;">save</span> Save Sheet');
                    if (res.success) {
                        $('#addSheetModal').modal('hide');
                        toastr.success(res.message);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html('<span class="material-icons" style="font-size:16px;vertical-align:middle;">save</span> Save Sheet');
                    toastr.error('An error occurred.');
                }
            });
        });

        // Delete sheet
        $(document).on('click', '.btn-del', function () {
            var id = $(this).data('id');
            var name = $(this).data('name');
            if (!confirm('Remove "' + name + '"? This will not delete the Google Sheet itself, just the reference.')) return;

            $.ajax({
                url: '@Url.Action("DeleteGoogleSheet", "Admin", new { area = "Certificate" })',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        $('#card-' + id).fadeOut(300, function () { $(this).remove(); });
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function () { toastr.error('An error occurred.'); }
            });
        });
    });
</script>
}
