@model First_Aid_Made_Easy.Models.Certificate.CertificateIssueVM
@{
    ViewBag.Title = "Certificate - " + Model.CourseName;
    Layout = "~/Views/Shared/_LayoutStudent2026.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student", new { area = "Certificate" })">My Certificates</a></li>
            <li class="breadcrumb-item active">@Model.CourseName</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Certificate Preview -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <img src="@Model.ThumbnailUrl" class="img-fluid shadow-sm rounded" alt="Certificate" style="max-width: 100%;" />
                    }
                    else
                    {
                        <div class="py-5 bg-light rounded">
                            <i class="bi bi-award" style="font-size: 80px; color: #0F766E;"></i>
                            <h4 class="mt-3 fw-semibold">@Model.CourseName</h4>
                            <p class="text-muted">Certificate of Completion</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Details & Actions -->
        <div class="col-lg-4">
            <!-- Status Badge -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body text-center py-4">
                    @if (Model.Status == "Issued")
                    {
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px; background: #d1fae5;">
                            <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        </div>
                        <div class="fw-semibold text-success">Verified Certificate</div>
                    }
                    else if (Model.Status == "PendingApproval")
                    {
                        <div class="rounded-circle bg-warning bg-opacity-25 d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                            <i class="bi bi-hourglass-split fs-3 text-warning"></i>
                        </div>
                        <div class="fw-semibold text-warning">Pending Approval</div>
                    }
                    else if (Model.Status == "Revoked")
                    {
                        <div class="rounded-circle bg-danger bg-opacity-25 d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                            <i class="bi bi-x-circle-fill fs-3 text-danger"></i>
                        </div>
                        <div class="fw-semibold text-danger">Revoked</div>
                    }
                </div>
            </div>

            <!-- Certificate Info -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small">Certificate ID</label>
                        <div class="fw-semibold font-monospace">@Model.PublicId</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Course</label>
                        <div class="fw-medium">@Model.CourseName</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Issued Date</label>
                        <div>@(Model.IssuedAt?.ToString("MMMM dd, yyyy") ?? "—")</div>
                    </div>
                    @if (Model.ExpiresAt.HasValue)
                    {
                        <div class="mb-3">
                            <label class="text-muted small">Valid Until</label>
                            <div>@Model.ExpiresAt.Value.ToString("MMMM dd, yyyy")</div>
                        </div>
                    }
                    @if (Model.Credits > 0)
                    {
                        <div class="mb-0">
                            <label class="text-muted small">CPD Credits</label>
                            <div class="fw-semibold">@Model.Credits</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            @if (Model.Status == "Issued")
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("Download", "Student", new { area = "Certificate", id = Model.Id })" class="btn" style="background: #0F766E; color: #fff;">
                                <i class="bi bi-file-pdf me-1"></i>Download PDF
                            </a>
                            <a href="@Url.Action("DownloadImage", "Student", new { area = "Certificate", id = Model.Id })" class="btn btn-outline-primary">
                                <i class="bi bi-image me-1"></i>Download Image (PNG)
                            </a>
                            <button class="btn btn-outline-secondary" onclick="emailCopy()">
                                <i class="bi bi-envelope me-1"></i>Email Copy to Me
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Share / Verification -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold small">Share & Verify</div>
                    <div class="card-body">
                        <label class="text-muted small mb-1">Verification Link</label>
                        <div class="input-group input-group-sm mb-3">
                            <input type="text" class="form-control font-monospace" id="verifyLink"
                                   value="@Url.Action("Index", "Verify", new { area = "Certificate", id = Model.PublicId }, Request.Url.Scheme)" readonly />
                            <button class="btn btn-outline-secondary" onclick="copyLink()"><i class="bi bi-clipboard"></i></button>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
                        {
                            <div class="text-center">
                                <img src="data:image/png;base64,@Model.QrCodeBase64" class="img-fluid" style="max-width: 140px;" alt="QR Code" />
                                <div class="text-muted small mt-1">Scan to verify</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Report Issue -->
            @if (Model.Status == "Issued")
            {
                <div class="text-center">
                    <a href="@Url.Action("ReportIssue", "Student", new { area = "Certificate", id = Model.Id })" class="text-muted small text-decoration-none">
                        <i class="bi bi-flag me-1"></i>Report an issue with this certificate
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
<script>
    function copyLink() {
        var input = document.getElementById('verifyLink');
        input.select();
        document.execCommand('copy');
        var btn = input.nextElementSibling;
        btn.innerHTML = '<i class="bi bi-check text-success"></i>';
        setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
    }

    function emailCopy() {
        var btn = event.target.closest('button');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sending...';
        $.post('@Url.Action("EmailCopy", "Student", new { area = "Certificate" })', { id: @Model.Id }, function (resp) {
            if (resp.success) {
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Sent!';
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-outline-success');
            } else {
                btn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Failed';
                btn.disabled = false;
            }
            setTimeout(function () {
                btn.innerHTML = '<i class="bi bi-envelope me-1"></i>Email Copy to Me';
                btn.className = 'btn btn-outline-secondary';
                btn.disabled = false;
            }, 3000);
        }).fail(function () {
            btn.innerHTML = '<i class="bi bi-envelope me-1"></i>Email Copy to Me';
            btn.disabled = false;
            alert('Could not send email. Please try again.');
        });
    }
</script>
}
