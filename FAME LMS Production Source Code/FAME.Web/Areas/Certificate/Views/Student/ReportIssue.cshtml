@{
    ViewBag.Title = "Report Certificate Issue";
    Layout = "~/Views/Shared/_LayoutStudent2026.cshtml";
    var issueId = (int)(ViewBag.IssueId ?? 0);
    var certPublicId = ViewBag.CertPublicId as string ?? "";
    var courseName = ViewBag.CourseName as string ?? "";
}

<div class="container-fluid px-4 py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student", new { area = "Certificate" })">My Certificates</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Detail", "Student", new { area = "Certificate", id = issueId })">@courseName</a></li>
            <li class="breadcrumb-item active">Report Issue</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-flag me-2"></i>Report a Certificate Issue</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info d-flex align-items-start">
                        <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                        <div>
                            If you notice an error on your certificate (e.g., wrong name, incorrect date, typo), please describe the issue below.
                            Our admin team will review and correct it promptly.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Certificate</label>
                        <div class="fw-medium">@courseName</div>
                        <div class="font-monospace small text-muted">@certPublicId</div>
                    </div>

                    <form method="post" action="@Url.Action("SubmitCorrection", "Student", new { area = "Certificate" })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="certificateIssueId" value="@issueId" />

                        <div class="mb-3">
                            <label class="form-label fw-medium">What's wrong?</label>
                            <select class="form-select" name="issueType" required>
                                <option value="">Select issue type...</option>
                                <option value="Wrong Name">Wrong name / misspelling</option>
                                <option value="Wrong Date">Incorrect date</option>
                                <option value="Wrong Course">Wrong course title</option>
                                <option value="Missing Info">Missing information</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Description</label>
                            <textarea class="form-control" name="description" rows="4" required
                                      placeholder="Please describe the issue in detail. Include what the correct information should be..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i>Submit Report
                            </button>
                            <a href="@Url.Action("Detail", "Student", new { area = "Certificate", id = issueId })" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
