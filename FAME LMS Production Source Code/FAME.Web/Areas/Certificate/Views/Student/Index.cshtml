@model First_Aid_Made_Easy.Models.Certificate.StudentCertificateCenterVM
@{
    ViewBag.Title = "My Certificates";
    Layout = "~/Views/Shared/_LayoutStudent2026.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Page Header -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="bi bi-award me-2" style="color: #0F766E;"></i>My Certificates</h3>
        <p class="text-muted mb-0">View, download, and share your earned certificates</p>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold" style="color: #0F766E;">@Model.TotalEarned</div>
                <div class="text-muted small">Certificates Earned</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-info">@Model.TotalCredits</div>
                <div class="text-muted small">CPD Credits</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-warning">@Model.PendingCount</div>
                <div class="text-muted small">Pending Approval</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-success">@Model.ActiveCount</div>
                <div class="text-muted small">Active</div>
            </div>
        </div>
    </div>

    @if (Model.PendingCount > 0)
    {
        <div class="alert alert-warning d-flex align-items-center mb-4">
            <i class="bi bi-hourglass-split me-2"></i>
            You have <strong class="mx-1">@Model.PendingCount</strong> certificate(s) awaiting admin approval.
        </div>
    }

    <!-- Certificate Cards -->
    @if (Model.Certificates.Any())
    {
        <div class="row g-3">
            @foreach (var cert in Model.Certificates)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 position-relative overflow-hidden">
                        @if (cert.Status == "Revoked")
                        {
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-danger">Revoked</span>
                            </div>
                        }
                        else if (cert.Status == "PendingApproval")
                        {
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-warning text-dark">Pending</span>
                            </div>
                        }
                        else if (cert.Status == "Expired")
                        {
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-secondary">Expired</span>
                            </div>
                        }

                        <!-- Thumbnail -->
                        @if (!string.IsNullOrEmpty(cert.ThumbnailUrl))
                        {
                            <div class="bg-light text-center p-3" style="min-height: 160px;">
                                <img src="@cert.ThumbnailUrl" class="img-fluid" style="max-height: 150px; @(cert.Status == "Revoked" ? "opacity: 0.4; filter: grayscale(1);" : "")" />
                            </div>
                        }
                        else
                        {
                            <div class="bg-light text-center py-5" style="min-height: 160px;">
                                <i class="bi bi-award" style="font-size: 48px; color: #0F766E; @(cert.Status == "Revoked" ? "opacity: 0.3;" : "")"></i>
                            </div>
                        }

                        <div class="card-body">
                            <h6 class="fw-semibold mb-1">@cert.CourseName</h6>
                            <div class="text-muted small mb-2">
                                @if (cert.IssuedAt.HasValue)
                                {
                                    <span><i class="bi bi-calendar3 me-1"></i>@cert.IssuedAt.Value.ToString("MMM dd, yyyy")</span>
                                }
                                @if (cert.Credits > 0)
                                {
                                    <span class="ms-2"><i class="bi bi-star me-1"></i>@cert.Credits CPD</span>
                                }
                            </div>
                            @if (cert.ExpiresAt.HasValue)
                            {
                                var daysLeft = (cert.ExpiresAt.Value - DateTime.UtcNow).Days;
                                if (daysLeft <= 30 && daysLeft > 0)
                                {
                                    <div class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>Expires in @daysLeft days</div>
                                }
                                else if (daysLeft <= 0)
                                {
                                    <div class="text-danger small"><i class="bi bi-x-circle me-1"></i>Expired</div>
                                }
                            }

                            @if (cert.Status == "Issued")
                            {
                                <div class="d-flex gap-2 mt-3">
                                    <a href="@Url.Action("Detail", "Student", new { area = "Certificate", id = cert.Id })" class="btn btn-sm btn-outline-primary flex-fill">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                    <a href="@Url.Action("Download", "Student", new { area = "Certificate", id = cert.Id })" class="btn btn-sm flex-fill" style="background: #0F766E; color: #fff;">
                                        <i class="bi bi-download me-1"></i>PDF
                                    </a>
                                </div>
                            }
                            else if (cert.Status == "PendingApproval")
                            {
                                <div class="text-center text-muted small mt-3">
                                    <i class="bi bi-hourglass-split me-1"></i>Awaiting admin approval
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-award" style="font-size: 64px; color: #0F766E; opacity: 0.2;"></i>
            <h5 class="mt-3 text-muted">No system-generated certificates yet</h5>
            <p class="text-muted">Complete your courses to earn certificates. Keep learning!</p>
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary">
                <i class="bi bi-book me-1"></i>Go to My Courses
            </a>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Manual Certificates (uploaded by admin) -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @{
        var manualCerts = ViewBag.ManualCertificates as List<First_Aid_Made_Easy.Models.Certificate.ManualCertificateVM>;
    }
    @if (manualCerts != null && manualCerts.Any())
    {
        <hr class="my-4" />
        <div class="mb-3">
            <h4 class="fw-bold"><i class="bi bi-file-earmark-pdf me-2" style="color: #0F766E;"></i>Certificates Provided by Admin</h4>
            <p class="text-muted mb-0">These certificates were manually uploaded by the administration</p>
        </div>
        <div class="row g-3">
            @foreach (var mc in manualCerts)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="bg-light text-center py-4" style="min-height: 140px;">
                            <i class="bi bi-file-earmark-pdf" style="font-size: 56px; color: #dc3545;"></i>
                        </div>
                        <div class="card-body">
                            <h6 class="fw-semibold mb-1">
                                @(string.IsNullOrEmpty(mc.Title) ? mc.FileName : mc.Title)
                            </h6>
                            <div class="text-muted small mb-2">
                                @if (!string.IsNullOrEmpty(mc.CourseName))
                                {
                                    <span><i class="bi bi-book me-1"></i>@mc.CourseName</span>
                                }
                                else if (!string.IsNullOrEmpty(mc.PackageName))
                                {
                                    <span><i class="bi bi-box me-1"></i>@mc.PackageName</span>
                                }
                            </div>
                            <div class="text-muted small mb-2">
                                <i class="bi bi-calendar3 me-1"></i>@mc.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                            <a href="@Url.Action("DownloadManual", "Student", new { area = "Certificate", id = mc.Id })"
                               class="btn btn-sm w-100 mt-2" style="background: #0F766E; color: #fff;">
                                <i class="bi bi-download me-1"></i>Download PDF
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
