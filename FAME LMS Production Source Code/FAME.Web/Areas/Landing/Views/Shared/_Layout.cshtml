	<script>
		$(function () {
		})
		$(".testimonial-grid").click(function () {
			Swal.fire(
				$(this).data("title"),
				$(this).data("content"),
				''
			)
		})
		$(document).on("click", "#btnSubscribe", function () {

			$.ajax({
				url: "/Landing/Home/SubscribeEmail?Email=" + $("#subEmail").val(),
				success: function (saved) {
					if (saved) {
						Swal.fire({
							position: 'top-end',
							icon: 'success',
							title: 'Your email has been subscribed',
							showConfirmButton: false,
							timer: 1500
						})
					} else {

						Swal.fire({
							position: 'top-end',
							icon: 'success',
							title: 'Your email is already subscribed',
							showConfirmButton: false,
							timer: 1500
						})
					}
					$("#subEmail").val("").change();
				},
				error: function (err) {
				}
			})
		})
	</script>
