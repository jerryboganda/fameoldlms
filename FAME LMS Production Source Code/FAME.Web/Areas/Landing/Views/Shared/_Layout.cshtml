    <style>
        .swal2-popup {
            width: 40em !important;
            font-size: 1.5rem !important;
        }

        * {
            font-family: 'Poppins';
        }

        .blink_me {
            animation: blinker 1.5s linear infinite;
        }

        @@keyframes blinker {
            20% {
                opacity: 0;
            }

            50% {
                opacity: 1;
            }

            100% {
                opacity: 1;
            }
        }

        .increase {
            transition: all .2s ease-in-out;
        }

            .increase:hover {
                transform: scale(1.2);
            }

        .upward {
            position: relative;
            top: 0;
            transition: top ease 0.5s;
        }

            .upward:hover {
                top: -10px;
            }

        .brand-area-2 {
            background: #f1f2ff;
        }

        .register-btn {
            font-size: 12px;
        }

        .whatsapp-btn {
            position: fixed;
            right: 30px;
            bottom: 30px;
            height: 46px;
            width: 46px;
            cursor: pointer;
            display: block;
            border-radius: 50px;
            box-shadow: inset 0 0 0 2px rgba(255, 71, 87, 0.2);
            z-index: 10000;
            background-color: aqua
        }

        .header-navbar a.edu-btn, button.edu-btn {
            height: 50px;
            line-height: 52px;
            padding: 0px 10px;
            font-size: 15px;
        }

        .header-navbar .mainmenu-nav .mainmenu > li > a {
            font-size: 15px;
            padding: 0 13px;
        }
    </style>
