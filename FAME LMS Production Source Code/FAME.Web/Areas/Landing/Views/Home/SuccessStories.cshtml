@{
    ViewBag.Title = "Success Stories";
}


<div class="edu-breadcrumb-area">
    <div class="container">
        <div class="breadcrumb-inner">
            <div class="page-title">
                <h1 class="title">Success Stories</h1>
            </div>
            <ul class="edu-breadcrumb">
            </ul>
        </div>
    </div>
    <ul class="shape-group">
        <li class="shape-1">
            <span></span>
        </li>
        <li class="shape-2 scene"><img data-depth="2" src="~/Areas/Landing/assets/images/about/shape-13.png" alt="shape"></li>
        <li class="shape-3 scene"><img data-depth="-2" src="~/Areas/Landing/assets/images/about/shape-15.png" alt="shape"></li>
        <li class="shape-4">
            <span></span>
        </li>
        <li class="shape-5 scene"><img data-depth="2" src="~/Areas/Landing/assets/images/about/shape-07.png" alt="shape"></li>
    </ul>
</div>


<div id="div-seuccessvideos" class="edu-brand-area brand-area-2 bg-image">
    <div class="container edublink-animated-shape">

        <div class="section-title section-center" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Success Stories</span>
            <h2 class="title">Success Stories</h2>
            <span class="shape-line"><i class="icon-19"></i></span>
        </div>
        <div class="brand-grid-wrap brand-style-4">
            <div class="brand-grid" style="opacity:1">
                <iframe loading="lazy" width="280" height="157"
                        src="https://www.youtube.com/embed/r06fbD2Dc4A?si=jitmZgQ3V46JRGUS"
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            </div>
            <div class="brand-grid" style="opacity:1">
                <iframe loading="lazy" width="280" height="157"
                        src="https://www.youtube.com/embed/8jn9wpzO9TY?si=am6DK-4SuhPYkfgL"
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            </div>
                <!-- New success story videos -->
                <div class="brand-grid" style="opacity:1">
                    <iframe loading="lazy" width="280" height="157"
                            src="https://youtube.com/shorts/r0C5grUAzxo?si=fycH3xl1BS3tstNF"
                            title="NRE-1 & NRE-2 Success Story 1"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>
                    </iframe>
                </div>
                <div class="brand-grid" style="opacity:1">
                    <iframe loading="lazy" width="280" height="157"
                            src="https://youtube.com/shorts/cD4CqE2b32A?si=QHcnUZZ9lKL7dd7V"
                            title="NRE-1 & NRE-2 Success Story 2"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>
                    </iframe>
                </div>
                
                <div class="brand-grid" style="opacity:1">
                    <iframe loading="lazy" width="280" height="157"
                            src="https://www.youtube.com/embed/ksF9NvrMVHw?si=yb8y-HSv8Sp5yd8n"
                            title="Additional Guidelines Video"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>
                    </iframe>
                </div>
        </div>
        <ul class="shape-group">
            <li class="shape-1 scene" data-sal-delay="500" data-sal="fade" data-sal-duration="200">
                <img loading="lazy" data-depth="-2" src="~/Areas/Landing/assets/images/about/shape-37.png" alt="Shape">
            </li>
        </ul>
    </div>
    <ul class="shape-group">
        <li class="shape-2 scene shape-light" data-sal-delay="500" data-sal="fade" data-sal-duration="200">
            <img loading="lazy" data-depth="-2" src="~/Areas/Landing/assets/images/about/shape-41.png" alt="Shape">
        </li>
        <li class="shape-2 scene shape-dark" data-sal-delay="500" data-sal="fade" data-sal-duration="200">
            <img loading="lazy" data-depth="-2" src="~/Areas/Landing/assets/images/about/dark-shape-41.png" alt="Shape">
        </li>
    </ul>
</div>
