<!--=====================================-->
<!--=        Blog Area Start            =-->
<!--=====================================-->
<section class="section-gap-equal">
	<div class="container">
		<div class="row g-5" id="masonry-gallery">
			<!-- Start Blog Grid  -->
			@foreach (var t in a)
			{
				<div class="col-lg-4 col-md-6 col-12 masonry-item" data-sal-delay="100" data-sal="slide-up" data-sal-duration="800">
					<div class="edu-blog blog-style-5">
						<div class="inner">
							<div class="thumbnail">
								<a href="blog-details.html">
									<img style="width:370px; height:370px" loading="lazy" src="~/Areas/Landing/assets/images/team/@t.Image" alt="Blog Images">
								</a>
							</div>
							<div class="content position-top">
								<h5 class="title"><a href="javascript:;">@t.Name</a></h5>
								<p style="height:52px" >@t.Text</p>
							</div>
						</div>
					</div>
				</div>
			}

		</div>


	</div>
</section>
<!--=====================================-->
<!--=        CTA  Area Start            =-->
<!--=====================================-->
<!-- Start Ad Banner Area  -->
<div class="edu-cta-banner-area home-one-cta-wrapper bg-image">
