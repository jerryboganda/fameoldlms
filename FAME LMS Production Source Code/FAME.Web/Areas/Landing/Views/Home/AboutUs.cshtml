@{
    ViewBag.Title = "About Us";
}


<div class="edu-breadcrumb-area">
    <div class="container">
        <div class="breadcrumb-inner">
            <div class="page-title">
                <h1 class="title">Our Journy Begins with Covid-19 panadamic</h1>
            </div>
            <ul class="edu-breadcrumb">
            </ul>
        </div>
    </div>
    <ul class="shape-group">
        <li class="shape-1">
            <span></span>
        </li>
        <li class="shape-2 scene"><img data-depth="2" src="~/Areas/Landing/assets/images/about/shape-13.png" alt="shape"></li>
        <li class="shape-3 scene"><img data-depth="-2" src="~/Areas/Landing/assets/images/about/shape-15.png" alt="shape"></li>
        <li class="shape-4">
            <span></span>
        </li>
        <li class="shape-5 scene"><img data-depth="2" src="~/Areas/Landing/assets/images/about/shape-07.png" alt="shape"></li>
    </ul>
</div>


<section class="why-choose-area-3 edu-section-gap" style="padding-bottom:0px">
    <div class="container">
        <div class="row row--45">
            <div class="section-title-flex section-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                <div class="left-content">
                    <h2 class="title">The First Aid Made Easy <br>Platform by <span class="color-secondary">Dr.Hafiz Atif </span></h2>
                    <span class="shape-line"><i class="icon-19"></i></span>
                </div>
                <div class="right-content">
                    <p>
                        The first platform in Asia where complete lectures of First Aid Step-1, First Aid Step-2CK, BRS physiology, Kaplan Surgery, General Pathology Pathoma and Anatomy shelf notes are available<br />
                        FAME website is providing complete lecture packages for <span class="color-secondary">FCPS-1, NRE-1, MD/MS-1, USMLE and HAAD</span> exams.<br />
                        International students from India, Nepal, Bangladesh, Afghanistan and other countries are following FAME platform.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-gap-equal contact-me-area">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9">
                <div class="contact-me">
                    <div class="inner">
                        <div class="thumbnail">
                            <div class="thumb">
                                <img src="~/Areas/Landing/assets/images/team/DrAtif 370x370.jpg" />
                            </div>
                            <ul class="shape-group">
                                <li class="shape-1 scene">
                                    <img data-depth="1.4" src="~/Areas/Landing/assets/images/about/shape-13.png" alt="Shape">
                                </li>
                                <li class="shape-2 scene">
                                    <img data-depth="-1.4" src="~/Areas/Landing/assets/images/counterup/shape-02.png" alt="Shape">
                                </li>
                                <li class="shape-3">
                                    <img src="~/Areas/Landing/assets/images/about/shape-07.png" alt="Shape">
                                </li>
                            </ul>
                        </div>
                        <div class="contact-us-info">
                            <h3 class="heading-title">Dr. Hafiz Atif</h3>
                            <ul class="address-list">
                                <li>
                                    <h5 class="title">Cleared</h5>
                                    <p>USMLE,FCPS-1, MD/MS-1</p>
									<p> Post doctoral research scholar at duke University USA</p>
                                </li>
                                <li>
                                    <h5 class="title">Graduated From</h5>
                                    <p>Gujranwala Medical College</p>
                                </li>
                                <li>
									<p>He is one of the youngest teachers in Asia who completed lectures of all basic and Clinical subjects of medical sciences.</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
