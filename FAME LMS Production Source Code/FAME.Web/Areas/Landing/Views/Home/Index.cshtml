        <script>
            var ResultID = localStorage.getItem("FreeResultID");
            if (ResultID) {
                $("#FreeTestUrl").attr("href", "/QuestionPaper/Continue/" + ResultID);
            }

            // Popup Image Slider
            (function () {
                var currentSlide = 0, slideCount = 0, autoTimer = null, overlay = null;

                function fetchAndShowSlider() {
                    $.ajax({
                        url: '/PopupSlidesHandler.ashx?action=active',
                        type: 'GET',
                        dataType: 'json',
                        success: function (data) {
                            if (data && data.success && data.slides && data.slides.length > 0) {
                                buildSlider(data.slides);
                            }
                        },
                        error: function () { }
                    });
                }

                function buildSlider(slides) {
                    slideCount = slides.length;
                    currentSlide = 0;

                    overlay = document.createElement('div');
                    overlay.className = 'fame-popup-overlay';

                    var singleClass = slideCount === 1 ? ' single-slide' : '';
                    var html = '<div class="fame-popup-slider' + singleClass + '">';
                    html += '<button class="fame-popup-close" aria-label="Close">&times;</button>';
                    html += '<div class="fame-slides-wrap"><div class="fame-slide-track">';

                    for (var i = 0; i < slides.length; i++) {
                        var s = slides[i];
                        html += '<div class="fame-slide">';
                        if (s.linkUrl) html += '<a href="' + escAttr(s.linkUrl) + '" target="_blank">';
                        html += '<img src="' + escAttr(s.imagePath) + '" alt="' + escAttr(s.title || 'Slide ' + (i + 1)) + '" loading="eager" />';
                        if (s.linkUrl) html += '</a>';
                        html += '</div>';
                    }

                    html += '</div></div>';

                    if (slideCount > 1) {
                        html += '<button class="fame-slide-nav fame-slide-prev" aria-label="Previous">&#10094;</button>';
                        html += '<button class="fame-slide-nav fame-slide-next" aria-label="Next">&#10095;</button>';
                        html += '<div class="fame-slide-dots">';
                        for (var j = 0; j < slideCount; j++) {
                            html += '<button class="fame-slide-dot' + (j === 0 ? ' active' : '') + '" data-idx="' + j + '"></button>';
                        }
                        html += '</div>';
                    }

                    html += '</div>';
                    overlay.innerHTML = html;
                    document.body.appendChild(overlay);

                    requestAnimationFrame(function () {
                        requestAnimationFrame(function () { overlay.classList.add('active'); });
                    });

                    overlay.querySelector('.fame-popup-close').addEventListener('click', closeSlider);
                    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeSlider(); });

                    if (slideCount > 1) {
                        overlay.querySelector('.fame-slide-prev').addEventListener('click', function () {
                            goTo((currentSlide - 1 + slideCount) % slideCount); restartAuto();
                        });
                        overlay.querySelector('.fame-slide-next').addEventListener('click', function () {
                            goTo((currentSlide + 1) % slideCount); restartAuto();
                        });

                        var dots = overlay.querySelectorAll('.fame-slide-dot');
                        for (var d = 0; d < dots.length; d++) {
                            dots[d].addEventListener('click', function () {
                                goTo(parseInt(this.getAttribute('data-idx'))); restartAuto();
                            });
                        }

                        var touchStartX = 0, touchStartY = 0, swiping = false;
                        var swipeWrap = overlay.querySelector('.fame-slides-wrap');
                        swipeWrap.addEventListener('touchstart', function (e) {
                            touchStartX = e.changedTouches[0].screenX;
                            touchStartY = e.changedTouches[0].screenY;
                            swiping = true;
                        }, { passive: true });
                        swipeWrap.addEventListener('touchend', function (e) {
                            if (!swiping) return;
                            swiping = false;
                            var dx = touchStartX - e.changedTouches[0].screenX;
                            var dy = touchStartY - e.changedTouches[0].screenY;
                            if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
                                if (dx > 0) goTo((currentSlide + 1) % slideCount);
                                else goTo((currentSlide - 1 + slideCount) % slideCount);
                                restartAuto();
                            }
                        }, { passive: true });

                        startAuto();
                        overlay.querySelector('.fame-popup-slider').addEventListener('mouseenter', stopAuto);
                        overlay.querySelector('.fame-popup-slider').addEventListener('mouseleave', startAuto);
                    }

                    document.addEventListener('keydown', escHandler);
                }

                function goTo(idx) {
                    currentSlide = idx;
                    var track = overlay.querySelector('.fame-slide-track');
                    track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
                    var dots = overlay.querySelectorAll('.fame-slide-dot');
                    for (var i = 0; i < dots.length; i++) {
                        if (i === currentSlide) dots[i].classList.add('active');
                        else dots[i].classList.remove('active');
                    }
                }

                function startAuto() { stopAuto(); if (slideCount <= 1) return; autoTimer = setInterval(function () { goTo((currentSlide + 1) % slideCount); }, 4500); }
                function stopAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
                function restartAuto() { stopAuto(); startAuto(); }

                function closeSlider() {
                    stopAuto();
                    document.removeEventListener('keydown', escHandler);
                    if (overlay) {
                        overlay.classList.remove('active');
                        overlay.classList.add('closing');
                        setTimeout(function () { if (overlay && overlay.parentNode) overlay.parentNode.removeChild(overlay); overlay = null; }, 350);
                    }
                }

                function escHandler(e) { if (e.key === 'Escape' || e.keyCode === 27) closeSlider(); }
                function escAttr(s) { if (!s) return ''; return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fetchAndShowSlider);
                else fetchAndShowSlider();
            })();
        </script>

    }
