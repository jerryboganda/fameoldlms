</div>

<!--=====================================-->
<!--=       Contact Me Area Start       =-->
<!--=====================================-->
<section class="contact-us-area">
    <div class="container">
        <div class="row g-5">
            <div class="col-xl-4 col-lg-6">
                <div class="contact-us-info">
                    <h3 class="heading-title">We're Always Eager to Hear From You!</h3>
                    <!-- ======================== -->
                    <!-- Edited -->
                    <ul class="address-list">
                        <li>
                            <h5 class="title">Address</h5>
                            <p>Mall road, Lahore, Punjab, Pakistan</p>
                        </li>
                        <li>
                            <h5 class="title">Email</h5>
                            <p><a href="mailto:info@firstaidmadeeasy.com.pk">info@firstaidmadeeasy.com.pk</a></p>
                        </li>
                        <li>
                            <h5 class="title">Phone</h5>
                            <p><a href="tel:+923180049742">+92 (318) 0049-742</a></p>
                        </li>
                    </ul>
                    <!-- ======================== -->
                    <!-- Edited -->
                    <ul class="social-share">
                        <li><a href="https://www.facebook.com/FirstAidLectures?_rdc=1&_rdr" target="_blank"><i class="icon-share-alt"></i></a></li>
                        <li><a href="https://www.facebook.com/FirstAidLectures?_rdc=1&_rdr" target="_blank"><i class="icon-facebook"></i></a></li>
                        <li><a href="https://www.facebook.com/FirstAidLectures?_rdc=1&_rdr" target="_blank"><i class="icon-twitter"></i></a></li>
                        <li><a href="https://www.facebook.com/FirstAidLectures?_rdc=1&_rdr" target="_blank"><i class="icon-linkedin2"></i></a></li>
                    </ul>
                </div>
            </div>
            <div class="offset-xl-2 col-lg-6">
                <div class="contact-form form-style-2">
                    <div class="section-title">
                        <h4 class="title">Get In Touch</h4>
                        <p>Fill out this form for booking a consultant advising session.</p>
                    </div>
                    <form class="rnt-contact-form rwt-dynamic-form" action="#">
                        <div class="row row--10">
                            <div class="form-group col-12">
                                <input type="text" name="name" id="name" placeholder="Your name">
                            </div>
                            <div class="form-group col-12">
                                <input type="email" name="email" id="email" placeholder="Enter your email">
                            </div>
                            <div class="form-group col-12">
                                <input type="tel" name="phone_number" id="phone_number" placeholder="Phone number">
                            </div>
                            <div class="form-group col-12">
                                <input type="text" name="msg_subject" id="msg_subject" placeholder="Subject">
                            </div>
                            <div class="form-group col-12">
                                <textarea name="message" id="message" cols="30" rows="4" placeholder="Your message"></textarea>
                                <span id="validation" class="text-danger" style="display:none">Please Fill all the fields</span>
                            </div>
                            <div class="form-group col-12">
                                <button class="rn-btn edu-btn btn-medium submit-btn" id="btnSend" onclick="sendEmail()" type="button">Submit Message <i class="icon-4"></i></button>
                            </div>
                        </div>
                    </form>
                    <ul class="shape-group">
                        <li class="shape-1 scene"><img data-depth="1" src="~/Areas/Landing/assets/images/about/shape-13.png" alt="Shape"></li>
                        <li class="shape-2 scene"><img data-depth="-1" src="~/Areas/Landing/assets/images/counterup/shape-02.png" alt="Shape"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!--=====================================-->
<!--=      Google Map Area Start        =-->
<!--=====================================-->
<div class="google-map-area">
    <div class="mapouter">
        <div class="gmap_canvas">
            <iframe id="gmap_canvas" src="https://maps.google.com/maps?q=melbourne,%20Australia&t=&z=15&ie=UTF8&iwloc=&output=embed" frameborder="0" scrolling="no" marginheight="0" marginwidth="0"></iframe>
        </div>
    </div>
</div>

@section scripts{

    <script>
        function sendEmail() {
            var data = {
                Subject: $("#msg_subject").val(),
                Name: $("#name").val(),
                Phone: $("#phone_number").val(),
                Email: $("#email").val(),
                Message: $("#message").val()
            }
            if (IsValid(data)) {
                $("#btnSend").attr("disabled",true)
                $.ajax({
                    url: "https://api.firstaidmadeeasy.com.pk/Account/SendEmail",
                    data: {
                        Subject: data.Subject,
                        Body: "Full Name :" + data.Name + "<br/>Phone No: " + data.Phone + "<br/> Sender Email : " + data.Email + "<br/>Message :" + data.Message,
                        Destination: "info@firstaidmadeeasy.com.pk"
                    },
                    success: function (res) {
                        $("#msg_subject,#phone_number,#email,#name").val("");
                        $("#message").val("");
                        alert("mail sent successfully");
                        $("#btnSend").attr("disabled", false)

                    }
                })
            }
        }

        function IsValid(data) {
            $("#validation").hide();
            if (data.Subject == "" || data.Name == "" || data.Email == "" || data.Message == "") {
                $("#validation").show();
                return false
            }
            return true;
        }
    </script>
}