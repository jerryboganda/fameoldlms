@{
    ViewBag.Title = "Collaboration With";
}


<div class="edu-breadcrumb-area">
    <div class="container">
        <div class="breadcrumb-inner">
            <div class="page-title">
                <h1 class="title">Collaboration With</h1>
            </div>
            <ul class="edu-breadcrumb">
            </ul>
        </div>
    </div>
    <ul class="shape-group">
        <li class="shape-1">
            <span></span>
        </li>
        <li class="shape-2 scene"><img data-depth="2" src="~/Areas/Landing/assets/images/about/shape-13.png" alt="shape"></li>
        <li class="shape-3 scene"><img data-depth="-2" src="~/Areas/Landing/assets/images/about/shape-15.png" alt="shape"></li>
        <li class="shape-4">
            <span></span>
        </li>
        <li class="shape-5 scene"><img data-depth="2" src="~/Areas/Landing/assets/images/about/shape-07.png" alt="shape"></li>
    </ul>
</div>

<div class="edu-team-details-area section-gap-equal">
    <div class="container">
        <div class="row row--40 mb--90">
            <div class="col-lg-4">
                <div class="team-details-thumb">
                    <div class="thumbnail">
                        <img src="~/Areas/Landing/assets/images/Collaboration/AMIlogo 370x370.jfif?v=1" alt="team">
                    </div>
                    <h4 class="text-center">ASIAN MEDICAL INSTITUTE</h4>
                </div>

                <div class="banner-btn text-center" data-sal-delay="400" data-sal="slide-up" data-sal-duration="1000">
                    <a href="/Account/Login" class="edu-btn"> Login</a>
                    <a href="/Account/Register" class="edu-btn">Register New </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="team-details-content">
                    <div class="main-info">
                        <h3 class="title">ASIAN MEDICAL INSTITUTE, Kyrgyzstan</h3>
                    </div>
                    <div class="bio-describe">
                        <h4 class="title">About</h4>
                        <p>
                            TENTISHEV ASIAN MEDICAL INSTITUTE was established in 2004 and registered with the Ministry of Justice of the Kyrgyz Republic.
                        </p>
                    </div>
                    <div class="contact-info">
                        <h4 class="title">Contact</h4>
                        <ul>
                            <li><span>Address:</span>Gagarina St. 58, Kant, Kyrgyzstan.</li>
                            <li>
                                <span>Email:</span><a href="mailto:info@asmi.edu.kg" target="_blank">
                                    info@asmi.edu.kg
                                </a>
                            </li>
                            <li><span>Phone:</span><a href="tel:+996 312 36 30 70">+996 312 36 30 70</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="team-details-thumb">
                    <div class="thumbnail">
                        <img src="~/Areas/Landing/assets/images/Collaboration/Fame logo 370x370.png" alt="team">
                    </div>
                    <h4 class="text-center">FIRST AID MADE EASY</h4>
                </div>
            </div>
        </div>
        <div class="row row--40">
            <div class="col-lg-4">
                <div class="team-details-thumb">
                    <div class="thumbnail">
                        <img src="~/Areas/Landing/assets/images/Collaboration/JASU.jpg?v=1" alt="team">
                    </div>
                    <h4 class="text-center">Jalal-Abad State University</h4>
                </div>

                <div class="banner-btn text-center" data-sal-delay="400" data-sal="slide-up" data-sal-duration="1000">

                </div>
            </div>
            <div class="col-lg-4">
                <div class="team-details-content">
                    <div class="main-info">
						<h3 class="title">Jalal-Abad State University</h3>
                    </div>
                    <div class="bio-describe">
                        <h4 class="title">About</h4>
						<p>
							Jalal-Abad State University was founded in 1993 and is a public institution designed to provide higher education for medicine.
						</p>
                    </div>
                    <div class="contact-info">
                        <h4 class="title">Contact</h4>
                        <ul>
							<li><span>Address:</span>57 Lenin Street Jalal-Abad, 715600, Kyrgyzstan.</li>
                            <li><span>Phone:</span><a href="tel:+996 504 511 101">+996 504 511 101</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="team-details-thumb">
                    <div class="thumbnail">
                        <img src="~/Areas/Landing/assets/images/Collaboration/Fame logo 370x370.png" alt="team">
                    </div>
                    <h4 class="text-center">FIRST AID MADE EASY</h4>
                </div>
            </div>
        </div>
    </div>
