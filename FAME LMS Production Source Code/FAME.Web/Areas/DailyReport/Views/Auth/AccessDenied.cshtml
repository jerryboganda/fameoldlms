@{
    ViewBag.Title = "Access Denied";
    Layout = "~/Areas/DailyReport/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white text-center">
                <h4><i class="fas fa-ban me-2"></i>Access Denied</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                </div>
                <h5>You don't have permission to access this resource.</h5>
                <p class="text-muted">Please contact your administrator if you believe this is an error.</p>
                
                <div class="mt-4">
                    @Html.ActionLink("Go to Dashboard", "Index", "Dashboard", new { area = "DailyReport" }, new { @class = "btn btn-primary me-2" })
                    @Html.ActionLink("Logout", "Logout", "Auth", new { area = "DailyReport" }, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    </div>
</div>