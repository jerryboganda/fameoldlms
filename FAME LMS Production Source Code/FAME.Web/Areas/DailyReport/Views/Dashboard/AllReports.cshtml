@model List<First_Aid_Made_Easy.Models.DailyReportVM>
@{
    ViewBag.Title = "All Reports";
    Layout = "~/Areas/DailyReport/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-alt me-2"></i>All Reports</h2>
    <div>
        @Html.ActionLink("Back to Dashboard", "Index", "Dashboard", new { area = "DailyReport" }, new { @class = "btn btn-secondary me-2" })
        @Html.ActionLink("Create New Report", "Index", "DailyReport", new { area = "DailyReport" }, new { @class = "btn btn-primary" })
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">All User Reports</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Report Content</th>
                            <th>Created</th>
                            <th>Attachment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.OrderByDescending(x => x.CreatedDT))
                        {
                            <tr>
                                <td>
                                    <strong>@report.Date</strong>
                                </td>
                                <td>
                                    <span class="badge bg-primary">User #@report.UserFid</span>
                                </td>
                                <td>
                                    @if (report.Body.Length > 150)
                                    {
                                        <span title="@report.Body">@(report.Body.Substring(0, 150))...</span>
                                    }
                                    else
                                    {
                                        @report.Body
                                    }
                                </td>
                                <td>

                                    <small class="text-muted">@(string.Format("{0:yyyy-MM-dd hh:mm tt}",report.CreatedDT))</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(report.FilePath))
                                    {
                                        <a href="@Url.Content(report.FilePath)" target="_blank" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-paperclip"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @Html.ActionLink("View", "Index", "DailyReport", new { area = "DailyReport", id = report.ID }, new { @class = "btn btn-outline-primary", title = "View Report" })
                                        <button type="button" class="btn btn-outline-danger" onclick="deleteReport(@report.ID)" title="Delete Report">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No reports found</h5>
                <p class="text-muted">No reports have been created yet.</p>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function deleteReport(reportId) {
            if (confirm('Are you sure you want to delete this report? This action cannot be undone.')) {
                $.ajax({
                    url: '@Url.Action("Delete", "DailyReport", new { area = "DailyReport" })',
                    type: 'POST',
                    data: { id: reportId },
                    success: function (result) {
                        if (result) {
                            alert('Report deleted successfully.');
                            location.reload();
                        } else {
                            alert('Failed to delete report.');
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting the report.');
                    }
                });
            }
        }
    </script>
}