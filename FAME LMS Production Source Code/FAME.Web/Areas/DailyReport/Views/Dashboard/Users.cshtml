@model List<First_Aid_Made_Easy.Models.DailyReportUserVM>
@{
    ViewBag.Title = "Manage Users";
    Layout = "~/Areas/DailyReport/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Manage Users</h2>
    <div>
        @Html.ActionLink("Back to Dashboard", "Index", "Dashboard", new { area = "DailyReport" }, new { @class = "btn btn-secondary me-2" })
        @Html.ActionLink("Create New User", "CreateUser", "Dashboard", new { area = "DailyReport" }, new { @class = "btn btn-success" })
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">All Users</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.OrderBy(x => x.Role).ThenBy(x => x.FirstName))
                        {
                            <tr>
                                <td>
                                    <strong>@user.FullName</strong>
                                </td>
                                <td>@user.UserName</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">User</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@(string.Format("{0:yyyy-MM-dd hh:mm tt}",user.CreatedDT))</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @Html.ActionLink("Edit", "EditUser", "Dashboard", new { area = "DailyReport", id = user.ID }, new { @class = "btn btn-outline-primary", title = "Edit User" })
                                        @if (user.ID != (int)Session["DR_UserId"])
                                        {
                                            <button type="button" class="btn btn-outline-danger" onclick="deleteUser(@user.ID, '@user.FullName')" title="Delete User">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary" disabled title="Cannot delete yourself">
                                                <i class="fas fa-user-shield"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No users found</h5>
                <p class="text-muted">No users have been created yet.</p>
                @Html.ActionLink("Create First User", "CreateUser", "Dashboard", new { area = "DailyReport" }, new { @class = "btn btn-success" })
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function deleteUser(userId, userName) {
            if (confirm('Are you sure you want to delete user "' + userName + '"? This action cannot be undone.')) {
                $.ajax({
                    url: '@Url.Action("DeleteUser", "Dashboard", new { area = "DailyReport" })',
                    type: 'POST',
                    data: { 
                        id: userId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result.success) {
                            alert(result.message);
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting the user.');
                    }
                });
            }
        }
    </script>
    
    @Html.AntiForgeryToken()
}