@section scripts {

    <script src="~/Areas/FileManager/Assets/js/jquery/jquery-3.3.1.js"></script>
    <script src="~/Areas/FileManager/Assets/js/popper.min.js"></script>
    <script src="~/Areas/FileManager/Assets/js/bootstrap/bootstrap.js"></script>
    <script src="~/Areas/FileManager/Assets/js/alertify.js"></script>
