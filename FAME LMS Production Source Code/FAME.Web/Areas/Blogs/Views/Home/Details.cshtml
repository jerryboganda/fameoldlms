@section scripts {
	<script>
		function GetMetaData() {
			$.ajax({
				url: '/Blogs/Home/GetBlogsMetaData/@Model.Slug',
				type: 'GET',
				success: function (result) {
					// 1. Fill Latest Posts
					let latestHtml = '';
					result.RecentPosts.forEach(function (post) {
						latestHtml += `
							<div class="latest-post">
								<div class="thumbnail">
									<a href="/blogs/home/details/${post.Slug}">
										<img src="/Images/${post.FeaturedImage}" alt="${post.Title}">
									</a>
								</div>
								<div class="post-content">
									<h6 class="title">
										<a href="/blogs/home/details/${post.Slug}">${post.Title}</a>
									</h6>
									<ul class="blog-meta">
										<li><i class="icon-27"></i>${formatDate(post.PublishedDate)}</li>
									</ul>
								</div>
							</div>`;
					});
					$('.latest-post-list').html(latestHtml);

					// 2. Fill Categories
					let categoryHtml = '';
					result.Categories.forEach(function (cat) {
						categoryHtml += `<li><a href="/blogs/home/index?Category=${cat.Name}">${cat.Name} <span>(${cat.Count})</span></a></li>`;
					});
					$('.widget-categories .category-list').html(categoryHtml);

					if (result.PrevBlog) {
						$('.prev-post a').attr('href', '/blogs/home/details/' + result.PrevBlog.Slug);
						$('.prev-post span').text(result.PrevBlog.Title);
					} else {
						$('.prev-post').hide();
					}

					// 2. Set Next Post
					if (result.NextBlog) {
						$('.next-post a').attr('href', '/blogs/home/details/' + result.NextBlog.Slug);
						$('.next-post span').text(result.NextBlog.Title);
					} else {
						$('.next-post').hide(); // Hide if no next post
					}
				},
				error: function () {
					alert("Failed to load blog metadata.");
				}
			});

			function formatDate(dateStr) {
				if (!dateStr) return '';
				const date = new Date(dateStr);
				const options = { year: 'numeric', month: 'short', day: 'numeric' };
				return date.toLocaleDateString('en-US', options);
			}
		}

		GetMetaData();
	</script>
}
