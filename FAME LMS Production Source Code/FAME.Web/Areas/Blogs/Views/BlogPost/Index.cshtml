@model First_Aid_Made_Easy.Models.BlogPostVM
@using System.Web.Configuration;

@{
	ViewBag.Title = "Blog Post";
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}


<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Blog Post</h2>
			</div>
		</div>
	</div>
</div>


<div class="page-section border-bottom-2">
	<div class="p-2 card">
		<div class="row">
			<div class="col-md-12">
				@Html.HiddenFor(x => x.Id)
				@Html.HiddenFor(x => x.FeaturedImage)
				<div class="page-separator">
					<div class="page-separator__text">Basic information</div>
				</div>
				<div class="row">
					<div class="col-md-12">
						<div class="form-group mb-24pt">
							<label class="form-label">Title</label>
							<input type="text" name="Title" id="Title" class="form-control" placeholder="Blog Title" value="@Model.Title">
							<div class="text-accent-red" id="Titleval"></div>
						</div>
					</div>
					<div class="col-md-12">
						<div class="form-group mb-24pt">
							<label class="form-label">Description</label>
							<input type="text" name="Description" id="Description" class="form-control" placeholder="Blog Description" value="@Model.Description">
							<div class="text-accent-red" id="Descriptionval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt">
							<label class="form-label">Category</label>
							<input type="text" name="Category" id="Category" class="form-control" placeholder="Blog Category" value="@Model.Category">
							<div class="text-accent-red" id="Categoryval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt">
							<label class="form-label">Author</label>
							<input type="text" name="Author" id="Author" class="form-control" placeholder="Blog Author" value="@Model.Author">
							<div class="text-accent-red" id="Authorval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt">
							<label class="form-label">Published Date</label>
							<input type="date" name="PublishedDate" id="PublishedDate" class="form-control" placeholder="Blog Published Date" value="@Model.PublishedDate">
							<div class="text-accent-red" id="PublishedDateval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt">
							<label class="form-label">Tags</label>
							<input type="text" name="Tags" id="Tags" class="form-control" placeholder="Blog Tags" value="@Model.Tags">
							<div class="small text-muted">Add comma separated Multiple tags for search. </div>
							<div class="text-accent-red" id="Tagsval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt">
							<label class="form-label">Sort Number</label>
							<input type="number" name="SortID" id="SortID" class="form-control" placeholder="Sort Number" value="@Model.SortID">
							<div class="small text-muted">Greater Sort Number will appear first. </div>
							<div class="text-accent-red" id="SortIDval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt mt-5">
							<label class="form-label"> @Html.CheckBoxFor(x => x.IsPublished) Is Published</label>
						</div>
					</div>
					<div class="col-md-4">
						<div class="form-group mb-24pt">
							<label class="form-label">Featured Image</label>
							<input type="file" name="FeaturedImageFile" accept="image/*" id="FeaturedImageFile" class="form-control" />
							<div class="small text-muted">Should Be (370 X 370) px </div>
							<div class="text-accent-red" id="FeaturedImageFileval"></div>
						</div>
					</div>
					<div class="col-md-4">
						<img id="FeaturedImageImg" style="width:100%;height:auto" src="~/Images/@Model.FeaturedImage" />
					</div>
					<div class="col-md-12">
						<textarea class="tinymce" id="tiny"></textarea>
						<div class="text-accent-red" id="Contentval"></div>
					</div>
				</div>
				<div class="">
					<div class="card-header text-center">
						@if (Model.Id > 0)
						{
							<a id="btnSave" class="btn btn-outline-success">&nbsp; Update</a>
						}
						else
						{
							<a id="btnSave" class="btn btn-outline-success">&nbsp; Save</a>
						}
						<a href="/Blogs/BlogPost/List" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i> &nbsp; Back To List</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


@section scripts {
	@Scripts.Render("~/bundles/jqueryval")
	<script src="~/Scripts/tinymce/tinymce.js"></script>
	<script>

		$(document).on("click", "#btnSave", function () {

			var result = ValidateForm();
			DetailList = [];
			if (result) {
				Save();
			}

		})
		function Save() {
			$(".divLoader").show();
			const publishedDate = moment($("#PublishedDate").val()).format("MM/DD/YYYY");

			var formData = new FormData();

			formData.append("Id", $("#Id").val());
			formData.append("Title", $("#Title").val());
			formData.append("Description", $("#Description").val());
			formData.append("Category", $("#Category").val());
			formData.append("Author", $("#Author").val());
			formData.append("PublishedDT", publishedDate);
			formData.append("Tags", $("#Tags").val());
			formData.append("SortID", $("#SortID").val());
			formData.append("IsPublished", $("#IsPublished").is(":checked"));
			formData.append("BlogContent", tinyMCE.get('tiny').getContent());

			// Append the selected file (if any)
			var fileInput = $("#FeaturedImageFile")[0];
			if (fileInput.files.length > 0) {
				formData.append("FeaturedImageFile", fileInput.files[0]);
			}

			$.ajax({
				url: '/Blogs/BlogPost/Index',
				method: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				xhr: function () {
					var xhr = new XMLHttpRequest();
					xhr.upload.addEventListener('progress', function (e) {
						if (e.lengthComputable) {
							var percent = (e.loaded / e.total) * 100;
							console.log('Upload Progress: ' + percent + '%');
							$('#progressBar').css('width', percent + '%');
						}
					}, false);
					return xhr;
				},
				success: function (response) {
					$(".divLoader").hide();
					if (response.Id > 0) {
						$("#Id").val(response.Id);
						Swal.fire("Data Saved Successfully");
					} else {
						Swal.fire("Save Failed", "Please check your data", "error");
					}
				},
				error: function (err) {
					$(".divLoader").hide();
					Swal.fire("Error", "Something went wrong!", "error");
				}
			});
		}


        $(document).ready(function () {
			tinymce.init({
				selector: 'textarea#tiny',
				statusbar: true,
				menubar: true,
				plugins: [
					'print preview paste importcss searchreplace autolink autosave save directionality',
					'code visualblocks visualchars fullscreen image link media template codesample',
					'table charmap hr pagebreak nonbreaking anchor toc insertdatetime advlist lists',
					'wordcount imagetools textpattern noneditable help charmap quickbars emoticons',
					'fullscreen', 'quickbars', 'powerpaste', 'autoresize','style'
				],
				toolbar: `undo redo | fontsizeselect | bold italic underline strikethrough |
              forecolor backcolor | alignleft aligncenter alignright alignjustify |
              outdent indent | numlist bullist | link image media | codesample code table |
              removeformat | fullscreen preview`,
				toolbar_mode: 'sliding',
				quickbars_selection_toolbar: 'bold italic | quicklink h1 h2 h3 blockquote',
				contextmenu: 'link image imagetools table',
				image_caption: true,
				toolbar_sticky: true,
				autosave_ask_before_unload: true,
				autosave_interval: "30s",
				autosave_retention: "2m",
                image_advtab: true
			});


            $("#tiny").html(`@Model.BlogContent`);
		})
		function ValidateForm() {
			let isValid = true;

			// Clear all previous messages
			$(".text-accent-red").html("");

			const title = $("#Title").val();
			const Description = $("#Description").val();
			const category = $("#Category").val();
			const author = $("#Author").val();
			const publishedDate = $("#PublishedDate").val();
			const tags = $("#Tags").val();
			const sortID = $("#SortID").val();
			const content = tinyMCE.get("tiny").getContent({ format: 'text' }).trim();
			const featuredImageFile = $("#FeaturedImageFile").val();
			const featuredImagePath = $("#FeaturedImage").val(); // hidden field for saved image

			if (!title) {
				$("#Titleval").html("Title is required");
				isValid = false;
			}
			if (!Description) {
				$("#Descriptionval").html("Description is required");
				isValid = false;
			}
			if (!category) {
				$("#Categoryval").html("Category is required");
				isValid = false;
			}
			if (!author) {
				$("#Authorval").html("Author is required");
				isValid = false;
			}
			if (!publishedDate) {
				$("#PublishedDateval").html("Published Date is required");
				isValid = false;
			}
			if (!tags) {
				$("#Tagsval").html("Tags are required");
				isValid = false;
			}
			if (!sortID) {
				$("#SortIDval").html("Sort Number is required");
				isValid = false;
			}
			if (content.length <= 200) {
				$("#Contentval").html("Minimum Content length should 200 characters");
				isValid = false;
			}

			// Validate Featured Image
			if (!featuredImagePath && !featuredImageFile) {
				$("#FeaturedImageFileval").html("Featured image is required");
				isValid = false;
			}

			return isValid;
		}



		$("#FeaturedImageFile").on("change", function () {
			const file = this.files[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = function (e) {
					$("#FeaturedImageImg").attr("src", e.target.result);
				};
				reader.readAsDataURL(file);
			}
		});


	</script>



}

