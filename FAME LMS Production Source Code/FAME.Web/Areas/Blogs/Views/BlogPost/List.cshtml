@{
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
	ViewBag.Title = "BlogPosts";
}

<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center mb-24pt mb-md-0">

			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Blog Posts</h2>
			</div>
		</div>


		<div class="row" role="tablist">
			<div class="col-auto">
				<a href="/Blogs/BlogPost/Index" class="btn btn-outline-secondary">Add BlogPost</a>
			</div>
		</div>

	</div>

	<div class="page-section border-bottom-2">
		<div style="margin: 0;max-width: 100%" class="container-fluid page__container">
			<div class="row">
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Basic information</div>
					</div>
					<table id="DTable" class="table  table-bordered">
						<thead>
							<tr style="background-color: #364e9c">
								<th>Sort Id</th>
								<th>Title</th>
								<th>Category</th>
								<th>Author</th>
								<th>Is Online</th>
								<th></th>
							</tr>
						</thead>
						<tbody>

						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

</div>



@section scripts {
	@Scripts.Render("~/Scripts/List")


	@if (TempData["Success"] != null)
	{
		<script>
			Swal.fire({
				position: 'top-end',
				icon: 'success',
				title: 'Data Saved Successfully',
				showConfirmButton: false,
				timer: 1500
			})
		</script>
	}


	<script>
		$(document).ready(function () {
			$('#DTable').DataTable({
				"processing": true,
				"serverSide": true,
				"lengthMenu": [[10, 25, 50], [10, 25, 50]],
				order: [[0, "desc"]],
				"ajax": {
					"url": "/Blogs/BlogPost/GetBlogPosts", // controller action
					"type": "POST"
				},
				"columns": [
					{ "data": "SortID" },
					{ "data": "Title" },
					{ "data": "Category" },
					{ "data": "Author" },
					{
						"data": "IsPublished",
						"render": function (data, type, row) {
							return data ? 'Yes' : 'No';
						}
					},
					{
						"data": "Id",
						"render": function (data, type, row) {
							return `<a href="/Blogs/BlogPost/Index/${data}" class="text-warning">
										<i class="fa fa-edit Font20"></i>
									</a>`;
						},
						"orderable": false,
						"searchable": false
					}
				]
			});
		});
	</script>


	<script>

		$(document).on("click", "#btnDelete", function () {
			var id = $(this).data('id');
			var btn = $(this);
			Swal.fire({
				title: 'Are you sure?',
				text: " You Want To Delete The Package?",
				icon: 'warning',
				showCancelButton: false,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Yes!'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "/Course/Delete/" + id,
						method: "POST",
						beforeSend: function () {
							swal.fire({
								html: '<h5>Loading...</h5>',
								showConfirmButton: false,
								onRender: function () {
									// there will only ever be one sweet alert open.
									$('.swal2-content').prepend(sweet_loader);
								}
							});
						},
						success: function (result) {
							if (result) {
								btn.hide();
								Swal.fire(
									'Deletes!',
									'The Package Has Been Removed.',
									'success'
								)
								window.location.href = "/Package/List";
							}
						}, error: function (err) {
							alert("Error" + err);
						}
					})

				}
			})
		})
	</script>

}

