@using First_Aid_Made_Easy.DAL

@{
    ViewBag.Title = "Support Agent Category";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    var List = (List<tbl_Master>)ViewBag.List;
    int Sr = 0;
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Support Agent Category</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Support Agent Category
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Add Category</div>
                    </div>
                    <div style="margin-top:20px;margin-bottom:30px">
                        <form action="/General/SaveAgentCategory" method="post">
                            <div class="row">
                                @Html.Hidden("Master_ID")
                                <div class="col-md-4">
                                    <label>Category Name</label>
                                    <input id="Master_Value" type="text" name="Master_Value" required class="form-control" placeholder="Category Name">
                                </div>
                                <div class="col-md-4 mt-4">
                                    <button type="submit" id="btnSave" class="btn btn-outline-success">Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Category List</div>
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        <table style="width:100% !important" id="DTable" class="table table-bordered">
                            <thead>
                                <tr style="background-color: #364e9c">
                                    <th>Sr.</th>
                                    <th>Category</th>
                                    <th style="min-width:80px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in List)
                                {
                                    Sr++;
                                    <tr>
                                        <td>@Sr</td>
                                        <td id="Name">@i.Master_Value</td>
                                        <td>
                                            <a href="javascript:;" id="btnEdit" data-id="@i.Master_ID" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>
                                            <a href="javascript:;" id="btnDelete" data-id="@i.Master_ID" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {

    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable({ "lengthMenu": [[-1, 25, 50, 100], ["All", 25, 50, 100]] });
            //$(document).find("#DTable_wrapper").css("display", "");
        })

        $(document).on("click", "#btnDelete", function () {
            var tr = $(this).closest("tr");
            var id = $(this).data("id");
            Swal.fire({
                title: 'Are you sure?',
                text: "You Want To Delete the Category ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/General/DeleteAgentCategory/" + id,
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Deleting Category...</h5>',
                                showConfirmButton: false,
                                onRender: function () { $('.swal2-content').prepend(sweet_loader); }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                Swal.fire(
                                    'Delete!',
                                    'The Category  Has Been Deleted.',
                                    'success'
                                )
                                tr.remove();
                            } else {
                                Swal.fire(
                                    'Cannot be Deleted!',
                                    'The Category  Has Been Used in Support Agent.',
                                    'erroe'
                                )
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })
        $(document).on("click", "#btnEdit", function () {
            var tr = $(this).closest("tr");
            var id = $(this).data("id");
            $("#Master_Value").val(tr.find("#Name").text());
            $("#Master_ID").val(id);
            $("#btnSave").text("Update")
        })

    </script>

}

