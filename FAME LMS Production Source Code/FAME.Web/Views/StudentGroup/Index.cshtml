@model First_Aid_Made_Easy.Models.StudentGroupVM
@using First_Aid_Made_Easy.BLL
@{
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

	ViewBag.Title = " Describe Student Group";
}
<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Describe Student Group</h2>
				<ol class="breadcrumb p-0 m-0">
					<li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
					<li class="breadcrumb-item active">
						Describe Student Group
					</li>
				</ol>
			</div>
		</div>
	</div>


	<div class="page-section border-bottom-2">
		<div class="page__container">

			<div class="row">
				<div class="col-md-12">

					<div class="page-separator">
						<div class="page-separator__text">Basic information</div>
					</div>
					@Html.ValidationSummary("", new { @class = "text-danger" })
					@Html.HiddenFor(model => model.Id)
					<label class="form-label">Group Title</label>
					<div class="form-group mb-24pt">
						@Html.TextBoxFor(model => model.GroupTitle, new { @class = "form-control form-control-lg", @placeholder = "", @required = "required" })
						@Html.ValidationMessageFor(model => model.GroupTitle, "", new { @class = "text-accent-red" })
						<small class="form-text text-muted"></small>
					</div>
					<div>
						<label class="form-label">Description</label>
						<div class="form-group mb-24pt">
							@Html.TextBoxFor(model => model.Description, new { @class = "form-control form-control-lg", @placeholder = "" })
							@Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-accent-red" })
						</div>
					</div>

					<div class="form-row">

						<div class="col-12 col-md-3 mb-3">
							<label class="form-label">University</label>
							@Html.DropDownListFor(model => model.UniversityID, new SelectList(First_Aid_Made_Easy.BLL.Common.Universities.Where(X => X.Value > 1 && X.IsActive), "Value", "Text"), "Please Select", new { @class = "form-control select2", @required = "required", @data_toggle = "select" })
							@Html.ValidationMessageFor(model => model.UniversityID, "", new { @class = "text-accent-red" })
						</div>
						<div class="col-12 col-md-3 offset-3 mb-3 " style="margin-top:20px">
							<button id="AddStudents" class="btn btn-outline-accent-red">Add Students</button>
							<p style="display:none" class="text-accent-red field-validation-valid" id="UniversityVal">Please select a university</p>
						</div>

						@*<div class="col-md-3">
								<label class="form-label">Pic</label>
								<input name="File" id="File" class="form-control" type="file" accept="image/png, image/gif, image/jpeg">
							</div>

							@if (Model.Pic != null)
							{
								<div class="col-md-3">
									<img style="width:150px;height:150px" src="@Url.Content("~/Images/"+Model.Pic)" />
								</div>
							}*@


					</div>
					@* =========== MCQs ==================*@
					<div class="row">
						<div class="col-md-12">
							<table id="mDTable" class="table table-bordered">
								<thead>
									<tr style="background-color: #364e9c">
										<th>Student Email</th>
										<th>Student Name </th>
										<th style="max-width:20px"></th>
									</tr>
								</thead>
								<tbody id="selectedBody">
									@if (Model.Detail != null)
									{
										foreach (var q in Model.Detail)
										{
											<tr data-id="@q.StudentID">
												<td>@q.StudentEmail</td>
												<td>@q.StudentName</td>
												<td>
													<button href="javascript:;" id="btnUnSelect" class="btn btn-danger">x</button>
												</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
					@* =========== MCQs ==================*@



					<div class="card">
						<div class="card-header text-center">
							<p style="display:none" class="text-accent-red field-validation-valid" id="validation">Please Fill all required Fields</p>
							<p style="display:none" class="text-accent-red field-validation-valid" id="Questvalidation">Please Add atleast one Student</p>
							<a href="/StudentGroup/Index" class="btn btn-outline-accent-electric-violet"><i class="fa fa-recycle"></i>&nbsp; New</a>
							@if (Model.Id > 0)
							{
								<button onclick="Save()" id="btnSave" class="btn btn-outline-accent-red">Update</button>
								<a href="javascript:;" id="btnDelete" data-id="@Model.Id" class="btn btn-outline-accent-red"><i class="fa fa-trash"></i>&nbsp;  Delete</a>
							}
							else
							{
								<button onclick="Save()" id="btnSave" class="btn btn-outline-success">Save</button>
							}
							<a href="@Url.Action("List","StudentGroup")" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i>&nbsp;  Back To List</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


	<div id="students-modal" class="w3-modal">
		<div class="w3-modal-content">
			<header class="w3-container w3-indigo">
				<span onclick="Onclose()"
					  class="w3-button w3-display-topright">&times;</span>
				<h2 class="modal-title" style="color:white" id="students-modal-title">Add Students To Group</h2>
			</header>
			<div class="w3-container">
				<div class="">
					<table class="table table-bordered" id="selectionTable">
						<thead>
							<tr style="background-color: #364e9c">
								<th>Student Email</th>
								<th>Student Name </th>
								<th style="max-width:20px"></th>
							</tr>
						</thead>
						<tbody id="selectionBody">
						</tbody>
					</table>
				</div>
				<div class="modal-footer pb-0 px-0">
					<button type="button" class="btn btn-secondary" onclick="Onclose()">Close</button>
				</div>
			</div>
		</div>
	</div>
</div>
@section scripts {
	@Scripts.Render("~/bundles/jqueryval")
	<script src="~/Content/assets/vendor/moment.min.js"></script>
	<script>
		var $selectedBody = $("#selectedBody");
		var $selectionBody = $("#selectionBody");
		$(document).ready(function () {

			$("#mDTable").DataTable();

			if ($("#Id").val() > 0) {
			}
		})

		$(document).on("click", "#AddStudents", function () {
			FilterList();
		})
		$(document).on("click", "#btnSelect", function () {
			var $tr = $(this).closest("tr");
			$(this).remove();
			$selectedBody.append(`<tr data-id="${$tr.data("id")}">
											<td>${$tr.find('td').eq(0).text()}</td>
											<td>${$tr.find('td').eq(1).text()}</td>
											<td>
												<button href="javascript:;" id="btnUnSelect" class="btn btn-danger">x</button>
											</td>
										</tr>`);
		})
		$(document).on("click", "#btnUnSelect", function () {
			$("#mDTable").DataTable().destroy();
			$(this).closest("tr").remove();
			$("#mDTable").DataTable();
		})

		function Save() {

			$("#mDTable").DataTable().destroy();
			var data = {
				Id: $("#Id").val(),
				GroupTitle: $("#GroupTitle").val(),
				Description: $("#Description").val(),
				UniversityID: $("#UniversityID").val(),
				Detail: $selectedBody.find("tr").map(function () { return { StudentID: $(this).data("id") } }).toArray()
			}

			if (IsValid(data)) {
				$(".divLoader").show();
				$("#btnSave").hide();
				$.ajax({
					url: '/StudentGroup/Index',
					method: 'POST',
					data: JSON.stringify(data),
					dataType: 'Json',
					contentType: 'application/json',
					success: function (response) {
						if (response.Id > 0) {
							//UploadFiles(response.Id);
							DataSaved();
							$(".divLoader").hide();
							$("#mDTable").DataTable();
						}
					},
					error: function (err) {
						$(".divLoader").hide();

					}

				});
			}
		}

		function IsValid(data) {
			$(".field-validation-valid").hide();
			if (data.GroupTitle == "" || data.Detail.length == 0) {
				if (data.GroupTitle == "") $('[data-valmsg-for="GroupTitle"]').html("Paper Title Is Required").show();
				if (data.Detail.length == 0) $('#Questvalidation').show();
				$("#validation").show();
				return false;
			} else
				return true;
		}

		$(document).on("click", "#btnDelete", function () {
			var btn = $(this);
			var id = btn.data("id");
			var Name = btn.data("name");
			Swal.fire({
				title: 'Are you sure?',
				text: "You Want To Delete the Student Group ?",
				icon: 'warning',
				showCancelButton: false,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Yes!'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "/StudentGroup/Delete/" + id,
						method: "GET",
						beforeSend: function () {
							swal.fire({
								html: '<h5>Deleting Student Group...</h5>',
								showConfirmButton: false,
								onRender: function () { $('.swal2-content').prepend(sweet_loader); }
							});
						},
						success: function (result) {
							if (result) {
								btn.hide();
								Swal.fire(
									'Delete!',
									'The Student Group  Has Been Deleted.',
									'success'
								)
								window.location.href = "/StudentGroup/List?Type=" + $("#Type").val();
							}
						}, error: function (err) {
							alert("Error" + err);
						}
					})

				}
			})
		})
	</script>
	<script>

		function FilterList() {
			var Type = $("#UniversityID").val();
			$("#UniversityVal").hide();
			if (Type > 0) {
				$(".divLoader").show();
				$.ajax({
					url: "/StudentGroup/FilterStudentList?Type=" + Type,
					success: function (result) {
						if (result != null) {
							$("#selectionTable").DataTable().destroy();
							$("#mDTable").DataTable().destroy();
							AppendRows(result);
							$("#students-modal").show();
							$(".divLoader").hide();
						}
					}, error: function (err) {
						alert("Error" + err);
					}
				})
			} else {
				$("#UniversityVal").show();
			}
		}

		function AppendRows(data, row) {
			var ids = GetStudentIds();
			$selectionBody.html("");
			$.each(data, function (i, q) {
				if (ids.indexOf(q.User_AspUser) == -1) {
					var html = `
															<tr data-id="${q.User_AspUser}">
																<td>${q.Email}</td>
																<td>${q.User_Name}</td>
																<td>
																	<button href="javascript:;" id="btnSelect" class="btn btn-success"><i class="fa fa-plus" ></i></button>
																</td>
															</tr>
															`;
					$selectionBody.append(html);
				}
			})
			$("#selectionTable").DataTable();
		}


		function GetStudentIds() {
			var ids = $selectedBody.find("tr").map(function () { return $(this).data("id") }).toArray();
			return ids;
		}
		function Onclose() {
			document.getElementById('students-modal').style.display = 'none';
			$("#mDTable").DataTable();
		}
	</script>
	<script>

		function UploadFiles(Id) {
			var formdata = new FormData();
			var File = document.getElementById('File');
			if (File.files.length > 0) {
				var sfilename = File.files[0].name;
				formdata.append(sfilename, File.files[0]);
				$.ajax({
					url: '/StudentGroup/UploadImage/' + Id,
					type: "POST",
					contentType: false,
					processData: false,
					data: formdata,
					success: function (result) {
					},
					error: function (err) {
						alert(err.statusText);
					}
				});
			}
		}


	</script>
}

