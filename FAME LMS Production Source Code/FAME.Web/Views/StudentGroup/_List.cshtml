@model First_Aid_Made_Easy.Models.StudentGroupVM
@using First_Aid_Made_Easy.BLL
@{
    int Sr = 0;
}
<table style="width:100% !important" id="DTable" class="table table-bordered">
    <thead>
        <tr style="background-color: #364e9c">
            <th>Sr.</th>
            <th>Title</th>
            <th>University</th>
            <th style="min-width:80px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.List)
        {
            Sr++;
            <tr>
                <td>@Sr</td>
                <td>@i.GroupTitle</td>
                <td>@i.UniversityName</td>
                <td>
                    <a href="/StudentGroup/Index/@i.Id" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>|
                    <a href="javascript:;" id="btnRowDelete" data-name="Student Group" data-url="/StudentGroup/Delete/@i.Id" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>