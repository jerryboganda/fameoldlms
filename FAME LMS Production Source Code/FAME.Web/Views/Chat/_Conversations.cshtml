@model First_Aid_Made_Easy.Models.ChatVM
<a href="/Chat/FriendList" style="border:1px solid #c7c7c7 !important" class="list-group-item list-group-item-action border-0">
    <div class="badge bg-success float-right"></div>
    <div class="d-flex align-items-start">
        <div class="avatar avatar-sm mr-3">
            <span class="avatar-title rounded-circle">ALL</span>
        </div>
        <div class="flex-grow-1 ml-3">
            <b>Friends List</b> <i class="fa fa-users emp-icon"></i>
        </div>
    </div>
</a>
<hr class="mt-1 mb-0">

@if (Model.List != null && Model.List.Count() > 0)
{
    foreach (var i in Model.List)
    {
        <a href="javascript:;" id="btnConv" data-id="@i.ConvID" data-friendid="@i.FriendID" style="border:1px solid #c7c7c7 !important" class="list-group-item list-group-item-action border-0">
            <div id="msgCount" class="badge bg-success float-right"></div>
            <div class="d-flex align-items-start">
                <img src="@Url.Content("~/Images/"+i.FriendPic)" class="rounded-circle mr-1" alt="img" width="40" height="40">
                <div class="flex-grow-1 ml-3">
                    <b>@i.FriendName</b>
                    <div id="Activestatus" class="small"></div>
                </div>
            </div>
        </a>
    }
}
else
{

}