                        <!--begin::Contact group-->
                        <div class="d-flex flex-stack">
                            <a href="../../demo3/dist/apps/contacts/getting-started.html" class="fs-6 fw-bold text-gray-800 text-hover-primary">Subscribed</a>
                            <div class="badge badge-light-primary">3</div>
                        </div>
