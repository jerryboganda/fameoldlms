@using Microsoft.AspNet.Identity
@using First_Aid_Made_Easy.BLL
@{
    var user = Common.GetUserNameByASpUserID(User.Identity.GetUserId());
    var Conversation = (First_Aid_Made_Easy.Models.ChatVM)ViewBag.Conversation;
}
@if (Conversation.LoadMore)
{
    <div id="btnLoadMore" data-id="@Conversation.Replies.Min(x=>x.ID)" class="chat-message-Left pb-4">
        <div class="flex-shrink-1 btn-light rounded py-2 px-3 ml-3">
            <div class="font-weight-bold text-center mb-1">Load More</div>
        </div>
    </div>
}
@if (Conversation != null)
{

    if (Conversation.Replies != null && Conversation.Replies.Count() > 0)
    {
        foreach (var i in Conversation.Replies)
        {
            string side = i.Side == "left" ? "start" : "end";
            <div class="d-flex justify-content-@side mb-10">
                <div class="d-flex flex-column align-items-start">
                    <div class="d-flex align-items-center mb-2">
                        <div class="symbol symbol-35px symbol-circle">
                            <img alt="Pic" src="@Url.Content("~/Images/" + i.Pic)" />
                        </div>
                        <div class="ms-3">
                            <a href="#" class="fs-5 fw-bold text-gray-900 text-hover-primary me-1">@i.Name</a>
                            <span class="text-muted fs-7 mb-1">@string.Format("{0:hh:mm tt}", i.SentAt)</span>
                        </div>
                    </div>
                    <div class="p-5 rounded bg-light-info text-dark fw-semibold mw-lg-400px text-start" data-kt-element="message-text">
                        @i.ReplyBody
                        @if (i.FilePath != null)
                        { <br /> <a href="@Url.Content("~/Images/Chat/"+i.FilePath)" target="_blank"><i class="bi bi-paperclip fs-3"></i><b>@i.FilePath</b></a> }
                    </div>
                </div>
            </div>
        }
    }
}