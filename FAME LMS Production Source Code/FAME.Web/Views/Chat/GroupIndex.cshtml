@model First_Aid_Made_Easy.Models.ChatVM
@using First_Aid_Made_Easy.BLL
@{
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    ViewBag.Title = " Describe Group";
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Describe Group</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Describe Group
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div class="container-fluid page__container">
            <form method="post" action="/Chat/SaveGroup">
                <div class="row">
                    <div class="col-md-12">
                        <div class="page-separator">
                            <div class="page-separator__text">Basic information</div>
                        </div>
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.ConvID)
                        <label class="form-label">Title</label>
                        <div class="form-group mb-24pt">
                            @Html.TextBoxFor(model => model.Title, new { @class = "form-control form-control-lg", @placeholder = "Title", @required = "required" })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-accent-red" })
                            <small class="form-text text-muted"></small>
                        </div>

                        <div id="divAnswer">
                            <label class="form-label">Description</label>
                            <div class="form-group mb-24pt">
                                @Html.TextBoxFor(model => model.Descriptiom, new { @class = "form-control form-control-lg", @placeholder = "Description" })
                                @Html.ValidationMessageFor(model => model.Descriptiom, "", new { @class = "text-accent-red" })
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="col-md-6">
                                <label class="form-label">Course</label>
                                <div class="form-group mb-24pt">
                                    @Html.DropDownListFor(model => model.CourseID, new SelectList(ViewBag.Courses, "Value", "Text"), "Select Course", new { @class = "form-control select2" })
                                    <div class="text-accent-red" id="CourseVal"></div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="text-label">Package</label>
                                    <div class="input-group input-group-merge">
                                        @Html.DropDownListFor(model => model.PackageID, new SelectList(ViewBag.Packages, "Value", "Text"), "Select Package", new { @class = "form-control  select2", @data_toggle = "select" })
                                        <div id="PackageVal" class="text-danger"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header text-center">
                                <a href="/Chat/GroupIndex" class="btn btn-outline-accent-electric-violet"><i class="fa fa-recycle"></i>&nbsp; New</a>
                                @if (Model.ConvID > 0)
                                {
                                    <button type="submit" id="btnSave" class="btn btn-outline-accent-red">Update</button>
                                    <a href="javascript:;" id="btnDelete" data-id="@Model.ConvID" class="btn btn-outline-accent-red"><i class="fa fa-trash"></i>&nbsp;  Delete</a>
                                }
                                else
                                {
                                    <button onclick="Save()" id="btnSave" class="btn btn-outline-success">Save</button>
                                }
                                <a href="@Url.Action("GroupList","Chat")" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i>&nbsp;  Back To List</a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")


    <script>
        $(document).ready(function () {
        })

        $(document).on("click", "#btnDelete", function () {
            var btn = $(this);
            var id = btn.data("id");
            var Name = btn.data("name");
            Swal.fire({
                title: 'Are you sure?',
                text: "You Want To Delete the Group '" + Name + "' ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Questions/DeleteQuestion/" + id,
                        method: "GET",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Deleting Group...</h5>',
                                showConfirmButton: false,
                                onRender: function () { $('.swal2-content').prepend(sweet_loader); }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                btn.hide();
                                Swal.fire(
                                    'Delete!',
                                    'The Group ' + Name + ' Has Been Deleted.',
                                    'success'
                                )
                                window.location.href = "/Questions/List?Type=" + $("#Type").val();
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })
    </script>

}

