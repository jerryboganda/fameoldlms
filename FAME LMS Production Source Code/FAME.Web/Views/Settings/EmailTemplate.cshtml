@model First_Aid_Made_Easy.BLL.JzTimer.EmailReportVM
@{
	Layout = null;
}
<style>
	html, body {
		padding: 0;
		margin: 0;
	}

</style>
<div style="font-family:Arial,Helvetica,sans-serif; line-height: 1.5; font-weight: normal; font-size: 15px; color: #2F3044; min-height: 100%; margin:0; padding:0; width:100%; background-color:#edf2f7">
	<table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin:0 auto; padding:0; max-width:600px">
		<tbody>
			<tr>
				<td align="center" valign="middle" style="text-align:center; padding: 40px">
					<a href="https://firstaidmadeeasy.com.pk" rel="noopener" target="_blank"> </a>
				</td>
			</tr>
			<tr>
				<td align="left" valign="middle">
					<div style="text-align:left; margin: 0 20px; padding: 40px; background-color:#ffffff; border-radius: 6px">
						<div style="padding-bottom: 30px; font-size: 17px;">
							<strong>FAME Activity Report</strong>
						</div>
						<div style="padding-bottom: 30px">
							@{
								string message = "";

								if (Model.Settings.AfterDays == Model.Student.Days)
								{
									message = Model.Settings.FirstDayMessage;
								}
								else if (Model.Settings.WarningAfterDays == Model.Student.Days)
								{
									message = Model.Settings.WarningMessage;
								}
								else if (Model.Settings.ParentAfterDays == Model.Student.Days)
								{
									message = Model.Settings.ParentMessage;
								}
							}

							@message

						</div>
					</div>
				</td>
			</tr>
			@if (Model.Settings.SendLoginInfo)
			{
				int Sr = 0;
				<tr>
					<td align="left" valign="middle">
						<div style="text-align:left; margin: 0 20px; padding: 40px; background-color:#ffffff; border-radius: 6px">
							<div style="padding-bottom: 30px; font-size: 17px;">
								<strong>Login Information (Last 5)</strong>
							</div>
							<table style="width: 100%; max-width: 100%; margin-bottom: 1rem; background-color: transparent; border-collapse: collapse; text-align: left" border="1">
								<thead>
									<tr>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Sr.</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Device</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Date Time</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var a in Model.LogInfo)
									{
										Sr++;
										var DeviceName = "";
										if (a.UserAgent != null)
										{
											var s = a.UserAgent?.IndexOf("(") ?? -1;
											var e = a.UserAgent?.IndexOf(")") ?? -1;
											if (s != -1)
											{
												DeviceName = a.UserAgent.Substring(s, e - s + 1);
											}
										}
										<tr>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@Sr</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@DeviceName</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@string.Format("{0:dd/MM/yyyy hh:mm tt}", a.DateTime)</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</td>
				</tr>
			}
			@if (Model.Settings.SendLectureReport)
			{
				int Sr = 0;
				<tr>
					<td align="left" valign="middle">
						<div style="text-align:left; margin: 0 20px; padding: 40px; background-color:#ffffff; border-radius: 6px">
							<div style="padding-bottom: 30px; font-size: 17px;">
								<strong>Watch Hours Last 5 Days</strong>
							</div>

							<table style="width: 100%; max-width: 100%; margin-bottom: 1rem; background-color: transparent; border-collapse: collapse; text-align: left" border="1">
								<thead>
									<tr>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Sr.</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Day</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Screen Time</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var a in Model.Watch)
									{
										Sr++;
										<tr>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@Sr</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@string.Format("{0:dddd, dd/MM/yyyy}", a.DateTime)</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@First_Aid_Made_Easy.BLL.Common.HrsMins(a.Watched)</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</td>
				</tr>
			}
			@if (Model.Settings.SendTestAttempts)
			{
				int Sr = 0;
				<tr>
					<td align="left" valign="middle">
						<div style="text-align:left; margin: 0 20px; padding: 40px; background-color:#ffffff; border-radius: 6px">
							<div style="padding-bottom: 30px; font-size: 17px;">
								<strong>Test Attempts</strong>
							</div>
							<table style="width: 100%; max-width: 100%; margin-bottom: 1rem; background-color: transparent; border-collapse: collapse; text-align: left" border="1">
								<thead>
									<tr>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Sr.</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Paper</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Attempt At</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Total</th>
										<th style="padding: 0.75rem; vertical-align: top; border-top: 1px solid #dee2e6">Obtained</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var a in Model.Result)
									{
										Sr++;
										<tr>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@Sr</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@(a.QuestionPaper ?? a.Mode )</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@string.Format("{0:dd/MM/yyyy hh:mm tt}", a.Datetime)</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@a.TotalMarks</td>
											<td style="padding: 0.75rem; vertical-align: top; border: 1px solid #dee2e6">@a.ObtainedMarks</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</td>
				</tr>
			}
			<tr>
				<td align="center" valign="middle" style="font-size: 13px; text-align:center;padding: 20px; color: #6d6e7c;">
					<p>Mall road, Lahore, Punjab, Pakistan</p>
					<p>
						Copyright ©
						<a href="https://polytronx.com/" rel="noopener" target="_blank">PolytronX – Business Digitalized</a>.
					</p>
				</td>
			</tr>
		</tbody>
	</table>
</div>