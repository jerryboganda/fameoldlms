@model First_Aid_Made_Easy.BLL.JzTimer.EmailSettingsVM
@{
	ViewBag.Title = "ADD Welcome Message";
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Report Message Settings</h2>
			</div>
		</div>
	</div>
	<div class="page-section border-bottom-2">
		<div class="container-fluid page__container">
			<form id="frmSettings">
				<div class="row">
					<div class="col-md-12 card p-3">
						<div class="page-separator">
							<div class="page-separator__text">Basic Information</div>
						</div>
						<div class="row">
							<div class="col-md-4">
								<label class="form-label">
									@Html.CheckBoxFor(model => model.SendLoginInfo, new { })
									Send Login Info
								</label>
							</div>
							<div class="col-md-4">
								<label class="form-label">
									@Html.CheckBoxFor(model => model.SendLectureReport, new { })
									Send Lecture Report
								</label>
							</div>
							<div class="col-md-4">
								<label class="form-label">
									@Html.CheckBoxFor(model => model.SendTestAttempts, new { })
									Send Test Attempts
								</label>
							</div>
							<div class="col-md-12">
								<label class="form-label"> Universities </label>
								@Html.DropDownListFor(model => model.Universities, new SelectList(First_Aid_Made_Easy.BLL.Common.Universities.Where(x => x.Value > 0 && x.IsActive), "Value", "Text"), "Please Select", new { @class = "form-control select2", @multiple = true, @data_toggle = "select" })
							</div>
						</div>
					</div>
					<div class="col-md-12 card p-3">
						<div class="page-separator">
							<div class="page-separator__text">Notification message</div>
						</div>
						<div class="row">
							<div class="col-md-4">
								<label class="form-label">
									First notification message should be send after
									days of inactivity
								</label>
								@Html.TextBoxFor(model => model.AfterDays, new { @class = "form-control form-control-lg", @placeholder = "No. Of Days", @type = "number" })

							</div>
							<div class="col-md-8">
								<div class="form-group mb-24pt">
									@Html.TextAreaFor(model => model.FirstDayMessage, new { @class = "form-control form-control-lg", @placeholder = "Message Text", @rows = "3" })
									<div class="text-accent-red" id="MessageTitleval"></div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-md-12 card p-3">

						<div class="page-separator">
							<div class="page-separator__text">Warning message</div>
						</div>
						<div class="row">
							<div class="col-md-4">
								<label class="form-label">
									Warning message should be send after
									days of inactivity
								</label>
								@Html.TextBoxFor(model => model.WarningAfterDays, new { @class = "form-control form-control-lg", @placeholder = "No. Of Days", @type = "number" })

							</div>
							<div class="col-md-8">
								<div class="form-group mb-24pt">
									@Html.TextAreaFor(model => model.WarningMessage, new { @class = "form-control form-control-lg", @placeholder = "Message Text", @rows = "3" })
									<div class="text-accent-red" id="MaessageBodyval"></div>
								</div>
							</div>
						</div>
					</div>

					<div class="col-md-12 card p-3">

						<div class="page-separator">
							<div class="page-separator__text">Parent message</div>
						</div>
						<div class="row">
							<div class="col-md-4">
								<label class="form-label">
									Message to parents should be send after
									days of inactivity
								</label>
								@Html.TextBoxFor(model => model.ParentAfterDays, new { @class = "form-control form-control-lg", @placeholder = "No. Of Days", @type = "number" })

							</div>
							<div class="col-md-8">
								<div class="form-group mb-24pt">
									@Html.TextAreaFor(model => model.ParentMessage, new { @class = "form-control form-control-lg", @placeholder = "Message Text", @rows = "3" })
									<div class="text-accent-red" id="MaessageBodyval"></div>
								</div>
							</div>
						</div>
						<div class="card">
							<div class="card-header text-center">
								<button type="button" id="btnSave" class="btn btn-outline-success">&nbsp; Save</button>
							</div>
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

@section scripts {

	<script>

		$(document).ready(function () {
			$("#Universities").val(@Html.Raw(Json.Encode(Model.Universities?.Split(',')))).change();
		})

		$.fn.getValue = function () {
			var el = $("input[name=" + $(this)[0].name + "]");
			if (el.hasClass("numeric") || el.hasClass("numericOnly")) {
				return parseFloat(this[0].value.split(",").join("")) || 0;
			} else {
				return this[0].value;
			}
		};

		$.fn.serializeObject = function () {
			var o = {};
			var a = this.serializeArray();
			$.each(a, function () {
				if (o[this.name]) {
					if (!o[this.name].push) {
						o[this.name] = [o[this.name]];
					}
					o[this.name].push($(this).getValue() || '');
				} else {
					o[this.name] = $(this).getValue() || '';
				}
			});
			return o;
		};

		$("#btnSave").click(function () {
			var formData = $("#frmSettings").serializeObject();
			formData.SendLoginInfo = $("#SendLoginInfo").is(":checked");
			formData.SendTestAttempts = $("#SendTestAttempts").is(":checked");
			formData.SendLectureReport = $("#SendLectureReport").is(":checked");
			formData.Universities = $("#Universities").val().join(','),

			$(".divLoader").show();

			$.ajax({
				url: "/Settings/SaveEmailSettings",
				method: "post",
				data: formData,
				success: function () {
					$(".divLoader").hide();
					Swal.fire({
						position: 'top-end',
						icon: 'success',
						title: 'Data Saved Successfully',
						showConfirmButton: false,
						timer: 1500
					})
				},
				error: function () {
					$(".divLoader").hide();
					Swal.fire({
						position: 'top-end',
						icon: 'error',
						title: 'Something Went Wrong',
						showConfirmButton: false,
						timer: 1500
					})
				}
			})
		})

	</script>

}

