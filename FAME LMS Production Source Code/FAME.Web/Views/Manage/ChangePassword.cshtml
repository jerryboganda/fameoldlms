@model First_Aid_Made_Easy.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "MyProfile";
    if (User.IsInRole("Student"))
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else if (User.IsInRole("SuppAgent"))
    {
        Layout = "~/Views/Shared/_LayoutAgent.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    }
}

<link type="text/css" href="~/Content/assets/css/select2.css" rel="stylesheet">

<link type="text/css" href="~/Content/assets/vendor/select2/select2.min.css" rel="stylesheet">

<div class="page-section bg-alt border-bottom-2">
    <div class="container page__container">

        <div class="d-flex flex-column flex-lg-row align-items-center">
            <div class="flex d-flex flex-column align-items-center align-items-lg-start mb-16pt mb-lg-0 text-center text-lg-left">
                @if (ViewBag.NotComplete != null)
                {
                    <h3 class="h2 mb-8pt text-danger">Please Complete Your Profile</h3>
                }
                else
                {
                    <h1 class="h2 mb-8pt">Change Your Password</h1>
                }
            </div>
            <div class="ml-lg-16pt">
                <a href="/Home/Index" class="btn btn-light">Back</a>
            </div>
        </div>

    </div>
</div>


<div class="page-section">
    <div class="container page__container">

        <div class="row">
            <div class="col-lg-1">

            </div>
            <div class="col-lg-10">

                <div class="card">
                    <ul class="nav nav-tabs nav-tabs-card">
                        <li class="nav-item">
                            <a class="nav-link"
                               href="/Profile/MyProfile">Basic Information</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active"
                               href="#"
                               data-toggle="tab">Security</a>
                        </li>
                    </ul>
                    <div class="tab-content card-body">
                        <div class="tab-pane active"
                             id="first">
                            @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                            {
                                @Html.AntiForgeryToken()
                                if (ViewBag.Change == true)
                                {
                                    <label class="text-success">Password Changed Successfully</label>
                                }
                                @Html.ValidationSummary("", new { @class = "text-danger" })
                                <div class="form-horizontal">
                                    <div class="form-group  mt-30 row">
                                        <label for="name_on_invoice"
                                               class="col-sm-3 col-form-label form-label">Current Password</label>
                                        <div class="col-sm-6 col-md-4">
                                            @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", @placeholder = "Your Old Password" })
                                        </div>
                                    </div>
                                    <div class="form-group  mt-30 row">
                                        <label for="name_on_invoice"
                                               class="col-sm-3 col-form-label form-label">New Password</label>
                                        <div class="col-sm-6 col-md-4">
                                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", @placeholder = "Your New Password" })
                                        </div>
                                    </div>
                                    <div class="form-group  mt-30 row">
                                        <label for="name_on_invoice"
                                               class="col-sm-3 col-form-label form-label">Confirm New Password</label>
                                        <div class="col-sm-6 col-md-4">
                                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm New Password" })
                                        </div>
                                    </div>
                                    <div class="form-group  mt-30 row">
                                        <div class="col-sm-6 col-md-4 offset-sm-3">
                                            <input type="submit" value="Change password" class="btn btn-primary" />
                                        </div>
                                    </div>

                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}