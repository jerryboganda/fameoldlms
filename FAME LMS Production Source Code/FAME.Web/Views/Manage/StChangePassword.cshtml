@using Microsoft.AspNet.Identity
@model First_Aid_Made_Easy.Models.ChangePasswordViewModel

@{
    Layout = "~/Views/Shared/_LayoutStudent2026.cshtml";
    ViewBag.Title = "Change Password";
    var email = User.Identity.GetUserName();
}

<style>
    .profile-card {
        background: var(--fame-bg-card);
        border: 1px solid var(--fame-border);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .profile-hero {
        background: linear-gradient(135deg, var(--fame-primary) 0%, #134e4a 100%);
        padding: 2rem 1.5rem 3.5rem;
        text-align: center;
    }

    .profile-hero .shield-icon {
        width: 64px;
        height: 64px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }

    .profile-hero h3 { color: #fff; font-weight: 700; margin-bottom: 0.25rem; }
    .profile-hero p  { color: rgba(255,255,255,0.7); font-size: 0.85rem; margin: 0; }

    .profile-nav {
        display: flex;
        border-bottom: 1px solid var(--fame-border);
        margin-top: -1.5rem;
        background: var(--fame-bg-card);
        border-radius: 16px 16px 0 0;
        position: relative;
        z-index: 2;
        padding: 0 1rem;
    }

    .profile-nav a {
        flex: 1;
        text-align: center;
        padding: 1rem 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--fame-text-muted);
        text-decoration: none;
        border-bottom: 3px solid transparent;
        transition: all 0.2s ease;
    }

    .profile-nav a.active {
        color: var(--fame-primary);
        border-bottom-color: var(--fame-primary);
    }

    .profile-nav a:hover { color: var(--fame-primary); }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--fame-text-main);
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--fame-border);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title svg {
        width: 20px;
        height: 20px;
        color: var(--fame-primary);
    }

    .form-label-fame {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--fame-text-secondary);
        margin-bottom: 0.4rem;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .form-control-fame {
        background: #f8fafc !important;
        border: 1px solid var(--fame-border) !important;
        color: var(--fame-text-main) !important;
        border-radius: 10px !important;
        padding: 0.7rem 1rem !important;
        font-size: 0.9rem !important;
        transition: all 0.2s ease !important;
        width: 100%;
    }

    .form-control-fame:focus {
        border-color: var(--fame-primary) !important;
        background: #fff !important;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1) !important;
    }

    .password-group {
        position: relative;
    }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--fame-text-muted);
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
    }

    .password-toggle:hover { color: var(--fame-primary); }

    .btn-fame-save {
        background: var(--fame-primary);
        color: #fff;
        font-weight: 600;
        padding: 0.75rem 2.5rem;
        border-radius: 10px;
        border: none;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(15, 118, 110, 0.3);
    }

    .btn-fame-save:hover {
        background: #0d6b64;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(15, 118, 110, 0.35);
    }

    .password-rules {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-top: 0.5rem;
    }

    .password-rules h6 {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--fame-text-main);
        margin-bottom: 0.5rem;
    }

    .password-rules ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .password-rules li {
        font-size: 0.78rem;
        color: var(--fame-text-secondary);
        padding: 0.2rem 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .password-rules li svg {
        width: 14px;
        height: 14px;
        color: #16a34a;
        flex-shrink: 0;
    }

    .profile-alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: #dc2626;
        font-size: 0.85rem;
        font-weight: 500;
    }

    @@media (max-width: 767px) {
        .profile-hero { padding: 1.5rem 1rem 3rem; }
        .profile-nav a { font-size: 0.8rem; padding: 0.85rem 0.25rem; }
        .form-section { padding: 1.25rem !important; }
    }
</style>

<div class="profile-card mb-4">
    <!-- Hero -->
    <div class="profile-hero">
        <div class="shield-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>
        <h3>Security Settings</h3>
        <p>Keep your account safe with a strong password</p>
    </div>

    <!-- Tabs -->
    <div class="profile-nav">
        <a href="/Profile/MyProfile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Settings
        </a>
        <a href="/Manage/ChangePassword" class="active">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Password
        </a>
    </div>
</div>

<!-- Password Form -->
<div class="profile-card mb-4">
    <div class="form-section p-4 p-md-5">
        <div class="section-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Change Password
        </div>

        @Html.ValidationSummary("", new { @class = "profile-alert mb-4" })

        @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-4 mb-4">
                <div class="col-12">
                    <label class="form-label-fame">Current Password *</label>
                    <div class="password-group">
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control form-control-fame", @placeholder = "Enter your current password", @id = "oldPwd" })
                        <button type="button" class="password-toggle" onclick="togglePwd('oldPwd', this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">New Password *</label>
                    <div class="password-group">
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control form-control-fame", @placeholder = "Enter new password", @id = "newPwd" })
                        <button type="button" class="password-toggle" onclick="togglePwd('newPwd', this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Confirm New Password *</label>
                    <div class="password-group">
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control form-control-fame", @placeholder = "Re-enter new password", @id = "confirmPwd" })
                        <button type="button" class="password-toggle" onclick="togglePwd('confirmPwd', this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1" })
                </div>
            </div>

            <div class="password-rules mb-4">
                <h6>Password Requirements</h6>
                <ul>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        Minimum 6 characters
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        Include at least one number or special character
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        New password must differ from current password
                    </li>
                </ul>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn-fame-save">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-3px;margin-right:6px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Update Password
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @if (ViewBag.Change == true)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Password Changed!',
                text: 'Your password has been updated successfully.',
                confirmButtonColor: '#0F766E'
            })
        </script>
    }
    <script>
        function togglePwd(fieldId, btn) {
            var field = document.getElementById(fieldId);
            if (field.type === 'password') {
                field.type = 'text';
                btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
            } else {
                field.type = 'password';
                btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
            }
        }
    </script>
}
