@model First_Aid_Made_Easy.Models.SendCodeViewModel
@{ 
    ViewBag.Title = "Send";
    Layout = "";
    var providers = Model.Providers.Where(x => !x.Text.ToLower().Contains("sms") && !x.Text.ToLower().Contains("phone")).ToList();
}

<h2>@ViewBag.Title.</h2>

@using (Html.BeginForm("SendCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" })) {
    @Html.AntiForgeryToken()
    @Html.Hidden("rememberMe", @Model.RememberMe)
    <h4>Send verification code</h4>
    <hr />
    <div class="row">
        <div class="col-md-8">
            Select Verification Provider:
            @Html.DropDownListFor(model => model.SelectedProvider, providers)
            <input type="submit" value="Submit" class="btn btn-default" />
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
