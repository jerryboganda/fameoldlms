					<!--begin::Body-->
					@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form w-100 registerForm", role = "form", @enctype = "multipart/form-data", @autocomplete = "off" }))
					{
						<input type="hidden" />
						@*@Html.AntiForgeryToken()*@
						@Html.ValidationSummary("", new { @class = "text-danger" })
						@Html.Hidden("Type", (int)ViewBag.UserType)
						@Html.Hidden("Payment", "OneTime")
						@Html.Hidden("EmailConfirmed", Ext_loginInfo != null)
						<div id="divLoginInfo" class="py-10 field-tab">
							<div class="text-start mb-10">
								<h1 class="text-dark mb-3 fs-3x" data-kt-translate="sign-up-title">Create an Account</h1>
								<div class="text-gray-400 fw-semibold fs-6" data-kt-translate="general-desc">User Information</div>
								@if (Ext_loginInfo != null)
								{
									<p class="text-primary"> You've successfully authenticated with <strong>@Ext_loginInfo.Login.LoginProvider</strong></p>
								}
							</div>
							@if (Ext_loginInfo == null)
							{
								<div class="fv-row mb-10">
									<label>Full Name</label>
									@Html.TextBoxFor(m => m.User_Name, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Enter Your Full Name", @maxlength = "100" })
									<div id="User_NameVal" class="text-danger hidden"></div>
								</div>
								<div class="fv-row mb-10">
									<label>Email</label>
									@Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Your email address ..." })
									@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
									<div id="EamilVal" class="text-danger"></div>
								</div>
							}
							else
							{
								<div class="fv-row mb-10">
									<label>Full Name</label>
									@Html.TextBox("User_Name", Ext_loginInfo.ExternalIdentity.Name, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Enter Your Full Name", @maxlength = "100", @readonly = true })
									<div id="User_NameVal" class="text-danger hidden"></div>
								</div>
								<div class="fv-row mb-10">
									<label>Email</label>
									@Html.TextBox("Email", Ext_loginInfo.Email, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Your email address ...", @readonly = true })
									@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
									<div id="EamilVal" class="text-danger" style="display:none"></div>
								</div>

							}

							<div class="d-flex flex-stack">
								<button id="btnNextLogin" type="button" class="btn btn-primary">Next</button>
							</div>
						</div>


						<div id="divcodeVerify" class="py-10 field-tab">
							<div class="text-start mb-10">
								<h1 class="text-dark mb-3 fs-3x" data-kt-translate="sign-up-title">Create an Account</h1>
								<div class="text-gray-400 fw-semibold fs-6" data-kt-translate="general-desc">Code Verification</div>
							</div>
							<!--begin::Form-->
							<!--begin::Icon-->
							<div class="text-center mb-10">
								<img alt="Logo" class="theme-light-show mh-125px" src="~/Content/assetsn/media/svg/misc/smartphone-2.svg" />
								<img alt="Logo" class="theme-dark-show mh-125px" src="~/Content/assetsn/media/svg/misc/smartphone-2-dark.svg" />
							</div>
							<!--end::Icon-->
							<!--begin::Heading-->
							<div class="text-center mb-10">
								<!--begin::Title-->
								<h1 class="text-dark mb-3" data-kt-translate="two-step-title">Code Verification</h1>
								<!--end::Title-->
								<!--begin::Sub-title-->
								<div class="text-muted fw-semibold fs-5 mb-5" data-kt-translate="two-step-deck">
									Enter the 6 digit verification code.<br />
									We sent to your Email  "<b id="EmailAddress"></b>". <br />
									<a onclick="return MoveBack(this)" href="javscript:;">Change Email</a>
								</div>
								<!--end::Sub-title--><br />
							</div>
							<!--end::Heading-->
							<!--begin::Section-->
							<div class="mb-10">
								<!--begin::Label-->
								<div class="fw-bold text-start text-dark fs-6 mb-1 ms-1" data-kt-translate="two-step-label">Type your 6 digit security code</div>
								<!--end::Label-->
								<!--begin::Input group-->
								<div class="d-flex flex-wrap flex-stack">

									<input type="hidden" value="" name="Code" id="Code" />

									<input type="text" id="code_1" data-inputmask="'mask': '9', 'placeholder': ''" maxlength="1" class="form-control form-control-solid h-40px w-40px fs-2qx p-2 text-center code6d border-primary " value="" />
									<input type="text" id="code_2" data-inputmask="'mask': '9', 'placeholder': ''" maxlength="1" class="form-control form-control-solid h-40px w-40px fs-2qx p-2 text-center code6d border-primary " value="" />
									<input type="text" id="code_3" data-inputmask="'mask': '9', 'placeholder': ''" maxlength="1" class="form-control form-control-solid h-40px w-40px fs-2qx p-2 text-center code6d border-primary " value="" />
									<input type="text" id="code_4" data-inputmask="'mask': '9', 'placeholder': ''" maxlength="1" class="form-control form-control-solid h-40px w-40px fs-2qx p-2 text-center code6d border-primary " value="" />
									<input type="text" id="code_5" data-inputmask="'mask': '9', 'placeholder': ''" maxlength="1" class="form-control form-control-solid h-40px w-40px fs-2qx p-2 text-center code6d border-primary " value="" />
									<input type="text" id="code_6" data-inputmask="'mask': '9', 'placeholder': ''" maxlength="1" class="form-control form-control-solid h-40px w-40px fs-2qx p-2 text-center code6d border-primary " value="" />
								</div>
								<div id="CodeVal" class="text-danger"></div>
								<!--begin::Input group-->
							</div>
							<!--end::Section-->
							<!--begin::Actions-->
							<div class="text-center">
								<button id="btnVerify" type="button" class="btn btn-primary">Verfiy Code</button>
								<br /><br /><a style="color:blue" class="text-underline" id="btnSendAgain" href="javascript:;">Didn't get Email? Send Again</a>
								<p class=" mt-4" id="Note"><b>Note:</b> Your Verfication code will expire after <span class="text-danger" id="counter"></span> </p>
							</div>
							<!--end::Actions-->
							<!--end::Form-->

						</div>

						<div id="divJobInfo" class="py-10 field-tab">
							<div class="text-start mb-10">
								<h1 class="text-dark mb-3 fs-3x" data-kt-translate="sign-up-title">Create an Account</h1>
								<div class="text-gray-400 fw-semibold fs-6" data-kt-translate="general-desc">User Information</div>
								@Html.Partial("_ValidInfo")
							</div>
							<div class="fv-row mb-10">
								<label>Country</label>


								@Html.DropDownListFor(item => item.CountryID, new SelectList(First_Aid_Made_Easy.BLL.Common.Country, "Code", "Name"), "Select Country", new
								{
							   @aria_label = "Select Country",
									@data_control = "select2",
									@data_placeholder = "Select Country...",
							   @class = "form-select form-select-solid form-select-lg fw-semibold"
								})

								<div id="CountryIDVal" class="text-danger hidden"></div>
							</div>

							<div class="fv-row mb-10">
								<label>Mobile Number</label>
								@Html.TextBoxFor(m => m.User_Mobile, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Enter Your Mobile No. Without 0 " })
								<div id="User_MobileVal" class="text-danger hidden"></div>
							</div>

							<div class="fv-row mb-10">
								<label>13 Digit CNIC</label>
								@Html.TextBoxFor(m => m.CNIC, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Enter Your 13 digit cnic no without '-' " })
								<div id="CNICVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								<label>Father Name</label>
								@Html.TextBoxFor(m => m.User_FatherName, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Your Father's Name", @maxlength = "200" })
								<div id="User_FatherNameVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								<label> Sponser Name(if Sponser in other than Father) </label>
								@Html.TextBoxFor(m => m.SponserProfession, new { @class = "form-control form-control-lg ", @placeholder = "..." })
								<div id="SponserProfessionVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								<label>Father/Sponser Profession</label>
								@Html.TextBoxFor(m => m.FatherProfession, new { @class = "form-control form-control-lg ", @placeholder = "..." })
								<div id="FatherProfessionVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								@Html.TextBoxFor(m => m.JobLocation, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Location of Your Job/University" })
								<div id="JobLocationVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								@Html.TextBoxFor(m => m.City, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "City Name Here " })
								<div id="CityVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								@Html.TextBoxFor(m => m.YearOfMBBS, new { @class = "form-control form-control-lg form-control-solid", @placeholder = "Year Of Graduation " })
								<div id="YearOfMBBSVal" class="text-danger hidden"></div>
							</div>
							<div class="fv-row mb-10">
								@if ((int)ViewBag.UserType == 6)
								{
									@Html.TextBox("Institute", "JALALABAD UNIVERSITY", new { @class = "form-control form-control-lg form-control-solid", @readonly = true })
								}
								else if ((int)ViewBag.UserType != 4 && (int)ViewBag.UserType != 9)
								{
									@Html.TextBox("Institute", "ASIAN MEDICAL INSTISTUTE", new { @class = "form-control form-control-lg form-control-solid", @readonly = true })
								}
								else
								{
									@Html.TextBox("Institute", "", new { @class = "form-control", @placeholder = "Institute" })
								}
								<div id="InstituteVal" class="text-danger hidden"></div>
							</div>
							<div class="d-flex flex-stack">
								<button onclick="return MoveBack(this)" type="button" class="btn btn-primary">Back</button>
								<button id="btnNextJob" type="button" class="btn btn-primary">Next</button>
							</div>
						</div>

						<div id="divPic" class="py-10 field-tab">
							<div class="text-start mb-10">
								<h1 class="text-dark mb-3 fs-3x" data-kt-translate="sign-up-title">Create an Account</h1>
								<div class="text-gray-400 fw-semibold fs-6" data-kt-translate="general-desc">User Information</div>
								@Html.Partial("_ValidInfo")
							</div>
							<div class="fv-row mb-10">
								<label class="text-label">CNIC Front Side </label>
								@Html.TextBoxFor(m => m.CNICFrontFile, new { @class = "form-control form-control-lg form-control-solid", @type = "file", @accept = "image/png, image/jpg, image/jpeg" })
								<div id="CNICFrontFileVal" class="text-danger hidden"></div>
								<img style="width:200px;height:120px;display:none" alt="" src="" />
							</div>
							<div class="fv-row mb-10">
								<label class="text-label">CNIC Back Side </label>
								@Html.TextBoxFor(m => m.CNICBackFile, new { @class = "form-control form-control-lg form-control-solid", @type = "file", @accept = "image/png, image/jpg, image/jpeg" })
								<div id="CNICBackFileVal" class="text-danger hidden"></div>
								<img style="width:200px;height:120px;display:none" alt="" src="" />
							</div>
							<div class="fv-row mb-10">
								<label class="text-label">Student Card Front Side </label>
								@Html.TextBoxFor(m => m.StuCardFrontFile, new { @class = "form-control form-control-lg form-control-solid", @type = "file", @accept = "image/png, image/jpg, image/jpeg" })
								<div id="StuCardFrontFileVal" class="text-danger hidden"></div>
								<img style="width:200px;height:120px;display:none" alt="" src="" />
							</div>
							<div class="fv-row mb-10">
								<label class="text-label">Student Card Back Side </label>
								@Html.TextBoxFor(m => m.StuCardBackFile, new { @class = "form-control form-control-lg form-control-solid", @type = "file", @accept = "image/png, image/jpg, image/jpeg" })
								<div id="StuCardBackFileVal" class="text-danger hidden"></div>
								<img style="width:200px;height:120px;display:none" alt="" src="" />
							</div>
							<div class="fv-row mb-10">
								<label class="text-label">Student Profile Pic </label>
