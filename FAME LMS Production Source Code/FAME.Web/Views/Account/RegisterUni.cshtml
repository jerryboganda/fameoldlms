	<script>
        var regex = /^\w+([\.-]?\w+)*@("@")\w+([\.-]?\w+)*(\.\w{2,3})+$/;
        $(document).ready(function () {
            //$('.select2').select2();
            $(".field-tab").hide();
            $("#divLoginInfo").show();
        })
        $("input[type=file]").change(function (e) {
            var file = e.target.files[0];
            var src = URL.createObjectURL(file);
            $(this).closest(".fv-row").find("img").attr("src", src).show();
        })


        function MoveNext(This) {
            var a = $(This).closest(".field-tab");
            a.hide();
            a.next().show();
        }
        function MoveBack(This) {
            var a = $(This).closest(".field-tab");
            a.hide();
            a.prev().show();
        }

        $("#btnNextLogin").click(async function () { if (LoginInfoValid() && await SendEmail()) { MoveNext(this) } })
        $("#btnVerify").click(async function () { if (await CodeValid()) { MoveNext(this) } })
        $("#btnNextJob").click(function () { if (JobInfoValid()) { MoveNext(this) } })
        $("#btnNextPic").click(function () { if (PicValid()) { MoveNext(this); $("#btnNextEnroll").click() } })
        $("#btnNextEnroll").click(function () { if (EnrollValid()) { MoveNext(this) } })
        $("#btnSave").click(function () {
            if (PageValidation()) {
                Swal.fire({
                    title: 'Are you Agree?',
                    html: ` - No Video Downloading Allowed <br/>
                            - No Screen Recording Allowed <br/>
                            - No Login Sharing Allowed <br/>
                            - If anyone involves in these activities, strict legal action will be taken against him and account will be blocked permanently. <br/>
                            - If Installment not paid on time, then account will be suspended.<br/>
							- Fee in not refundable and subscription can not be seezed.<br/>
                            - Do you agree to all Rules and Regulations of Platform ?`,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Yes,I Agree!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $(".Loader").show();
                        $(".registerForm").submit();
                    }
                })
            }
        })

        function LoginInfoValid() {
            $("input").removeClass("Invalid");
            var Email = $("#Email").val();

            $(".form-group").removeClass("InvalidSelect");
            $(".hidden").hide();
            if ( $("#User_Name").val() == "" || $("#EamilVal").is(":visible")) {

                if ($("#User_Name").val() == "")
                    $("#User_NameVal").show().text("Name Required");
                return false;
            }
            else
                return true;
        }

        function JobInfoValid() {
            $("input").removeClass("Invalid");
            $(".form-group").removeClass("InvalidSelect");
            $(".hidden").hide();
			if ($("#User_Mobile").val() == "" || $("#CNIC").val().length != 13 || $("#CNIC").val() == "" || $("#CountryID").val() == "" || $("#OccupationID").val() == "" ||
				$("#User_FatherName").val() == "" || $("#FatherProfession").val() == "" || $("#Institute").val() == "" ||
				$("#City").val() == "" || $("#JobLocation").val() == "") {
                if ($("#OccupationID").val() == "") $("#OccupationIDVal").show().text("Designation Required");
				if ($("#User_FatherName").val() == "") $("#User_FatherNameVal").show().text("Required");
				if ($("#FatherProfession").val() == "") $("#FatherProfessionVal").show().text("Required");
                if ($("#Institute").val() == "") $("#InstituteVal").show().text("Required");
                if ($("#City").val() == "") $("#CityVal").show().text("Required");
                if ($("#JobLocation").val() == "") $("#JobLocationVal").show().text("Required");
                if ($("#CountryID option:selected").val() == "") $("#CountryIDVal").show().text("Country Required");
                if ($("#User_Mobile").val() == "") $("#User_MobileVal").show().text("Mobile Required");
                if ($("#CNIC").val().length != 13) $("#CNICVal").show().text("CNIC must be 13 digit long");
                if ($("#CNIC").val() ==  "") $("#CNICVal").show().text("CNIC is Required ");
                return false;
            }
            else
                return true;
        }
        function EnrollValid() {
            $("input").removeClass("Invalid");
            $(".form-group").removeClass("InvalidSelect");
            $(".hidden").hide();
			if (!$("#Duration").val() > 0) {
				$("#DurationVal").show().text("Duration Required");
				return false;
			}
			if (!$("#PackageID").val() > 0) {
				$("#PackageIDVal").show().text("Package Required");
				return false;
			}
            else
                return true;
        }
        function PageValidation() {
            $("input").removeClass("Invalid");
            $(".form-group").removeClass("InvalidSelect");
            $(".hidden").hide();
            if ($("#Password").val() == "" || $("#Password").val() != $("#ConfirmPassword").val()) {
                if ($("#Password").val() == "") {
                    $("#Password").focus();
                    $("#PasswordVal").show().text("Password Required");
                }
                if ($("#Password").val() != $("#ConfirmPassword").val()) {
                    $("#ConfirmPassword").focus();
                    $("#ConfirmPasswordVal").show().text("Password Do Not Match");
                }
                return false;
            }
            else
                return true;
        }
        function PicValid() {
            $("input").removeClass("Invalid");
            $(".form-group").removeClass("InvalidSelect");
            $(".hidden").hide();
            if ($("input[name=CNICBackFile]").get(0).files.length == 0 ||
                $("input[name=StuCardFrontFile]").get(0).files.length == 0 ||
                $("input[name=StuCardBackFile]").get(0).files.length == 0 ||
				$("input[name=User_PicFile]").get(0).files.length == 0 ||
                $("input[name=CNICFrontFile]").get(0).files.length == 0) {
                if ($("#CNICFrontFile").get(0).files.length == 0)
                    $("#CNICFrontFileVal").show().text("CNIC Pic Required");
                if ($("#CNICBackFile").get(0).files.length == 0)
                    $("#CNICBackFileVal").show().text("CNIC Pic Required");
                if ($("#StuCardBackFile").get(0).files.length == 0)
                    $("#StuCardBackFileVal").show().text("Student Card Pic Required");
                if ($("#StuCardFrontFile").get(0).files.length == 0)
                    $("#StuCardFrontFileVal").show().text("Student Card Pic Required");
				if ($("#User_PicFile").get(0).files.length == 0)
					$("#User_PicFileVal").show().text("Profile Pic Required");
                return false;
            }
            else
                return true;
        }

     var Installments = null;

    function Tutorial() {
        Swal.fire({
            title: '<strong>Registration Toturial</strong>',
            html: `<iframe style="width:100% ; height:auto"
                                src="https://www.youtube.com/embed/fBu2SITPXmw">
                </iframe>`,
        })
    }
    function ShowInstallments() {
        var html = `<label><b>GAP Duration --- Amount</b></label><br />`;
        $.each(Installments.List, function (i, val) {
            html = html + `<label>${val.DurationS}</label><br />`
        })
        Swal.fire({
            title: '<strong>Insallment Details</strong>',
            html: html,
        })
    }
    //========================================
    //========= VAlidations ==================
    //========================================
        $(document).on("keyup", "#Email", function () {
            $("#EamilVal").hide();

        })
        $(document).on("focusout", "#Email", function () {
            var email = $(this).val().trim();
            $("#EmailAddress").text(email);
            if (regex.test(email)) {
                $.ajax({
                    url: "/Enrollment/GetStudentID?email=" + email,
                    method: "GET",
                    async: false,
                    success: function (result) {
                        if ((result == "" || result == null)) {
                            $("#EamilVal").hide();
                        } else {
                            $("#EamilVal").text("Email Already Exist").show();
                        }
                    },
                    error: function (err) {
                        //var win = window.open("");
                        //win.document.write(err.responseText);
                        //$("#EamilVal").text("Email Is Not Valid").show();
                    }
                })
            }
            else { $("#EamilVal").text("Email Not valid").show() }

        })

        $(".toggle-password").click(function () {

            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });

        $("#CountryID").change(function () {
            var code = $(this).val();
            $("#Code").html(code);
            if (code == "92")
                $("#User_Mobile").attr("maxlength", "13");
            $("#User_Mobile").val(code)
        })


        $("#YearOfMBBS").focusout(function (event) {
            var year = $(this).val();
            if (parseInt(year) > 2027 || parseInt(year) < 1980) {
                $(this).val("");
            }
        })
        $("#User_Mobile").focusout(function (event) {
            $("#MobileVal").hide();
            var mobile = $(this).val();
            if (mobile.length < 13) {
                $("#MobileVal").html("Mobile No Must Contain 13 Digits").show();
            }
        })
        $(".Name").keypress(function (event) {
            return /[a-z]/i.test(event.key);
        })
        $(document).on("keypress", "#User_Mobile , #YearOfMBBS , #CNIC", (function (event) {
            return /[0-9]/i.test(event.key);
        }))
        $(document).on("keyup", "#User_Mobile", (function (event) {
            var mobile = $(this).val();
            //var maxl = $(this).maxlength();
        }))
    //===================================
    //===== PAckage ANd Durations =======
    //===================================
        $(document).on("change", "#PackageID", function () {
            var PackID = $(this).val();
            LoadDurations(PackID);
        })

        function LoadDurations(PackID) {

            $.ajax({
                url: "/Package/LoadDuration/" + PackID,
                type: "GET",
                success: function (result) {
                    var option = '<option selected disabled value="">Please Select</option>';
                    $.each(result, function (i, val) {
                        option = option + `<option data-id="${val.ID}" value="${val.Value}">${val.Text}</option>`;
                    })
                    $("#Duration").html(option);
                    if (parseInt('@(Model?.Duration??0)') > 0) {
                        $("#Duration").val("@(Model?.Duration??0)").change();
                    }
                },
                error: function (err) {
                    Swal.fire({
                        position: 'top-end',
                        icon: 'error',
                        title: err,
                        showConfirmButton: false,
                        timer: 1500
                    })
                }
            })
        }

        $(document).on("change", "#Duration", function () {
            var DurID = $(this).find(':selected').data('id');
            CheckInstallments(DurID);
        })

        function CheckInstallments(DurID) {

            $.ajax({
                url: "/Package/CheckInstallments/" + DurID,
                type: "GET",
                success: function (result) {
                    if (result.List.length != 0) {
                        Installments = result;
                        $("#Payment").show();
                    } else {
                        $("#Payment").hide();
                    }
                },
                error: function (err) {
                    Swal.fire({
                        position: 'top-end',
                        icon: 'error',
                        title: err,
                        showConfirmButton: false,
                        timer: 1500
                    })
                }
            })
        }
	</script>
