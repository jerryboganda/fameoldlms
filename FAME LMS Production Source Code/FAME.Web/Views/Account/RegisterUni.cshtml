	<script>


		$(document).on("keyup", ".code6d", function () { if ($(this).val().length > 0) $(this).next().focus() })
		$(document).on("click", "#btnSendAgain", async function () {
			await SendEmail();
		})
		async function CodeValid() {
			var d = await ConfirmEmail();
			if (!d.success) {
				$("#CodeVal").text(d.message).show();
			}
			return d.success;
		}

		async function ConfirmEmail() {
			var res;
			Swal.fire({
				html: '<h5>Verifying Code...</h5>',
				showConfirmButton: false,
				onRender: function () { $('.swal2-content').prepend(sweet_loader); }
			});
			var res = await Confirm();
			Swal.close();
			date.setTime(new Date().getTime() + (30 * 60000));
			countDownDate = date.getTime();
			return res;
		}
		async function Confirm() {
			var Code = $("#code_1").val() + $("#code_2").val() + $("#code_3").val() + $("#code_4").val() + $("#code_5").val() + $("#code_6").val();
			var email = $("#Email").val();
			return $.ajax({
				url: "/Auth/ConfirmNewEmail",
				data: {
					Email: email,
					Code: Code,
				},
				method: "GET",
			})
		}


		async function SendEmail() {
			var res = false;
			Swal.fire({
				html: '<h5>Sending Verification Code...</h5>',
				showConfirmButton: false,
				onRender: function () { $('.swal2-content').prepend(sweet_loader); }
			});
			var res = await Send();
			Swal.close();
			return res.success;
		}
		async function Send() {
			return $.ajax({
				url: "/Auth/SendEmailNewUser",
				data: {
					Email: $("#Email").val(),
				},
				method: "POST",
			})
		}
	</script>


	<script>
		var date = new Date();
		date.setTime(new Date().getTime() + (30 * 60000));
		var countDownDate = date.getTime();
		var x = setInterval(function () {
			var now = new Date().getTime();
			var distance = countDownDate - now;
			var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
			var seconds = Math.floor((distance % (1000 * 60)) / 1000);
			$("#counter").text(minutes + "m " + seconds + "s ");
			//if (distance < 28 * 60000)
			//    $("#btnSendAgain").show();
			if (distance < 0) {
				clearInterval(x);
				$("#Note").html("EXPIRED");
			}
			console.log();
		}, 1000);
	</script>

