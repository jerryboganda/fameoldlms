@using First_Aid_Made_Easy.Models
@model LoginViewModel
@{
    Layout = "";
    ViewBag.Title = "Log in";
    TimeSpan start = new TimeSpan(8, 0, 0); //10 o'clock
    TimeSpan end = new TimeSpan(18, 0, 0); //12 o'clock
    TimeSpan now = DateTime.UtcNow.AddHours(5).TimeOfDay;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Login</title>

    <!-- Prevent the demo from appearing in search engines -->
    <meta name="robots" content="noindex">

    <link href="https://fonts.googleapis.com/css?family=Lato:400,700%7CRoboto:400,500%7CExo+2:600&display=swap" rel="stylesheet">

    <!-- Perfect Scrollbar -->
    <link type="text/css" href="~/Content/assets/vendor/perfect-scrollbar.css" rel="stylesheet">

    <!-- Fix Footer CSS -->
    <link type="text/css" href="~/Content/assets/vendor/fix-footer.css" rel="stylesheet">

    <!-- Material Design Icons -->
    <link type="text/css" href="~/Content/assets/css/material-icons.css" rel="stylesheet">


    <!-- Font Awesome Icons -->
    <link type="text/css" href="~/Content/assets/css/fontawesome.css" rel="stylesheet">


    <!-- Preloader -->
    <link type="text/css" href="~/Content/assets/css/preloader.css" rel="stylesheet">


    <!-- App CSS -->
    <link type="text/css" href="~/Content/assets/css/app.css" rel="stylesheet">


    <style>
        .field-icon {
            /*float: right;
            margin-left: -25px;
            margin-top: -25px;
            position: relative;
            z-index: 2;*/
            margin-top: 15px;
        }
    </style>
    @Html.Partial("_TrackingPixels")
</head>

@if ((now > start) && (now < end) || true)
{
    <body class="layout-default layout-login-centered-boxed">

        <div class="layout-login-centered-boxed__form card">
            <div class="d-flex flex-column justify-content-center align-items-center mt-2 mb-5 navbar-light">
                <div>
                    <img style="width: 70px;display:inline-block;margin-left:2rem" src="~/Images/AMIlogo.jfif" alt="logo" />
                    <img style="width: 70px; display: inline-block; margin-left: 2rem" src="~/Images/FIRST AID LOGO.png" alt="logo" />
                </div>
                <h4 class="m-0 text-center">
                    Online E-Library collaboration between <br /> <b>ASIAN MEDICAL INSTITUTE</b> <br /> & <b>FIRST AID MADE EASY PLATFORM</b>
                </h4>
            </div>
            @if (TempData["ID"] != null)
            {
                var mail = TempData["Mail"];
                var ID = TempData["ID"];
                <div class="alert alert-soft-success d-flex" role="alert">
                    <i class="material-icons mr-12pt">check_circle</i>
                    <div class="text-body">An email has been sent to your email address, Please Check Your Email To Verify.</div>
                </div>
                <a href="@Url.Action("VerifyEmail", "Account", new { ID })" class="btn btn-light">Click Here To Get Email Again</a>
            }
            <section id="loginForm">
                @using (Html.BeginForm("LoginUni", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    @*@Html.AntiForgeryToken()*@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => x.UniqueID)
                    <div class="form-group">
                        <label class="text-label" for="email_2">Email Address:</label>
                        <div class="input-group input-group-merge">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control form-control-prepended", @placeholder = "Enter Your Email" })
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <span class="far fa-envelope"></span>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="text-label" for="password_2">Password:</label>
                        <div class="input-group input-group-merge">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-prepended", @placeholder = "Enter Your Password" })
                            <span toggle="#Password" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <span class="fa fa-key"></span>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <button class="btn btn-block btn-primary" type="submit">Login</button>
                    </div>
                    <div class="form-group text-center">
                        <div class="custom-control custom-checkbox">
                            <div class="checkbox">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "custom-control-input" })
                                @Html.LabelFor(m => m.RememberMe, new { @class = "custom-control-label" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group text-center">
                        <p>
                            @Html.ActionLink("Forgot your password?", "ForgotPassword")
                        </p>
                        @if (ViewBag.IsUni == false)
                        {
                            <span>Don't have an account?  @Html.ActionLink("Sign up!", "Register", new { @class = "text-body text-underline" })</span>
                        }
                        else
                        {
                            <span>Don't have an account?  @Html.ActionLink("Sign up!", "RegisterUni", new { @class = "text-body text-underline" })</span>
                        }
                    </div>
                    // Enable this once you have account confirmation enabled for password reset functionality

                }
            </section>
        </div>
        <!-- jQuery -->
        <script src="~/Content/assets/vendor/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/biri/dist/biri.min.js"></script>
        <!-- Bootstrap -->
        <script src="~/Content/assets/vendor/popper.min.js"></script>
        <script src="~/Content/assets/vendor/bootstrap.min.js"></script>

        <!-- Perfect Scrollbar -->
        <script src="~/Content/assets/vendor/perfect-scrollbar.min.js"></script>

        <!-- DOM Factory -->
        <script src="~/Content/assets/vendor/dom-factory.js"></script>

        <!-- MDK -->
        <script src="~/Content/assets/vendor/material-design-kit.js"></script>

        <!-- Fix Footer -->
        <script src="~/Content/assets/vendor/fix-footer.js"></script>

        <!-- App JS -->
        <script src="~/Content/assets/js/app.js"></script>

        <script>
            $(document).ready(function () {
                $("#UniqueID").val(localStorage.getItem("AmiID"));
            })
        </script>

        <script>

            $(".toggle-password").click(function () {

                $(this).toggleClass("fa-eye fa-eye-slash");
                var input = $($(this).attr("toggle"));
                if (input.attr("type") == "password") {
                    input.attr("type", "text");
                } else {
                    input.attr("type", "password");
                }
            });
        </script>
    </body>
}
else
{
    <body class="layout-default layout-login-centered-boxed">
        <div class="layout-login-centered-boxed__form card">

            <div class="d-flex flex-column justify-content-center align-items-center mt-2 mb-5 navbar-light">
                <div>
                    <img style="width: 70px;display:inline-block;margin-left:2rem" src="~/Images/AMIlogo.jfif" alt="logo" />
                    <img style="width: 70px; display: inline-block; margin-left: 2rem" src="~/Images/FIRST AID LOGO.png" alt="logo" />
                </div>
                <h4 class="m-0 text-center">
                    Online E-Library collaboration between <br /> <b>ASIAN MEDICAL INSTITUTE</b> <br /> & <b>FIRST AID MADE EASY PLATFORM</b>
                </h4>
            </div>

            <section id="loginForm" class="text-center">
                <h2>You can only login <br /> between 08:00 AM to 06:00 PM according to Pakistan State Timing PST.   </h2>
            </section>

        </div>
        <!-- Bootstrap -->
        <script src="~/Content/assets/vendor/popper.min.js"></script>
        <script src="~/Content/assets/vendor/bootstrap.min.js"></script>


    </body>
}

</html>

