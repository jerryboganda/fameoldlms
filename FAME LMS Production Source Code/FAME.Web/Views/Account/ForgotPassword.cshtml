@model First_Aid_Made_Easy.Models.ResetPasswordViewModel
@{
    Layout = "";
    ViewBag.Title = "Forgot Password";
}



<!DOCTYPE html>
<html lang="en">
<!--begin::Head-->
<head>


	<title>Forgot Password</title>
	<meta charset="utf-8" />
	<meta name="keywords" content="First Aid Made Easy, Medical," />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="shortcut icon" type="image/x-icon" href="~/Content/assets/images/fame-favicon.png">


	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(used by all pages)-->
	<link href="~/Content/assetsn/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="~/Content/assetsn/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Global Stylesheets Bundle-->
	@if (ViewBag.Reset == null)
	{
		<style>
			#divReset {
				display: none;
			}
		</style>
	}
	else
	{
		<style>
			#divEmail {
				display: none;
			}
		</style>
	}
	@Html.Partial("_TrackingPixels")
</head>
<!--end::Head-->
<!--begin::Body-->
<body data-kt-name="metronic" id="kt_body" class="app-blank">
    <!--begin::Theme mode setup on page load-->
    @Html.Partial("_ThemeScript")
    <!--end::Theme mode setup on page load-->
    <!--begin::Main-->
    <!--begin::Root-->
    <div class="d-flex flex-column flex-root">
        <!--begin::Authentication - Password reset -->
        <div class="d-flex flex-column flex-lg-row flex-column-fluid">
            <!--begin::Logo-->
            <a href="/Home/Index" class="d-block d-lg-none mx-auto py-20">
                <img alt="Logo" src="~/Areas/Landing/assets/images/logo/fame-logo.png" class="theme-light-show h-45px" />
                <img alt="Logo" src="~/Areas/Landing/assets/images/logo/fame-logo.png" class="theme-dark-show h-45px" />
            </a>
            <!--end::Logo-->
            <!--begin::Aside-->
            <div class="d-flex flex-column flex-column-fluid flex-center w-lg-50 p-10">
                <!--begin::Wrapper-->
                <div class="d-flex justify-content-between flex-column-fluid flex-column w-100 mw-450px">
                    <!--begin::Header-->
                    <div class="d-flex flex-stack py-2">
                        <!--begin::Back link-->
                        <div class="me-2">
                            <a href="/Account/Login" class="btn btn-icon bg-light rounded-circle">
                                <!--begin::Svg Icon | path: icons/duotune/arrows/arr002.svg-->
                                <span class="svg-icon svg-icon-2 svg-icon-gray-800">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M9.60001 11H21C21.6 11 22 11.4 22 12C22 12.6 21.6 13 21 13H9.60001V11Z" fill="currentColor" />
                                        <path opacity="0.3" d="M9.6 20V4L2.3 11.3C1.9 11.7 1.9 12.3 2.3 12.7L9.6 20Z" fill="currentColor" />
                                    </svg>
                                </span>
                                <!--end::Svg Icon-->
                            </a>
                        </div>
                        <!--end::Back link-->
                        <!--begin::Sign Up link-->
                        <div class="m-0">
                            <span class="text-gray-400 fw-bold fs-5 me-2" data-kt-translate="password-reset-head-desc">Already a member ?</span>
                            <a href="/Account/Login" class="link-primary fw-bold fs-5" data-kt-translate="password-reset-head-link">Sign In</a>
                        </div>
                        <!--end::Sign Up link=-->
                    </div>
                    <!--end::Header-->
                    <!--begin::Body-->
                    <form class="form w-100" novalidate="novalidate" id="kt_password_reset_form" onkeydown="return event.key != 'Enter';" method="post" autocomplete="off" action="/Account/ResetPassword">
                        <input type="hidden" id="Email" name="Email" value="@(Model?.Email)" />
                        <div id="divEmail" class="py-20">
                            <div class="text-start mb-10">
                                <!--begin::Title-->
                                <h1 class="text-dark mb-3 fs-3x" data-kt-translate="password-reset-title">Forgot Password ?</h1>
                                <!--end::Title-->
                                <!--begin::Text-->
                                <div class="text-gray-400 fw-semibold fs-6" data-kt-translate="password-reset-desc">Enter your email to reset your password.</div>
                                <br />
                                @Html.AntiForgeryToken()
                                <!--end::Link-->
                            </div>
                            <!--begin::Heading-->
                            <!--begin::Input group-->
                            <div class="fv-row mb-10">
                                <input class="form-control form-control-solid" type="email" value="@(Model?.Email)" placeholder="Email" id="EmailInput" autocomplete="off" data-kt-translate="password-reset-input-email" />
                                <div class="text-danger" id="EmailVal"></div>
                            </div>

                            @Html.HiddenFor(m => m.Type, new { Value = "Email" })
                            <div class="alert alert-light-primary d-flex align-items-start mb-8" role="alert">
                                <i class="bi bi-envelope-check fs-2 me-3 mt-1"></i>
                                <div>
                                    <strong>Email verification only.</strong><br />
                                    Password reset codes are sent to your email address. SMS verification is not available on this system.
                                </div>
                            </div>
                            <!--end::Input group-->
                            <!--begin::Actions-->
                            <div class="d-flex flex-stack">
                                <!--begin::Link-->
                                <div class="m-0">
                                    <button id="btnSendEmail" type="button" class="btn btn-primary me-2">Next</button>
                                    <a href="/Account/Login" class="btn btn-lg btn-light-primary fw-bold" data-kt-translate="password-reset-cancel">Cancel</a>
                                </div>
                                <!--end::Link-->
                            </div>
                        </div>

                        <div id="divVerification" class="py-20" style="display:none">
                            <!--begin::Form-->
                            <!--begin::Icon-->
                            <div class="text-center mb-10">
                                <img alt="Logo" class="theme-light-show mh-125px" src="~/Content/assetsn/media/svg/misc/smartphone-2.svg" />
                                <img alt="Logo" class="theme-dark-show mh-125px" src="~/Content/assetsn/media/svg/misc/smartphone-2-dark.svg" />
                            </div>
                            <!--end::Icon-->
                            <!--begin::Heading-->
                            <div class="text-center mb-10">
                                <!--begin::Title-->
                                <h1 class="text-dark mb-3" data-kt-translate="two-step-title">Code Verification</h1>
                                <!--end::Title-->
                                <!--begin::Sub-title-->
                                <div class="text-muted fw-semibold fs-5 mb-5" data-kt-translate="two-step-deck">Enter the verification code we sent to your Email</div>
                                <!--end::Sub-title--><br />
                            </div>
                            <!--end::Heading-->
                            <!--begin::Section-->
                            <div class="mb-10">
                                <!--begin::Label-->
                                <div class="fw-bold text-start text-dark fs-6 mb-1 ms-1" data-kt-translate="two-step-label">Type your 6 digit security code</div>
                                <!--end::Label-->
                                <!--begin::Input group-->
                                <div class="d-flex flex-wrap flex-stack">

                                    <input type="number" class="form-control border-primary" style="font-size: 20px; letter-spacing: 10px;" name="Code" id="Code" />

                                </div>
                                <div id="CodeVal" class="text-danger"></div>
                                <!--begin::Input group-->
                            </div>
                            <!--end::Section-->
                            <!--begin::Actions-->
                            <div class="text-center">
                                <button id="btnVerify" type="button" class="btn btn-primary">Verfiy Code</button>
                                <p class="text-danger mt-4" id="Note"><b>Note:</b> Your Verfication code will expire after <span id="counter"></span> </p>
                            </div>
                            <!--end::Actions-->
                            <!--end::Form-->
                        </div>

                        <div id="divReset" class="py-20">
                            <div class="text-start mb-10">
                                <!--begin::Title-->
                                <h1 class="text-dark mb-3 fs-3x" data-kt-translate="new-password-title">Setup New Password</h1>
                                <!--end::Title-->
                                <!--begin::Text-->
                                <div class="text-gray-400 fw-semibold fs-6" data-kt-translate="new-password-desc">Have you already reset the password ?</div>
                                <!--end::Link--><br />
                                @Html.ValidationSummary("", new { @class = "text-danger" })
                            </div>
                            <!--end::Heading-->
                            <!--begin::Input group-->
                            <div class="mb-10 fv-row" data-kt-password-meter="true">
                                <!--begin::Wrapper-->
                                <div class="mb-1">
                                    <!--begin::Input wrapper-->
                                    <div class="position-relative mb-3">
                                        <input class="form-control form-control-lg form-control-solid" type="password" placeholder="Password" name="Password" id="Password" autocomplete="off" data-kt-translate="new-password-input-password" />
                                        <span class="btn btn-sm btn-icon position-absolute translate-middle top-50 end-0 me-n2" data-kt-password-meter-control="visibility">
                                            <i class="bi bi-eye-slash fs-2"></i>
                                            <i class="bi bi-eye fs-2 d-none"></i>
                                        </span>
                                        <div id="PasswordVal" class="text-danger hidden"></div>
                                    </div>
                                    <!--end::Input wrapper-->
                                    <!--begin::Meter-->
                                    <div class="d-flex align-items-center mb-3" data-kt-password-meter-control="highlight">
                                        <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                        <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                        <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                        <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px"></div>
                                    </div>
                                    <!--end::Meter-->
                                </div>
                                <!--end::Wrapper-->
                                <!--begin::Hint-->
                                <div class="text-muted" data-kt-translate="new-password-hint">Use 8 or more characters with a mix of letters, numbers &amp; symbols.</div>
                                <!--end::Hint-->
                            </div>
                            <!--end::Input group=-->
                            <!--begin::Input group=-->
                            <div class="fv-row mb-10">
                                <input class="form-control form-control-lg form-control-solid" type="password" placeholder="Confirm Password" name="ConfirmPassword" id="ConfirmPassword" autocomplete="off" data-kt-translate="new-password-confirm-password" />
                            </div>
                            <!--end::Input group=-->
                            <!--begin::Actions-->
                            <div class="d-flex flex-stack">
                                <button id="btnSave" type="button" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </form>
                    <!--end::Body-->
                    <div class="m-0"> </div>

                </div>
                <!--end::Wrapper-->
            </div>
            <!--end::Aside-->
            <!--begin::Body-->
            <div class="d-none d-lg-flex flex-lg-row-fluid w-50 bgi-size-cover bgi-position-y-center bgi-position-x-start bgi-no-repeat" style="background-image: url(../../Areas/Landing/assets/images/logo/famelogoround.png)"></div>
            <!--begin::Body-->
        </div>
        <!--end::Authentication - Password reset-->
    </div>
    <!--end::Root-->
    <!--end::Main-->
    <!--begin::Javascript-->
    <script>var hostUrl = "~/Content/assetsn/";</script>
    <!-- jQuery -->
    <script src="~/Content/assets/vendor/jquery.min.js"></script>

    <!--begin::Global Javascript Bundle(used by all pages)-->
    <script src="~/Content/assetsn/plugins/global/plugins.bundle.js"></script>
    <script src="~/Content/assetsn/js/scripts.bundle.js"></script>
    <!--end::Global Javascript Bundle-->
    <!--begin::Custom Javascript(used by this page)-->
    <script src="~/Content/assetsn/js/custom/authentication/password-reset/password-reset.js"></script>
    <script src="~/Content/assetsn/js/custom/authentication/sign-in/i18n.js"></script>
    <!--end::Custom Javascript-->
    <!--end::Javascript-->

    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).on("click", "#btnSave", function () {
            $("#kt_password_reset_form").submit();
        })
        $(document).on("click", "#btnSendEmail", function () {
            $("#Email").val($("#EmailInput").val())
            $.ajax({
                url: "/Auth/ForgotPassword",
                data: {
                    Email: $("#Email").val(),
                    Type: $("input[name=Type]:checked").val()
                },
                method: "POST",
                beforeSend: function () {
                    swal.fire({
                        html: '<h5>Sending Verification Code...</h5>',
                        showConfirmButton: false,
                        onRender: function () { $('.swal2-content').prepend(sweet_loader); }
                    });
                },
                success: function (result) {
                    if (result.success) {
                        $("#divEmail").hide();
                        $("#divVerification").show();
                        Start();
                    } else {
                        $("#EmailVal").text(result.message);
                    }
                    swal.close()
                }, error: function (err) {
                    alert("Error" + err);
                    swal.close()
                }
            })


        })

        $(document).on("click", "#btnVerify", function () {
			var Code = $("#Code").val();
            $.ajax({
                url: "/Auth/ConfirmEmail",
                data: {
                    Email: $("#Email").val(),
                    Code: Code,
                },
                method: "GET",
                beforeSend: function () {
                    swal.fire({
                        html: '<h5>Verifying Code...</h5>',
                        showConfirmButton: false,
                        onRender: function () { $('.swal2-content').prepend(sweet_loader); }
                    });
                },
                success: function (result) {
                    if (result.success) {
                        $("#divReset").show();
                        $("#divVerification").hide();
                    } else {
                        $("#CodeVal").text(result.message);
                    }
                    swal.close()
                }, error: function (err) {
                    alert("Error" + err);
                    swal.close()
                }
            })


        })
    </script>

    <script>

        $(".toggle-password").click(function () {

            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });
    </script>

    <script>
        function Start() {

            var date = new Date();
            date.setTime(new Date().getTime() + (30 * 60000));
            var countDownDate = date.getTime();
            var x = setInterval(function () {
                var now = new Date().getTime();
                var distance = countDownDate - now;
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);
                $("#counter").text(minutes + "m " + seconds + "s ");
                if (distance < 0) {
                    clearInterval(x);
                    $("#Note").html("EXPIRED");
                }
            }, 1000);
        }
    </script>

</body>
<!--end::Body-->
</html>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
