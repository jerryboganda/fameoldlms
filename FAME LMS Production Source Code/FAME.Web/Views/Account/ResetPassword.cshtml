@model First_Aid_Made_Easy.Models.ResetPasswordViewModel
@{
	ViewBag.Title = "Reset password";
	Layout = "";
}

<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<title>Reset password</title>

	<!-- Prevent the demo from appearing in search engines -->
	<meta name="robots" content="noindex">

	<link href="https://fonts.googleapis.com/css?family=Lato:400,700%7CRoboto:400,500%7CExo+2:600&display=swap" rel="stylesheet">

	<!-- Perfect Scrollbar -->
	<link type="text/css" href="~/Content/assets/vendor/perfect-scrollbar.css" rel="stylesheet">

	<!-- Fix Footer CSS -->
	<link type="text/css" href="~/Content/assets/vendor/fix-footer.css" rel="stylesheet">

	<!-- Material Design Icons -->
	<link type="text/css" href="~/Content/assets/css/material-icons.css" rel="stylesheet">


	<!-- Font Awesome Icons -->
	<link type="text/css" href="~/Content/assets/css/fontawesome.css" rel="stylesheet">


	<!-- Preloader -->
	<link type="text/css" href="~/Content/assets/css/preloader.css" rel="stylesheet">


	<!-- App CSS -->
	<link type="text/css" href="~/Content/assets/css/app.css" rel="stylesheet">


	<style>
		.field-icon {
			/*float: right;
			margin-left: -25px;
			margin-top: -25px;
			position: relative;
			z-index: 2;*/
			margin-top: 15px;
		}
	</style>
	@Html.Partial("_TrackingPixels")


</head>





<body class="layout-default layout-login-centered-boxed">








	<div class="layout-login-centered-boxed__form card">
		<div class="d-flex flex-column justify-content-center align-items-center mt-2 mb-5 navbar-light">
			<a href="learnly-index.html" class="navbar-brand flex-column mb-2 align-items-center mr-0" style="min-width: 0">

				<span class="avatar avatar-sm navbar-brand-icon mr-0">

					<span class="avatar-title rounded bg-primary"><img src="~/Content/assets/images/illustration/student/128/white.svg" alt="logo" class="img-fluid" /></span>

				</span>

				First Aid Made Easy
			</a>
			<p class="m-0">Enter Your New Strong Password </p>
		</div>
		<section id="loginForm">

			@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
			{
				@Html.AntiForgeryToken()
				<h4>Reset your password.</h4>
				<hr />
				@Html.ValidationSummary("", new { @class = "text-danger" })
				@Html.HiddenFor(model => model.Code)
				if (Model.Email != null)
				{@Html.HiddenFor(model => model.Email) }
				else
				{

					<div class="form-group">
						<label class="text-label" for="email_2">Email Address:</label>
						<div class="input-group input-group-merge">
							@Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control form-control-prepended", @placeholder = "Enter Your Email" })
							@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
							<div class="input-group-prepend">
								<div class="input-group-text">
									<span class="far fa-envelope"></span>
								</div>
							</div>
						</div>
					</div>
				}
				<div class="form-group">
					@Html.LabelFor(m => m.Password, new { @class = "text-label" })
					<div class="input-group input-group-merge">
						@Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Enter Your Password" })
						<span toggle="#Password" class="fa fa-fw fa-eye field-icon toggle-password"></span>
						<div class="input-group-prepend">
							<div class="input-group-text">
								<span class="fa fa-key"></span>
							</div>
						</div>
					</div>
					<div id="PasswordVal" class="text-danger hidden"></div>
					@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
				</div>
				<div class="form-group">
					@Html.LabelFor(m => m.ConfirmPassword, new { @class = "text-label" })
					<div class="input-group input-group-merge">
						@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Enter Your Password" })
						<span toggle="#ConfirmPassword" class="fa fa-fw fa-eye field-icon toggle-password"></span>
						<div class="input-group-prepend">
							<div class="input-group-text">
								<span class="fa fa-key"></span>
							</div>
						</div>
					</div>
				</div>
				<div class="form-group">
					<div class="col-md-offset-2 col-md-10">
						<input type="submit" class="btn btn-primary" value="Save Password" />
					</div>
				</div>
			}
		</section>
	</div>
	<!-- jQuery -->
	<script src="~/Content/assets/vendor/jquery.min.js"></script>

	<!-- Bootstrap -->
	<script src="~/Content/assets/vendor/popper.min.js"></script>
	<script src="~/Content/assets/vendor/bootstrap.min.js"></script>

	<!-- Perfect Scrollbar -->
	<script src="~/Content/assets/vendor/perfect-scrollbar.min.js"></script>

	<!-- DOM Factory -->
	<script src="~/Content/assets/vendor/dom-factory.js"></script>

	<!-- MDK -->
	<script src="~/Content/assets/vendor/material-design-kit.js"></script>

	<!-- Fix Footer -->
	<script src="~/Content/assets/vendor/fix-footer.js"></script>

	<!-- App JS -->
	<script src="~/Content/assets/js/app.js"></script>


	<script>

		$(".toggle-password").click(function () {

			$(this).toggleClass("fa-eye fa-eye-slash");
			var input = $($(this).attr("toggle"));
			if (input.attr("type") == "password") {
				input.attr("type", "text");
			} else {
				input.attr("type", "password");
			}
		});
	</script>


</body>

</html>


@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
}
