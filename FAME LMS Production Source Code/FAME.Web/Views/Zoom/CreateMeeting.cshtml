@model First_Aid_Made_Easy.Models.MeetingVM
@using First_Aid_Made_Easy.BLL
@using Microsoft.AspNet.Identity;
@using System.Web.Configuration;

<!-- Flatpickr -->
<link type="text/css" href="~/Content/assets/css/flatpickr.css" rel="stylesheet">
<link type="text/css" href="~/Content/assets/css/flatpickr-airbnb.css" rel="stylesheet">
@{
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    ViewBag.Title = " Describe Live Class";
    string email = User.Identity.GetUserName();
    email = "dratifgmc@gmail.com";
    string name = Common.GetUserNameByASpUserID(User.Identity.GetUserId()).User_Name;
    string userID = WebConfigurationManager.AppSettings["userID"];
    string token = WebConfigurationManager.AppSettings["token"];
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Describe LIVE CLASS</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Describe Live Class
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div class="container-fluid page__container">

            <div class="row">
                <div class="col-md-12">

                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <input id="id" name="id" value="@Model.MeetingNo" type="hidden" />
                    <input id="uuid" name="uuid" type="hidden" />
                    <input id="host_id" name="host_id" type="hidden" />
                    <input id="host_email" name="host_email" type="hidden" />
                    <input id="email" name="email" value="@email" type="hidden" />
                    <div class="validation-summary-errors text-danger"> <ul id="Validation"> </ul> </div>
                    <div class="form-row">
                        <div class="col-12 col-md-8 mb-3">
                            <label class="form-label">Topic</label>
                            @Html.TextBox("topic", Model.Topic, new { @class = "form-control" })
                        </div>
                        <div style="display:none" class="col-12 col-md-4 mb-3">
                            <label class="form-label">Password</label>
                            @Html.TextBox("password", "123456", new { @class = "form-control" })
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label">Duration (min)</label>
                            @Html.TextBox("duration", Model.Duration, new { @class = "form-control", @type = "number" })
                        </div>
                        <div class="col-12 col-md-12 mb-3">
                            <label class="form-label">Courses</label>
                            @Html.DropDownList("courseId", new SelectList(ViewBag.Courses, "Course_Id", "Course_Name"),  new { @class = "form-control select2" , @multiple=true })
                        </div>
                        <div class="col-12 col-md-8 mb-3">
                            <label class="form-label">Packages</label>
                            @Html.DropDownList("PackageIDs", new SelectList(ViewBag.Packages, "PackageID", "PackageName"), new { @class = "form-control select2" , @multiple=true })
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label" for="start_time">Meeting Start Time</label>
                            <input id="start_time" type="text" class="form-control"
                                   placeholder="Meeting Start Time" data-toggle="flatpickr"
                                   data-flatpickr-enable-time="true" data-flatpickr-alt-format="F j, Y at H:i"
                                   data-flatpickr-date-format="Y-m-d H:i"
                                   value="@string.Format("{0:yyyy-MM-dd HH:mm}",Model.StartTime)">
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label">Email</label>
                            @Html.TextBox("email123", User.Identity.GetUserName(), new { @class = "form-control" })
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label">Name</label>
                            @Html.TextBox("name", name, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header text-center">
                            <a href="/Zoom/CreateMeeting" class="btn btn-outline-accent-electric-violet"><i class="fa fa-recycle"></i>&nbsp; New</a>
                            @*<button onclick="Save()" id="btnSave" class="btn btn-outline-accent-red">Update</button>
                                <a href="javascript:;" id="btnDelete" class="btn btn-outline-accent-red"><i class="fa fa-trash"></i>&nbsp;  Delete</a>*@
                            @if (Model.MeetingNo > 0)
                            {
                                <button onclick="return Save(@Model.MeetingNo)" id="btnSave" class="btn btn-outline-success">Update</button>
                            }
                            else
                            {
                                <button onclick="return Save(0)" id="btnSave" class="btn btn-outline-success">Save</button>
                            }
                            <a href="/Zoom/ListMeeting" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i>&nbsp;  Back To List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Flatpickr -->
    <script src="~/Content/assets/vendor/flatpickr/flatpickr.min.js"></script>
    <script src="~/Content/assets/js/flatpickr.js"></script>

    <script>
        $(document).ready(function () {
            if ($("#id").val() > 0) {
                $("#courseId").val(@Html.Raw(Json.Encode(Model.CourseIDs?.Split(',')))).change();
                $("#PackageIDs").val(@Html.Raw(Json.Encode(Model.PackageIDs?.Split(',')))).change();
            }
        })

        function Save(MeetID) {

            var fdata = {
                topic: $("#topic").val(),
                password: $("#password").val(),
                duration: $("#duration").val(),
                email: $("#email").val(),
                name: $("#name").val(),
                start_time: $("#start_time").val().replace(" ", "T") + ":00Z", // "2022-07-25T07:32:55Z"
                StartTime: $("#start_time").val(),
                courseId: $("#courseId").val().join(','),
                PackageIDs: $("#PackageIDs").val().join(','),
            }
            if (isModelValid(fdata)) {

                $("#divLoaderid").show();
                var data = {
                    agenda: fdata.topic,
                    default_password: false,
                    duration: fdata.duration,
                    password: fdata.password,
                    pre_schedule: false,
                    schedule_for: fdata.email,
                    settings: {
                        additional_data_center_regions: [
                            "TY"
                        ],
                        allow_multiple_devices: true,
                        approval_type: 2,
                        audio: "telephony",
                        authentication_domains: "example.com",
                        authentication_exception: [
                            {
                                email: fdata.email,
                                name: fdata.name
                            }
                        ],
                        authentication_option: "signIn_D8cJuqWVQ623CI4Q8yQK0Q",
                        auto_recording: "cloud",
                        calendar_type: 1,
                        close_registration: false,
                        cn_meeting: false,
                        contact_email: fdata.email,
                        contact_name: fdata.email,
                        email_notification: true,
                        encryption_type: "enhanced_encryption",
                        focus_mode: true,
                        host_video: true,
                        in_meeting: false,
                        jbh_time: 0,
                        join_before_host: false,
                        meeting_authentication: false,
                        meeting_invitees: [],
                        mute_upon_entry: true,
                        participant_video: false,
                        private_meeting: false,
                        registrants_confirmation_email: true,
                        registrants_email_notification: true,
                        registration_type: 1,
                        show_share_button: true,
                        use_pmi: false,
                        waiting_room: false,
                        watermark: false,
                        host_save_video_order: true,
                        alternative_host_update_polls: true
                    },
                    start_time: fdata.start_time,
                    template_id: "Dv4YdINdTk+Z5RToadh5ug==",
                    timezone: "Asia/Tashkent",
                    topic: fdata.topic,
                    type: 2
                }
                $("#btnSave").hide();
                $.ajax({
                    url: `/Zoom/SaveMeeting/${MeetID}?CourseIDs=${fdata.courseId}&PackageIDs=${fdata.PackageIDs}&StartTime=${fdata.StartTime}&password=${fdata.password}&data=` + encodeURIComponent(JSON.stringify(data)),
                    method: 'POST',
                    dataType: 'Json',
                    contentType: 'application/json',
                    success: function (response) {
                        $("#divLoaderid").hide();
                        if (response.id > 0) {
                            DataSaved();
                        }
                    },
                    error: function (err) {
                        $("#divLoaderid").hide();
                        $("#btnSave").show();
                        var win = window.open("");
                        win.document.write(err.responseText);
                    }

                });
            }
        }

        function isModelValid(data) {
            $("#Validation").html("");
            if (data.topic == "" || (data.courseId == "" && PackageIDs == "")) {
                $("#Validation").append("<li>Topic And Course is Required</li>")
                return false
            } else {
                return true
            }
        }
        $(document).on("click", "#btnDelete", function () {
            var btn = $(this);
            var id = btn.data("id");
            var Name = btn.data("name");
            Swal.fire({
                title: 'Are you sure?',
                text: "You Want To Delete the Meeting '" + Name + "' ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Questions/DeleteQuestion/" + id,
                        method: "GET",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Deleting Meeting...</h5>',
                                showConfirmButton: false,
                                onRender: function () { $('.swal2-content').prepend(sweet_loader); }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                btn.hide();
                                Swal.fire(
                                    'Delete!',
                                    'The Meeting ' + Name + ' Has Been Deleted.',
                                    'success'
                                )
                                window.location.href = "/Questions/List?Type=" + $("#Type").val();
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })
    </script>

}

