@model First_Aid_Made_Easy.Models.StudentNotifVM
@{
	ViewBag.Title = "Notification";
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
	int Sr = 0;
}

<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Notification List</h2>
				<ol class="breadcrumb p-0 m-0">
					<li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
					<li class="breadcrumb-item active">
						Notification List
					</li>
				</ol>
			</div>
		</div>
		<div class="ml-lg-16pt">
			<a href="/Notification/Index" class="btn btn-light"><i class="fa fa-plus Font20"></i>Create New </a>
		</div>
	</div>


	<div class="page-section border-bottom-2">
		<div style="margin: 0;max-width: 100%" class="container-fluid page__container">
			<div class="row">
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Basic information</div>
					</div>
					<table id="DTable" class="table  table-bordered">
						<thead>
							<tr style="background-color: #364e9c">
								<th>Sr.</th>
								<th>Title</th>
								<th>Description</th>
								<th>Send At</th>
								<th>Status</th>
								<th style="min-width:80px">Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var i in Model.List)
							{
								Sr++;
								<tr>
									<td>@Sr</td>
									<td>@i.MessageTitle</td>
									<td>@i.Description</td>
									<td>@string.Format("{0:dd/MM/yyyy hh:mm tt}", i.SendAt)</td>
									<td>@i.Status</td>
									<td>
										<a href="/Notification/Index/@i.ID" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>
										<a href="#" id="btnDelete" data-id="@i.ID" class="text-danger"><i class="fa fa-trash Font20"></i></a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>



@section scripts {
	@Scripts.Render("~/Scripts/List")


	@if (TempData["Success"] != null)
	{
		<script>
			Swal.fire({
				position: 'top-end',
				icon: 'success',
				title: 'Data Saved Successfully',
				showConfirmButton: false,
				timer: 1500
			})
		</script>
	}

	<script>
		$(document).ready(function () {
			$("#DTable").DataTable();
		})

		$(document).on("click", "#btnDelete", function () {
			var id = $(this).data('id');
			var btn = $(this);
			Swal.fire({
				title: 'Are you sure?',
				text: " You Want To Delete The Notification?",
				icon: 'warning',
				showCancelButton: false,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Yes!'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "/Notification/Delete/" + id,
						method: "POST",
						beforeSend: function () {
							swal.fire({
								html: '<h5>Loading...</h5>',
								showConfirmButton: false,
								onRender: function () {
									// there will only ever be one sweet alert open.
									$('.swal2-content').prepend(sweet_loader);
								}
							});
						},
						success: function (result) {
							if (result) {
								btn.hide();
								Swal.fire(
									'Deletes!',
									'The Notification Has Been Removed.',
									'success'
								)
								window.location.href = "/Notification/List";
							}
						}, error: function (err) {
							alert("Error" + err);
						}
					})

				}
			})
		})
	</script>

}

