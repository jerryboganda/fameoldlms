                            <span class="avatar-title rounded-circle">UK</span>
                        </a>
                    </div>
                </div>

            </div>
            <div class="col-sm-6 col-md-4">

                <div class="card card-feedback card-body">
                    <blockquote class="blockquote mb-0">
                        <p class="text-70 small mb-0">A wonderful course on how to start. Eddie beautifully conveys all essentials of a becoming a good Angular developer. Very glad to have taken this course. Thank you Eddie Bryan.</p>
                    </blockquote>
                </div>
                <div class="media ml-12pt">
                    <div class="media-left mr-12pt">
                        <a href="student-profile.html" class="avatar avatar-sm">
                            <!-- <img src="~/Content/assets/images/people/110/guy-.jpg" width="40" alt="avatar" class="rounded-circle"> -->
                            <span class="avatar-title rounded-circle">UK</span>
                        </a>
                    </div>
                </div>

            </div>

            <div class="col-sm-6 col-md-4">

                <div class="card card-feedback card-body">
                    <blockquote class="blockquote mb-0">
                        <p class="text-70 small mb-0">A wonderful course on how to start. Eddie beautifully conveys all essentials of a becoming a good Angular developer. Very glad to have taken this course. Thank you Eddie Bryan.</p>
                    </blockquote>
                </div>
                <div class="media ml-12pt">
                    <div class="media-left mr-12pt">
                        <a href="student-profile.html" class="avatar avatar-sm">
                            <!-- <img src="~/Content/assets/images/people/110/guy-.jpg" width="40" alt="avatar" class="rounded-circle"> -->
                            <span class="avatar-title rounded-circle">UK</span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
            $(".preloader").hide();
            $(".WaterMark").hide();
            $(".accordion__toggle").trigger("click");
            loadVideo(0);
            showWaterMark();
        })

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.getElementById('vid-cont').requestFullscreen();
            } else if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }

        $(".progress").change(function () {
            var el = $(this);
            videoid = el.val();
            isWatched(videoid);
        })

        $(".btnplayVideo").click(function () {
            var videoID = $(this).data().id;
            loadVideo(videoID);
        })
        function loadVideo(videoID) {
            $.ajax({
                url: "/Student/GetVideoPath",
                dataType: 'json',
                type: "GET",
                data: { VideoID: videoID },
                success: function (result) {
                    $("#Iframe").attr("src", result.Video_Path);
                    $("#videoName").html("<strong>" + result.Video_Name + "</strong>");
                    $("#VideoLenght").html(result.Video_Length + "m");
                    showWaterMark();
                    var frame = $('#myIFrame')[0];
                    //frame.contentWindow.location.replace("/Student/MyCourses");
                }
            });
        }
        function isWatched(videoID) {

            $.ajax({
                url: "/Student/IsWatched",
                dataType: 'json',
                type: "GET",
                data: { VideoID: videoID },
                success: function (result) {
                    return;
                }
            });
        }
        function isNotWatched(videoID) {

            $.ajax({
                url: "/Student/IsNotWatched",
                dataType: 'json',
                type: "GET",
                data: { VideoID: videoID },
                success: function (result) {
                    return;
                }
            });
        }
    </script>

    <script>




        Position = ["MidPosition", "MidPosition", "LTPosition", "RBPosition", "RTPosition", "LBPosition"]
        PositionIndex = 0;
        function showWaterMark() {
            setTimeout(function () {
                PositionIndex = Math.floor((Math.random() * 5) + 1);
                $("EmailWM , #PhoneWM,#NameWM").show();
                $("#EmailWM").addClass(Position[PositionIndex]);
                $("#PhoneWM").addClass(Position[PositionIndex + 1]);
                $("#NameWM").addClass(Position[PositionIndex + 2]);
            }, 20000);
            setTimeout(function () {
                $("#EmailWM , #PhoneWM,#NameWM").hide();
                $("#EmailWM , #PhoneWM,#NameWM").attr("class", "WaterMark");
            }, 5000);
            setTimeout(function () { showWaterMark(); }, 20000);
        }

    </script>
}