@model First_Aid_Made_Easy.Models.SectionVM
@using Microsoft.AspNet.Identity
@using First_Aid_Made_Easy.BLL
@{
    ViewBag.Title = "Take Course";
    int i = 0;
}
<style>
    .video-container {
        position: relative;
    }

    .video {
        width: 100%;
        height: 100%;
    }

    /*.watermark {
        position: absolute;
        left: 3%;
        top: 3%;
        color: white;
        animation: 15s moving-watermark infinite;
    }*/
    .WaterMark {
        position: absolute;
        color: red;
        font-size: smaller;
    }

    .MidPosition {
        left: 50%;
        top: 50%;
    }

    .LTPosition {
        left: 25%;
        top: 25%;
    }

    .RBPosition {
        left: 75%;
        top: 75%;
    }

    .RTPosition {
        left: 75%;
        top: 25%;
    }

    .LBPosition {
        left: 25%;
        top: 75%;
    }

    video::-webkit-media-controls-fullscreen-button {
        display: none !important;
    }

    .fullscreen-button {
        position: absolute;
        top: 2%;
        left: 94%;
        z-index: 10;
    }

    /*@@keyframes moving-watermark {
        0% {
            left: 50%;
            top: 50%;
        }

        25% {
            left: 50%;
            top: 50%;
        }

        50% {
            left: 50%;
            top: 50%;
        }

        75% {
            left: 50%;
            top: 50%;
        }

        100% {
            left: 50%;
            top: 50%;
        }
    }*/

</style>

<div class="page-section bg-alt border-bottom-2">
    <div class="container page__container">

        <div class="d-flex flex-column flex-lg-row align-items-center">
            <div class="d-flex flex-column flex-md-row align-items-center flex mb-16pt mb-lg-0 text-center text-md-left">
                <div class="flex">
                    <h1 class="h2 m-0">@Model.Section_Name</h1>
                </div>
            </div>
            <div class="ml-lg-16pt">
                <a href="/Student/MyCourses" class="btn btn-light">Library</a>
            </div>
        </div>

    </div>
</div>
<div class="page-section border-bottom-2">
    <div class="container page__container">
        <div class="row">
            <div class="col-lg-10">
                <div class="js-player card bg-primary embed-responsive embed-responsive-16by9 mb-24pt">
                    <div class="player embed-responsive-item">
                        <div class="player__content">
                            <div class="player__image" style="--player-image: url(@Url.Content(Server.MapPath("~/Images/"+Model.Course_Name)))"></div>
                            <a href="" class="player__play bg-primary">
                                <span class="material-icons">play_arrow</span>
                            </a>
                        </div>
                        <div id="vid-cont" class="player__embed d-none">
                            <iframe src="#"
                                    id="Iframe"
                                    class="embed-responsive-item"
                                    loading="lazy"
                                    style="border: none;
                                    position: absolute; top: 0; height: 100%; width: 100%;"
                                    allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;">
                            </iframe>
                            <span id="EmailWM" class="WaterMark">@User.Identity.GetUserName()</span>
                            <span id="PhoneWM" class="WaterMark">@ViewBag.PhoneNo</span>
                            <span id="NameWM" class="WaterMark">@ViewBag.Name</span>
                            <button class="fullscreen-button" onclick="toggleFullscreen()">
                                <i class="material-icons">fullscreen</i>
                            </button>
                        </div>
                    </div>
                </div>
                <p id="videoName" style="font-weight:bolder" class="lead measure-lead text-70 mb-24pt"></p>
                <div class="mb-24pt">
                    <span class="chip chip-outline-secondary d-inline-flex align-items-center">
                        <i class="material-icons icon--left">schedule</i><span id="VideoLenght"></span>
                    </span>
                    <span class="chip chip-outline-secondary d-inline-flex align-items-center">
                        <i class="material-icons icon--left">assessment</i>
                        Beginner
                    </span>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="page-separator">
                    <div class="page-separator__text">Table of contents</div>
                </div>
                <div class="accordion js-accordion accordion--boxed " id="parent">
                    <div class="accordion__menu collapse show" id="course-toc-@i">
                        @foreach (var v in Model.VideoList)
                        {

                            <div class="accordion__menu-link">
                                @if (v.IsWatched)
                                {
                                    <input name="progress" value="@v.Video_Id" class="form-check-label progress" checked type="checkbox" />
                                }
                                else
                                {
                                    <input name="progress" value="@v.Video_Id" class="form-check-label progress" type="checkbox" />
                                }
                                <a href="#" class="flex btnplayVideo" data-id="@v.Video_Id"><strong>&nbsp;&nbsp;@v.Video_Name</strong></a>
                                <span class="text-muted">
                                    <span class="material-icons icon-16pt text-black-50 mr-4pt">access_time</span>@v.Video_Length min
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body py-16pt text-center">
                        <span class="icon-holder icon-holder--outline-secondary rounded-circle d-inline-flex mb-8pt">
                            <i class="material-icons">timer</i>
                        </span>
                        <h4 class="card-title"><strong>Unlock Section</strong></h4>
                        <p class="card-subtitle text-70 mb-24pt">Get access to all videos in This Section</p>
                        <button type="button" class="btn btn-accent mb-8pt" data-id="@Model.Section_ID" id="btnUnlockSec">Unlock - Only Rs.@Model.Section_Price/mo</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="page-section bg-alt">
    <div class="container page__container">


        <div class="page-separator">
            <div class="page-separator__text">Feedback</div>
        </div>

        <div class="row">

            <div class="col-sm-6 col-md-4">

                <div class="card card-feedback card-body">
