    Layout = "~/Views/Shared/_LayoutNew.cshtml";

}
@section styles {

    <style>
        .video-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            /*padding-top: 56.25%;*/ /* 16:9 Aspect Ratio */
        }

        .responsive-iframe {
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        .video {
            width: 100%;
            height: 100%;
        }

        #vid-cont {
            display: flex;
            align-items: center
        }

        .fullscreen-button {
            position: absolute;
            top: 2%;
            left: 90%;
            z-index: 10;
        }
    </style>
}

