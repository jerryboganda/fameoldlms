@model List<First_Aid_Made_Easy.DAL.sp_lstQuestionPapers_Result>
@{
    ViewBag.Title = "Question Paper";
}
<div class="page-section bg-alt border-bottom-2">
    <div class="container page__container">

        <div class="d-flex flex-column flex-lg-row align-items-center">
            <div class="d-flex flex-column align-items-center align-items-lg-start flex mb-16pt mb-lg-0 text-center text-lg-left">
                <h1 class="h2 mb-4pt">Assignments</h1>
            </div>
        </div>

    </div>
</div>

<div class="page-section border-bottom-2">
    <div class="container page__container">

        <div class="row">
            <div class="col-lg-10">
                <div class="page-separator">
                    <div class="page-separator__text">Assignments</div>
                </div>



                <div class="row">

                    @foreach (var c in Model)
                    {
                        <!--Singal Course Display-->

                        <div class="col-sm-6 col-lg-4 col-xl-3 card-group-row__col">

                            <div class="card card-sm card--elevated p-relative o-hidden overlay overlay--primary-dodger-blue js-overlay mdk-reveal js-mdk-reveal card-group-row__card" data-partial-height="44" data-toggle="popover" data-trigger="click">


                                <a href="#" class="js-image" data-position="">
                                    <img src="@Url.Content("~/Images/"+c.Thumbnail)" width="200" height="200" alt="course">
                                    <span class="overlay__content align-items-start justify-content-start">
                                        <span class="overlay__action card-body d-flex align-items-center">
                                            <i class="material-icons mr-4pt">play_circle_outline</i>
                                            <span class="card-title text-white">Preview</span>
                                        </span>
                                    </span>
                                </a>

                                <div class="mdk-reveal__content">
                                    <div class="card-body">
                                        <div class="d-flex">
                                            <div class="flex">
                                                <a class="card-title" href="#"><p>@c.PaperTitle</p></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="popoverContainer d-none">
                                <div class="media">
                                    <div class="media-left mr-12pt">
                                        <img src="@Url.Content("~/Images/"+c.Thumbnail)" width="40" height="40" alt="Angular" class="rounded">
                                    </div>
                                    <div class="media-body">
                                        <h2 class="card-title mb-0">@c.PaperTitle</h2>
                                    </div>
                                </div>

                                <p class="my-16pt text-black-70">@c.Description</p>

                                <div class="mb-16pt">

                                    <div class="row align-items-center">
                                        <div class="col text-right">
                                            <a href="#" class="btn btn-primary">Insight</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }

                </div>

            </div>
        </div>

    </div>
</div>


@section scripts {

    @*@Scripts.Render("~/Scripts/List")*@
    <script>
        $(document).ready(function () {
            $(".card").removeClass("overlay--show");
        })
    </script>
}