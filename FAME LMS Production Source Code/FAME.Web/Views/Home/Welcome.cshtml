@using Microsoft.AspNet.Identity
@using First_Aid_Made_Easy.BLL

@{ Layout = "";
    var user = Common.GetUserNameByASpUserID(User.Identity.GetUserId());
    var IsOldUser = ViewBag.LoginCount > 3;
}
<!DOCTYPE html>
<html lang="en">
<!--begin::Head-->
<head>
    <title>First Aid Made Easy | Welcome</title>
    <meta name="description" content="Video Lectures for FCPS | MD/MS | NRE | USMLE | PLAB | HAAD | MOH | NEET . Subscribe NOW with 100% Success in Exams GUARANTEED !!!" />
    <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />
    <link rel="canonical" href="https://firstaidmadeeasy.com.pk/" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FCPS-MD/MS-NRE-HAAD-MOH | FIRST AID MADE EASY" />
    <meta property="og:description" content="Video Lectures for FCPS | MD/MS | NRE | USMLE | PLAB | HAAD | MOH | NEET . Subscribe NOW with 100% Success in Exams GUARANTEED !!!" />
    <meta property="og:url" content="https://firstaidmadeeasy.com.pk/" />
    <meta property="og:site_name" content="FIRST AID MADE EASY" />
    <meta property="og:updated_time" content="2021-07-25T15:14:13+05:00" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="FCPS-MD/MS-NRE-HAAD-MOH | FIRST AID MADE EASY" />
    <meta name="twitter:description" content="Video Lectures for FCPS | MD/MS | NRE | USMLE | PLAB | HAAD | MOH | NEET . Subscribe NOW with 100% Success in Exams GUARANTEED !!!" />
    <meta name="google-site-verification" content="lxUrE8D18ksJNdMLVqmJodtlxo4fuekyvsk0N-RA3V0" />
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">


    <link rel="shortcut icon" type="image/x-icon" href="~/Content/assets/images/fame-favicon.png">
    <!--begin::Fonts-->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
    <!--end::Fonts-->
    <!--begin::Global Stylesheets Bundle(used by all pages)-->
    <link href="~/Content/assetsn/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assetsn/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <!--end::Global Stylesheets Bundle-->
    @Html.Partial("_TrackingPixels")
</head>
<!--end::Head-->
<!--begin::Body-->
<body data-kt-name="metronic" id="kt_body" class="app-blank bgi-size-cover bgi-position-center bgi-no-repeat">
    <!--begin::Theme mode setup on page load-->
    @Html.Partial("_ThemeScript")
    <!--end::Theme mode setup on page load-->
    <!--begin::Main-->
    <!--begin::Root-->
    <div class="d-flex flex-column flex-root">
        <!--begin::Page bg image-->
        <style>
            body {
                background-image: url('../../Content/assetsn/media/auth/bg8.jpg');
            }

            [data-theme="dark"] body {
                background-image: url('../../Content/assetsn/media/auth/bg8-dark.jpg');
            }
        </style>
        <!--end::Page bg image-->
        <!--begin::Authentication - Signup Welcome Message -->
        <div class="d-flex flex-column flex-center flex-column-fluid">
            <!--begin::Content-->
            <div class="d-flex flex-column flex-center text-center p-10">
                <!--begin::Wrapper-->
                <div class="card card-flush w-md-650px py-5">
                    <div class="card-body py-15 py-lg-20">
                        <!--begin::Logo-->
                        <div class="mb-7">
                            <a href="/Home/Index" class="">
                                @if (user != null && user.Type == (int)UserType.NRETest)
                                {
                                    <img src="~/Images/Theme/MockTestSchedule.jpg" class="h-600px" />
                                }
                                else
                                {
                                    <img alt="Logo" src="~/Areas/Landing/assets/images/logo/fame-logo.png" class="h-60px" />
                                }
                            </a>
                        </div>
                        <!--end::Logo-->
                        <!--begin::Title-->
                        <h1 class="fw-bolder text-gray-900 mb-5">Welcome to <br /> First Aid Made Easy <br /><br /></h1>
                        @if (IsOldUser)
                        {

                            <ul class="mx-5 fs-4 text-start">
                                <li>No Video Downloading Allowed.</li>
                                <li>No Screen Recording Allowed. </li>
                                <li>No Login Sharing Allowed. </li>
                                <li>If anyone involves in these activities, strict legal action will be taken against him and account will be blocked permanently. </li>
                                <li>If Installment not paid on time, then account will be suspended. </li>
                                <li>Fee in not refundable and subscription can not be seezed. </li>
                                <li>For guidance or enrollment, contact us at: 0318-0049742</li>
                            </ul>
                            <label style="margin-bottom:5px"> <input id="isChecked" type="checkbox" checked /> I agree to above terms <br /> </label>
                            <div class="text-danger" id="divAgree" style="display:none">You must agree to above terms to continue</div>
                        }
                        else
                        {
                            <ul class="mx-5 fs-4 text-start">
                                <li>Your trusted platform for comprehensive medical exam preparation.</li>
                                <li>We provide complete, high-yield study plans for: AMC-1 | FCPS-1 | NRE-1 & NRE-2 | USMLE | PLAB/UKMLA | JCAT/MD,MS-1 | DHA | SMLE | MOH | HAAD | NEET PG</li>
                                <li>For guidance or enrollment, contact us at: 0318-0049742</li>
                            </ul>
                        }
                        <!--end::Title-->
                        <!--end::Illustration-->
                        <!--begin::Link-->
                        <div class="mb-0">
                            <a href="/Student/MyCourses" class="btn btn-lg btn-block btn-primary mb-4 btLink"><h2 class="text-light">Go To My Courses</h2></a>
                            <a href="/QuestionPaper/CreateTest" class="btn btn-lg btn-block btn-primary mb-4 btLink"><h2 class="text-light">Evaluate Yourself</h2></a>
                        </div>
                        <!--end::Link-->
                    </div>
                </div>
                <!--end::Wrapper-->
            </div>
            <!--end::Content-->
        </div>
        <!--end::Authentication - Signup Welcome Message-->
    </div>

    <!--end::Root-->
    <!--end::Main-->
    <!--begin::Javascript-->
    <script>var hostUrl = "~/Content/assetsn/";</script>
    <!--begin::Global Javascript Bundle(used by all pages)-->
    <script src="~/Content/assetsn/plugins/global/plugins.bundle.js"></script>
    <script src="~/Content/assetsn/js/scripts.bundle.js"></script>
    <script src="~/Scripts/Sweetalert2.js"></script>
    <!--end::Global Javascript Bundle-->
    <!--end::Javascript-->
    @if (TempData["UID"] != null)
    {
        <script>
            try {
                localStorage.setItem("UID", '@TempData["UID"]');
            } catch (e) {
                if (e.code == 22) {
                    alert("Browser Storage Full UID");
                }
            }
        </script>
    }
    <script>
        $(".btLink").click(function () {
            if ($("#isChecked").is(":checked")) {
                window.location.href = $(this).data('url');
            } else {
                $("#divAgree").show();
            }
        })
    </script>
    @if (TempData["AmiID"] != null)
    {
        <script>
            localStorage.setItem("AmiID", '@TempData["AmiID"]');
        </script>
    }

    @if (user != null && user.Type == (int)UserType.NRETest)
    {
        <script>
            Swal.fire({
                icon: 'warning',
                title: 'In Respnce to your free gift i will provide 5-10 MCQs after my exam.',
                confirmButtonText: 'I Promise',
                allowOutsideClick: false
            }).then((result) => {
            })
        </script>
    }

    @if (user != null && user.Type == (int)UserType.AppInaug)
    {
        <script>
            Swal.fire({
                title: 'To get 15 days free subscription',
                html: `
                                            <div style="text-align: left;">
                                                <ol>
                                                    <li style="margin-bottom:3px"> Join the group using the link: <a target="_blank" href="https://chat.whatsapp.com/FCSJNQCbPPfAasbE5ctYVs"> Join Group </a> </li>
                                                    <li style="margin-bottom:3px"> Share this WhatsApp group link with 2 medical groups and 5 friends.</li>
                                                    <li style="margin-bottom:3px"> At the end of the 15-day subscription, you will be given a mock test.</li>
                                                    <li style="margin-bottom:3px"> The top 4 positions in the mock test will receive a free 3-month subscription.</li>
                                                    <li style="margin-bottom:3px"> Provide feedback in the review section of the app on Google Play Store.</li>
                                                </ol>
                                            </div>
                                                               `,
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Ok got it!'
            }).then((result) => {

            })
        </script>
    }
</body>
<!--end::Body-->
</html>
