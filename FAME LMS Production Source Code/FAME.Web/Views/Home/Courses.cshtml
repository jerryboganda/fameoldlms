@model First_Aid_Made_Easy.Models.CourseVM
@{
    ViewBag.Title = "Courses";
     Func<decimal,string> HrsMin = First_Aid_Made_Easy.BLL.Common.HrsMins;
}
<div class="page-section bg-alt border-bottom-2">
    <div class="container page__container">

        <div class="d-flex flex-column flex-lg-row align-items-center">
            <div class="d-flex flex-column align-items-center align-items-lg-start flex mb-16pt mb-lg-0 text-center text-lg-left">
                <h1 class="h2 mb-4pt">Library</h1>
            </div>
        </div>

    </div>
</div>

<div class="page-section border-bottom-2">
    <div class="container page__container">

        <div class="row">
            <div class="col-lg-10">
                <div class="page-separator">
                    <div class="page-separator__text">Popular Courses</div>
                </div>



                <div class="row">

                    @foreach (var c in Model.CorList)
                    {
                        <!--Singal Course Display-->

                        <div class="col-sm-6 col-lg-4 col-xl-3 card-group-row__col">

                            <div class="card card-sm card--elevated p-relative o-hidden overlay overlay--primary-dodger-blue js-overlay mdk-reveal js-mdk-reveal card-group-row__card" data-partial-height="44" data-toggle="popover" data-trigger="click">


                                <a href="/Home/Course_Preview/@c.Course_Id" class="js-image" data-position="">
                                    <img src="@Url.Content("~/Images/"+c.Course_Pic)" width="200" height="200" alt="course">
                                    <span class="overlay__content align-items-start justify-content-start">
                                        <span class="overlay__action card-body d-flex align-items-center">
                                            <i class="material-icons mr-4pt">play_circle_outline</i>
                                            <span class="card-title text-white">Preview</span>
                                        </span>
                                    </span>
                                </a>

                                <div class="mdk-reveal__content">
                                    <div class="card-body">
                                        <div class="d-flex">
                                            <div class="flex">
                                                <a class="card-title" href="/Home/Course_Preview/@c.Course_Id"><p>@c.Course_Name</p></a>
                                                <small class="text-50 font-weight-bold mb-4pt">@c.Teacher_Name</small>
                                            </div>
                                        </div>
                                        <div class="d-flex">
                                            <small>@HrsMin(c.DurationInMin)</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="popoverContainer d-none">
                                <div class="media">
                                    <div class="media-left mr-12pt">
                                        <img src="@Url.Content("~/Images/"+c.Course_Pic)" width="40" height="40" alt="Angular" class="rounded">
                                    </div>
                                    <div class="media-body">
                                        <h2 class="card-title mb-0">@c.Course_Name</h2>
                                        <p class="lh-1 mb-0">
                                            <span class="text-black-50 small">with</span>
                                            <span class="text-black-50 small font-weight-bold">@c.Teacher_Name</span>
                                        </p>
                                    </div>
                                </div>

                                <p class="my-16pt text-black-70">@c.Course_Description</p>

                                <div class="mb-16pt">
                                    @if (c.Details.Count > 0)
                                    {
                                        foreach (var d in c.Details)
                                        {

                                            <div class="d-flex align-items-center">
                                                <span class="material-icons icon-16pt text-black-50 mr-8pt">check</span>
                                                <p class="flex text-black-50 lh-1 mb-0"><small>@d.CourseDetail_Body</small></p>
                                            </div>
                                        }
                                    }



                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <div class="d-flex align-items-center mb-4pt">
                                                <span class="material-icons icon-16pt text-black-50 mr-4pt">access_time</span>
                                                <p class="flex text-black-50 lh-1 mb-0">
                                                    <small>@HrsMin(c.DurationInMin)</small>
                                                </p>
                                            </div>
                                            <div class="d-flex align-items-center mb-4pt">
                                                <span class="material-icons icon-16pt text-black-50 mr-4pt">play_circle_outline</span>
                                                <p class="flex text-black-50 lh-1 mb-0"><small>@c.Lessons  lessons</small></p>
                                            </div>
                                        </div>
                                        @if (!c.isEnrolled)
                                        {
                                            <div class="col text-right">
                                                <a href="/Home/Course_Preview/@c.Course_Id" class="btn btn-primary">Course Insight</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col text-right">
                                                <a href="/Student/DisplaySections/@c.Course_Id" class="btn btn-primary">Continue</a>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    }

                </div>
                <div class="mb-32pt">

                    <ul class="pagination justify-content-start pagination-xsm m-0">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" aria-label="Previous">
                                <span aria-hidden="true" class="material-icons">chevron_left</span>
                                <span>Prev</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Page 1">
                                <span>1</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Page 2">
                                <span>2</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Next">
                                <span>Next</span>
                                <span aria-hidden="true" class="material-icons">chevron_right</span>
                            </a>
                        </li>
                    </ul>

                </div>

            </div>
        </div>

    </div>
</div>


@section scripts {

    @*@Scripts.Render("~/Scripts/List")*@
    <script>
        $(document).ready(function () {
            $(".card").removeClass("overlay--show");
        })
    </script>
}