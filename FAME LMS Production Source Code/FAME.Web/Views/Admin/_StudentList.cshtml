@model First_Aid_Made_Easy.Models.StudentVM
@{
    int Sr = 0;
    var yes = "<label style=\"background-color:lightgreen\">Yes</label>";
    var no = "<label style=\"background-color:lightcoral\">No</label>";
    var prepo = new First_Aid_Made_Easy.BLL.PackageRepository();
}
<table style="width:100% !important" id="DTable" class="table table-bordered">
    <thead>
        <tr style="background-color: #364e9c">
            <th>Pic</th>
            <th>Name / Email / Phone</th>
            <th>Enrollment</th>
            <th>City /Job Loc. / YOG   </th>
            <th>Request / R.F / Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.List)
        {
            Sr++;
            <tr>
                <td> <img alt="N/A" loading="lazy" src="@Url.Content("/Images/" + i.User_Pic ?? "userLogo.jpg")" style="width:50px;height:auto" /> </td>
                <td>@(i.User_Name) <br /> @i.Email <br /> <a href="https://wa.me/@i.Student_Mobile" target="_blank"  >@i.Student_Mobile</a> </td>
                <td>
                    @i.PackageName
                    <br /> @prepo.getText(i.Duration).Replace("--- Rs.", "")
                    <br /> @string.Format("{0:dd/MM/yyyy}", i.Enrollment_Date) <b>@(i.Enrollment_Date !=null ?"TO" : "")</b> @string.Format("{0:dd/MM/yyyy}", i.Enrollment_EndDate)
                </td>
                <td>@i.City |<br /> @i.JobLocation | <br /> @i.YearOfMBBS</td>
                <td>
                    @if (i.IsAccepted)
                    {<span class="text-success">Accepted</span>}
                    else
                    { <span class="text-danger">Pending</span>}
                    <br /><b>@string.Format("{0:dd/MM/yyyy}", i.CreateDT)</b> - @i.RegisteredFrom
                    <br />@if (i.IsAccepted && i.PackageName == null)
                    {<span class="text-danger"> Expired</span> }
                    else if (i.IsAccepted && i.PackageName != null)
                    { <span class="text-success"> Continue</span>}
                </td>
                <td>
                    <a href="/Admin/StudentDetail/@i.User_Id" target="_blank" class="text-info"><i class="fa fa-book Font20"></i></a>
                    @if (i.IsActive == false)
                    {<a href="javascript:;" id="btnRowDelete" data-url="/Enrollment/DeleteRequest/@i.User_AspUser" data-name="Student" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                    <a href="javascript:;" title="Un-Block" id="btnBlock" data-url="/Enrollment/Block?Email=@i.Email&Act=UnBlock" data-name="UnBlock" class="text-success"><i class="fa fa-check Font20"></i></a>}
                    else
                    {<a href="javascript:;" title="Block" id="btnBlock" data-url="/Enrollment/Block?Email=@i.Email&Act=Block" data-name="Block" class="text-danger"><i class="fa fa-ban Font20"></i></a> }
                </td>
            </tr>
        }
    </tbody>
</table>