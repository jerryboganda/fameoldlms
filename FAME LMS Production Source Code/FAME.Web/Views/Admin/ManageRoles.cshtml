@using First_Aid_Made_Easy.DAL
@{
    var UserList = (List<sp_GetUsersListByRole_Result>)ViewBag.UserList;
    var selectList = UserList.ConvertAll(x => new { ID = x.ID, Email = x.Email + " - " + x.Role });
    ViewBag.Title = "Manage User Roles";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center mb-24pt mb-md-0">

            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Dashboard</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item active">
                        @ViewBag.Title
                    </li>
                </ol>
            </div>
        </div>


    </div>
</div>


<div class="page-section border-bottom-2">
    <div class="container-fluid page__container">

        <div class="row">

            <div class="col-md-12">
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <form method="post" action="/Admin/SaveRoles">
                            <div class="row">
                                <div class="col-md-6 col-sm-6">
                                    <div class="position-relative form-group">
                                        <label>User</label>
                                        @Html.DropDownList("UserID", new SelectList(selectList, "ID", "Email"), "Please Select", new { @class = "form-control select2" })
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <div class="position-relative form-group">
                                        <label>Roles</label>
                                        @Html.DropDownList("RoleIds", new SelectList(First_Aid_Made_Easy.BLL.Common.Roles, "Value", "Text"), new { @class = "form-control select2", @multiple = true })
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <button type="submit" id="btnSave" class="mt-1 btn btn-primary">Save Changes</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-12">
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <h5 class="card-title">Assistant List</h5>
                        <table class="mb-0 table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>EMAIL</th>
                                    <th>Roles</th>
                                </tr>
                            </thead>
                            <tbody id="RemarkBody">

                                @if (UserList != null)
                                {
                                    int sr = 0;
                                    foreach (var i in UserList.Where(x => x.Role == "Assistant"))
                                    {
                                        sr++;
                                        <tr>
                                            <th scope="row">@sr</th>
                                            <td>@i.Name</td>
                                            <td>@i.Email</td>
                                            <td>@i.Role</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @if (TempData["Message"] != null)
    {
        <script>
            Swal.fire({
                position: 'top-end',
                title: '@TempData["Message"]',
                showConfirmButton: false,
                timer: 1500
            })
        </script>
    }

    <script>

        // =============================================
        // ============ Remove Role ===================
        // =============================================
        $(document).on("click", "#btnDelete", function () {
            var id = $(this).data('id');
            var tr = $(this).closest('tr');
            Swal.fire({
                title: 'Are you sure?',
                text: "This User will No Longer be a Teacher!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Remove it!'
            }).then((result) => {
                if (result.isConfirmed) {

                    $.ajax({
                        url: "/Account/RemoveInstructor?UserID=" + id,
                        success: function (result) {
                            if (result) {
                                Swal.fire('Removed!', 'This User Is No Longer a Teacher.', 'success');
                                tr.remove();
                            } else {
                                Swal.fire('Sorry!', 'Something Went Wrong.', 'error');
                            }
                        },
                        error: function (err) {
                            var win = window.open();
                            win.document.write(err.responseText);
                        }
                    })
                }
            })

        })
    </script>
}
