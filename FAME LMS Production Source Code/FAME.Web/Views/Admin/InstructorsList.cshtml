@model IEnumerable<First_Aid_Made_Easy.DAL.sp_GetUsersListByRole_Result>
@{
    ViewBag.Title = "InstructorsList";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    int Sr = 0;
}


<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Instructors List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active"> Instructors List </li>
                </ol>
            </div>
        </div>
        <div class="ml-lg-16pt">
            <a href="/Account/RegisterTeacher" class="btn btn-light"><i class="fa fa-plus Font20"></i>Create New </a>
        </div>
    </div>
    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic Information</div>
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        <table style="width:100% !important" id="DTable" class="table table-bordered">
                            <thead>
                                <tr style="background-color: #364e9c">
                                    <th>Sr.</th>
                                    <th>Name</th>
                                    <th>Email </th>
                                    <th>Approved Enrollments</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model)
                                {
                                    Sr++;
                                    <tr>
                                        <td>@Sr</td>
                                        <td>@(i.Name)</td>
                                        <td>@i.Email </td>
                                        <td>@i.ApprEnroll</td>
                                        <td>
                                            <a href="javascript:;" id="btnRowDelete" data-url="/Enrollment/DeleteRequest/@i.ID" data-name="Instructor" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

