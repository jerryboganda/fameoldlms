@model First_Aid_Made_Easy.Models.ExamAttemptVM
@{
    ViewBag.Title = Model.ExamAttemptID > 0 ? "Edit Exam Attempt" : "Add Exam Attempt";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@ViewBag.Title</h3>
            </div>
            <div class="panel-body">
                @using (Html.BeginForm("Save", "ExamAttempt", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ExamAttemptID)

                    <div class="form-group">
                        @Html.LabelFor(m => m.PackageID, "Package", new { @class = "col-sm-3 control-label" })
                        <div class="col-sm-9">
                            @Html.DropDownListFor(m => m.PackageID, 
                                new SelectList(ViewBag.Packages, "Value", "Text", Model.PackageID),
                                "-- Select Package --",
                                new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.PackageID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.AttemptName, new { @class = "col-sm-3 control-label" })
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.AttemptName, new { @class = "form-control", placeholder = "e.g., Attempt 1, May 2024", required = "required", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.AttemptName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.SortOrder, new { @class = "col-sm-3 control-label" })
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number" })
                            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.IsActive, new { @class = "col-sm-3 control-label" })
                        <div class="col-sm-9">
                            <div class="checkbox">
                                <label>
                                    @Html.CheckBoxFor(m => m.IsActive)
                                    Active
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-9">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Save
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-default">
                                <i class="fa fa-times"></i> Cancel
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
