@model First_Aid_Made_Easy.Models.StudyScheduleVM
@{
    ViewBag.Title = "Study Schedules - " + ViewBag.AttemptName;
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Study Schedules for "@ViewBag.AttemptName" (@ViewBag.PackageName)</h3>
            </div>
            <div class="panel-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <a href="@Url.Action("Index", "ExamAttempt")" class="btn btn-default">
                            <i class="fa fa-arrow-left"></i> Back to Exam Attempts
                        </a>
                    </div>
                    <div class="col-md-6 text-right">
                        <a href="@Url.Action("Save", new { attemptId = Model.ExamAttemptID })" class="btn btn-success">
                            <i class="fa fa-plus"></i> Add Schedule Entry
                        </a>
                    </div>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @if (Model.List != null && Model.List.Count > 0)
                {
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Week</th>
                                <th>Topic Title</th>
                                <th>Date</th>
                                <th>Sort Order</th>
                                <th>Status</th>
                                <th width="150">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.List)
                            {
                                <tr>
                                    <td>
                                        @switch (schedule.ScheduleType)
                                        {
                                            case 1:
                                                <span class="label label-primary">Weekly</span>
                                                break;
                                            case 2:
                                                <span class="label label-info">Text/HTML</span>
                                                break;
                                            case 3:
                                                <span class="label label-warning">File</span>
                                                break;
                                            case 4:
                                                <span class="label label-success">Calendar</span>
                                                break;
                                        }
                                    </td>
                                    <td>@(schedule.WeekNumber.HasValue ? "Week " + schedule.WeekNumber : "-")</td>
                                    <td>@schedule.TopicTitle</td>
                                    <td>@(schedule.ScheduleDate.HasValue ? schedule.ScheduleDate.Value.ToString("MMM dd, yyyy") : "-")</td>
                                    <td>@schedule.SortOrder</td>
                                    <td>
                                        @if (schedule.IsActive)
                                        {
                                            <span class="label label-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Save", new { attemptId = Model.ExamAttemptID, id = schedule.StudyScheduleID })" class="btn btn-sm btn-primary">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = schedule.StudyScheduleID, attemptId = Model.ExamAttemptID })" 
                                           class="btn btn-sm btn-danger" 
                                           onclick="return confirm('Are you sure you want to delete this schedule entry?')">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                        @if (schedule.ScheduleType == 3 && !string.IsNullOrEmpty(schedule.FilePath))
                                        {
                                            <a href="@Url.Content(schedule.FilePath)" target="_blank" class="btn btn-sm btn-info">
                                                <i class="fa fa-download"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i> No study schedule entries found. Click "Add Schedule Entry" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
