@model First_Aid_Made_Easy.Models.CouponVM
@{
    ViewBag.Title = "Coupon";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    int Sr = 0;
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Coupon List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Coupon List
                    </li>
                </ol>
            </div>
        </div>
        <div class="ml-lg-16pt">
            <a href="/Coupon/Index" class="btn btn-light"><i class="fa fa-plus Font20"></i>Create New </a>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0;max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <table id="DTable" class="table  table-bordered">
                        <thead>
                            <tr style="background-color: #364e9c">
                                <th>Name</th>
                                <th>Valid Till</th>
                                <th>Disc %</th>
                                <th>No Of Uses</th>
                                <th title="Remaining Uses">R. Uses</th>
                                <th>For</th>
                                <th>Active</th>
                                <th style="min-width:80px">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.List)
                            {
                                Sr++;
                                <tr>
                                    <td>@i.CouponName</td>
                                    <td>@i.ExpiryDate</td>
                                    <td>@Math.Round(i.DiscountPer??0)%</td>
                                    <td>@i.NoOfUses</td>
                                    <td>@i.RUses</td>
                                    <td>@i.ForName</td>
                                    <td>@i.IsActive</td>
                                    <td>
                                        <a href="/Coupon/Index/@i.Id" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>
                                        <a href="#" class="text-info"><i class="fa fa-book Font20"></i></a>
                                        <a href="#" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
@Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable();
        })

        $(document).on("click", "#btnDelete", function () {
            toastr.warning("Sorry This Function is Not Yet Available");
        })
    </script>

}

