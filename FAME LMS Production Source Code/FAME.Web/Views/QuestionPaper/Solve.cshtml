@using First_Aid_Made_Easy.BLL;
@using System.Web.Configuration;
@using Microsoft.AspNet.Identity;
@model First_Aid_Made_Easy.Models.QuestionPaperVM
@{
	ViewBag.Title = "Question Paper";
	ViewBag.BreadCrumb = new String[] { "Question Paper", "Solve" };
	string Back = "";
	if (Request.IsAuthenticated)
	{
		Layout = "~/Views/Shared/_LayoutNew.cshtml";
		Back = "/QuestionPaper/StudentList";
	}
	else
	{
		Layout = "~/Views/Shared/_LayoutFree.cshtml";
		Back = "/";
	}

	var AllowInspect = Convert.ToBoolean(WebConfigurationManager.AppSettings["AllowInspect"] ?? "false");
	var MCQs = Model.QuestionList?.Where(x => x.Type == (int)QuestionType.Mcq).ToList();

	var Result = (First_Aid_Made_Easy.Models.ResultVM)ViewBag.Result ?? new First_Aid_Made_Easy.Models.ResultVM();

	var user = Common.GetUserNameByASpUserID(User.Identity.GetUserId());

	bool IsComplete = Result.ObtainedMarks > 0;

	if (Result?.Detail != null)
	{
		var Ids = Result.Detail.Where(x => x.IsTrue != null).Select(x => x.QuestionID).ToList();
		MCQs.Where(x => Ids.Contains(x.Question_Id)).ToList().ForEach(x => x.IsSolved = true);
	}
}


@section styles {
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-tagsinput/0.8.0/bootstrap-tagsinput-typeahead.css" integrity="sha512-wu4jn1tktzX0SHl5qNLDtx1uRPSj+pm9dDgqsrYUS16AqwzfdEmh1JR8IQL7h+phL/EAHpbBkISl5HXiZqxBlQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-tagsinput/0.8.0/bootstrap-tagsinput.css" integrity="sha512-xmGTNt20S0t62wHLmQec2DauG9T+owP9e6VU8GigI0anN7OXLip9i7IwEhelasml2osdxX71XcYm6BQunTQeQg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<style>
		.label-info {
			background-color: #2e3e49;
			padding: 4px;
			margin: 2px;
			border-radius: 2px;
			margin-bottom: 4px;
		}

		.bootstrap-tagsinput {
			min-width: 100% !important;
		}

		.btnActive {
			background-color: #ed7c7c
		}
	</style>
	<style>

		.questionbar {
			overflow: hidden;
			background-color: #caeefb;
			position: fixed;
			bottom: 0;
			width: 100%;
			padding: 1rem;
			display: flex;
			justify-content: space-between;
			box-shadow: 0px 10px 5px #b6b6b6, 0px -5px 5px #b6b6b6;
