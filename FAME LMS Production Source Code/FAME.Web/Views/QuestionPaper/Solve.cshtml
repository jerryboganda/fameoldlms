							</svg>
						</span>
						<!--end::Svg Icon-->
						<h3 class="fw-bold m-0 text-gray-800"> <span id="mcqNo"></span> @Model.QuestionList.Count()</h3>
					</div>
					<div class="card-toolbar m-0">

						<div class="d-flex align-items-center ms-3 ms-lg-4">
							<div class="btn btn-icon btn-color-gray-700 btn-outline " id="btnPrev">
								<i class="fa fa-backward"></i>
							</div>
						</div>
						<div class="d-flex align-items-center ms-3 ms-lg-4">
							<div class="btn btn-icon btn-color-gray-700 btn-outline" id="btnNext">
								<i class="fa fa-forward"></i>
							</div>
						</div>
						<div class="d-flex align-items-center ms-3 ms-lg-4">
							<div class="btn btn-icon btn-color-gray-700 btn-outline btnMark">
								<i class="fa fa-flag"></i>
							</div>
						</div>
						<div class="d-flex align-items-center ms-3 ms-lg-4">
							<div class="btn btn-icon btn-color-gray-700 btn-outline" id="fullscreenButton" onclick="toggleFullscreen()">
								<i class="fa fa-expand"></i>
							</div>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="tab-content mcq-Content bg-img">
						@if (MCQs != null)
						{
							Sr = 0;
							foreach (First_Aid_Made_Easy.Models.QuestionVM m in MCQs)
							{
								Sr++;
								<div id="mcq" style="display:none" data-isfav="true" data-no="@Sr" data-id="@m.Question_Id" class="card-body p-0 tab-pane fade show active allmcq">
									<div class="expl d-none">@Html.Raw(m.AnsExplain)</div>
									<div class="timeline">
										<div class="timeline-item">
											<div class="timeline-line w-40px"></div>
											<div class="timeline-content mt-n1" style="min-height:300px">
												<div class="pe-3 mb-5">
													<div class="fs-5 fw-semibold mb-2">@m.Question</div>
													<div class="d-flex align-items-center mt-1 fs-6">
														<div class="text-muted me-2 fs-7">Marks  (@m.Marks)</div>
													</div>
												</div>
												<table class="w3-table w3-bordered">

													@if (m.IsSolved)
													{
														First_Aid_Made_Easy.Models.ResultDetailVM r = Result.Detail.FirstOrDefault(x => x.QuestionID == m.Question_Id);
														foreach (First_Aid_Made_Easy.Models.OptionVM o in m.Options)
														{
															bool IsChecked = o.OptionText?.Trim() == r.Answer?.Trim();

															<tr>
																<td style="width: 60px">
																	@*<input class="correct" name="correct@(m.Question_Id)" value="@o.OptionText" @(IsChecked ? "checked" : "") data-istrue="@o.IsCorrect" type="@( m.IsMultiAns ? "checkbox" : "radio" )" />*@
																	<input class="option" name="option@(m.Question_Id)" value="@o.OptionText.Trim()" @(IsChecked ? "checked" : "") data-istrue="@o.IsCorrect" type="radio" />
																</td>
																<td onclick="ToggleCheckBx(this)" class="@(o.IsCorrect ? "tdcorrect" : "")">@o.OptionText  </td>
																<td class="text-end"><i class="fa fa-check"></i><i class="fa fa-xmark"></i> <b class="CheckedByStudentsPerc" style="color:black">@string.Format(o.CheckedByStudentsPerc < 1 ? "{0:n1}" : "{0:n0}", o.CheckedByStudentsPerc)%</b> </td>
															</tr>
														}
													}
													else
													{
														foreach (var o in m.Options)
														{
															<tr>
																<td style="width: 60px">
																	<input class="option" name="option@(m.Question_Id)" value="@o.OptionText.Trim()" data-istrue="@o.IsCorrect" type="radio" />
																</td>
																<td onclick="ToggleCheckBx(this)" class="@(o.IsCorrect ? "tdcorrect" : "")">@o.OptionText  </td>
																<td class="text-end"><i class="fa fa-check"></i><i class="fa fa-xmark"></i> <b class="CheckedByStudentsPerc" style="color:black">@string.Format(o.CheckedByStudentsPerc < 1 ? "{0:n1}" : "{0:n0}", o.CheckedByStudentsPerc)%</b> </td>
															</tr>
														}
													}
												</table>
											</div>
										</div>
									</div>
								</div>
							}
						}
					</div>
					<div class="row ans-explanation " style="display:none">
						<div class="col-sm-12"><h1>Explanation</h1> </div>
						<div class="col-sm-12 data"> </div>
						<div class="col-sm-12"><hr /> </div>
					</div>
				</div>
				<!--end::Card body-->
			</div>
		</div>
	</div>

	<div class="questionbar">
		<div>
			<h3 id="divTimer">Time Remaining : <span id="timer"> @Model.Time min </span> <br /></h3>
			@if (ViewBag.Mode == "Tutor")
			{<span class="badge badge-primary">Tutor Mode</span>}
			else
			{ <span class="badge badge-dark">Exam Mode</span>}
		</div>
		<div>

			<button type="button" class="btn btn-sm btn-primary btnnotes-modal" data-toggle="modal" onclick="ToggleModal('show')" data-target="#notes-modal">
				<i class="fa fa-note-sticky"></i> Notes
			</button>
			@if (Model.PaperTitle == null)
			{<button onclick="return Suspend('End')" class="btn btn-sm btn-primary"><i class="fa fa-pause"></i> Suspend</button>}
			<button onclick="return CompleteResult('End')" class="btn btn-sm btn-danger"><i class="fa fa-stop"></i> End</button>
		</div>
		<div></div>
	</div>
</div>

<div class="modal fade" id="notes-modal" tabindex="-1" role="dialog" aria-labelledby="notes-modal-title" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="notes-modal-title">Add Notes and Tags</h5>
				<button type="button" class="btn btn-light close" onclick="ToggleModal('hide')" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">

				<div class="card mb-5">
					<div class="card-body p-5">
						<h3 class="fw-bold text-gray-800"><i class="fa fa-notes-medical"></i> Notes</h3>
						<textarea id="Notes" name="Notes" class="form-control" rows="5"> </textarea>
						<br />
						<h3 class="fw-bold text-gray-800"><i class="fa fa-tags"></i> Tags</h3>
						<input id="Tags" name="Tags" class="form-control tags" />
						<button class="btn btn-primary" style="margin:15px;float : right" id="btnSaveNotes">Save</button>
					</div>
				</div>
				<div class="card d-none">

					<div class="card-header card-header-stretch">
						<div class="card-title d-flex align-items-center">
							<h3 class="fw-bold m-0 text-gray-800"><i class="fa fa-comment"></i> Comments</h3>
						</div>
					</div>
					<div class="card-body p-3">
						<div class="divComments">

						</div>
						<div class="mb-0">
							<textarea class="form-control form-control-solid placeholder-gray-600 fw-bold fs-4" rows="6" id="Comment" name="Comment" placeholder="Please add your Comment"></textarea>
							<button type="button" id="btnsendComment" class="btn btn-primary mt-n20 mb-20 position-relative float-end me-7">Send</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


<div id="divLoaderid" class="divLoader">
	<img src="~/Images/loader.gif" />
</div>

@section scripts {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-tagsinput/0.8.0/bootstrap-tagsinput.min.js" integrity="sha512-9UR1ynHntZdqHnwXKTaOm1s6V9fExqejKvg5XMawEMToW4sSw+3jtLrYfZPijvnwnnE8Uol1O9BcAskoxgec+g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>


	<script>
		window.addEventListener('beforeunload', function (event) {
			event.preventDefault();
			event.returnValue = ''; // This is required for some browsers to display the confirmation dialog
			// You can customize the message to be displayed in the confirmation dialog
			const confirmationMessage = 'Are you sure you want to leave this page?';
			event.returnValue = confirmationMessage; // This is required for some browsers to display the confirmation dialog
			return confirmationMessage;
        });

        var ResultID = @Result.ID;
        function ApplyTags() {
            $('.tags').tagsinput({
                trimValue: true,
                confirmKeys: [13, 44],
                focusClass: 'my-focus-class'
            });
            $('.tags').tagsinput('removeAll');
        }

        $(document).ready(function () {
            ApplyTags();
            GoToQuestionNo(1);
			$(".divLoader").hide();
			localStorage.setItem("FreeResultID", ResultID);
        })
        var lastChecked;
        $(document).on("mousedown",".option",function (e) {
            if ($(this).data("disabled"))
                lastChecked = $(this).closest(".allmcq").find(".option:checked");
        })

        $(".option").change(function (e) {
            if (!$(this).data("disabled")) {
                SubmitAns($(this).closest(".allmcq"));
                if ('@ViewBag.Mode' == 'Tutor')
                    ShowAnswer();
            } else
                lastChecked.prop("checked", true);
        })
        $(".quesNo").click(function () { GoToQuestionNo($(this).data("id")); })
        $("#btnPrev").click(function () {
            var c = $(".allmcq:visible");
            GoToQuestionNo(c.prev().data("no"));
        })
        $("#btnNext").click(function () {
            var c = $(".allmcq:visible");
            GoToQuestionNo(c.next().data("no"));
        })
        function SubmitAns(c) {
            $('tr[data-id="' + c.data('no') + '"]').find(".bullet-dot").hide();
            if (ResultID > 0) SaveResultDetail(c);
            else SaveResult(c);
        }
        function GoToQuestionNo(no) {
            if (no > 0) {
                $(".allmcq:visible").hide();
                $('[data-no="' + no + '"]').show();
                $("#mcqNo").text(no + "-");
                GetCommentNotesTags($('[data-no="' + no + '"]').data("id"));
                $("#btnHideAns").click();
                $('.quesNo').removeClass("bg-primary");
                var numtr = $('tr[data-id="' + no + '"]');
                numtr.addClass("bg-primary");
                if (numtr.find(".fa-flag").hasClass("d-none")) $(".btnMark").removeClass("bg-success"); else $(".btnMark").addClass("bg-success");
                if ('@ViewBag.Mode' == 'Tutor') ShowAnswer();
            }
        }

        function ShowAnswer() {
            var c = $(".allmcq:visible");
            if (c.find(".option:checked").length > 0) {
                c.find(".option").attr("data-disabled", true);
                $(".ans-explanation").show().find(".data").html(c.find(".expl").html());
				$(".CheckedByStudentsPerc").show();
                c.find(".option:checked").closest("tr").addClass("wrongAns");
                c.find(".tdcorrect").closest("tr").removeClass("wrongAns").addClass("rightAns");
            } else
				$(".ans-explanation,.CheckedByStudentsPerc").hide();
        }


        $("#btnSaveNotes").click(function () {
            var id = $(".allmcq:visible").data("id");
            var Tags = $("#Tags").val();
            var Notes = $("#Notes").val();
            SaveNotesTags(id, Notes, Tags)
        })
        $("#btnsendComment").click(function () {
            var id = $(".allmcq:visible").data("id");
            var Comment = $("#Comment").val()
            $("#Comment").val("");
            SaveComment(id, Comment);
        })

        $(".btnFavourites").click(function () {
            var c = $(".allmcq:visible");
            var btn = $(this);
            var id = c.data("id");
            $.ajax({
                url: '/Favourites/AddToFavourits/' + id ,
                data: { Type : '@QuestionType.Mcq.ToString()' },
                success: function (response) {
                    if (response) {
                        btn.addClass('btnActive');
                    }
                },
                error: function (err) { }
            });
        })
        $(".btnMark").click(function () {
            var c = $(".allmcq:visible");
            var id = c.data("id");
            var no = c.data("no");
            var f = $('tr[data-id="' + no + '"]').find(".fa-flag");
            f.toggleClass("d-none");
            if (f.hasClass("d-none")) $(".btnMark").removeClass("bg-success"); else $(".btnMark").addClass("bg-success");

            $.ajax({
                url: '/Favourites/AddToFavourits/' + id ,
                data: { Type: '@QuestionType.Mcq.ToString()', Remove: f.hasClass("d-none") }
            });
        })

        function SaveResult(current) {

            var data = {
                QuestionPaperID: '@Model.PaperID',
                Mode: '@ViewBag.Mode',
			}
			var det = GetQuestionData(current);
			if (det.Answer) {
				data.Detail = [det];
			}

            $.ajax({
                url: '/QuestionPaper/SaveResult',
                method: 'POST',
                data: JSON.stringify(data),
                dataType: 'Json',
                contentType: 'application/json',
                success: function (response) {
                    if (response > 0) {
                        ResultID = response;
                    }
                },
                error: function (err) {

                }

            });
        }

        function SaveResultDetail(current) {
            var data = GetQuestionData(current);
			if (data.Answer) {
				$.ajax({
					url: '/QuestionPaper/SaveResultDetail',
					method: 'POST',
					data: JSON.stringify(data),
					dataType: 'Json',
					contentType: 'application/json',
					success: function (response) {
						if (response) {
						}
					},
					error: function (err) {

					}

				});
			}
        }

        function GetQuestionData(current) {
            var data = {
                QuestionID: current.data('id'),
                Answer: current.find(".option:checked").eq(0).val() ,
                IsTrue: current.find(".option:checked").eq(0).data('istrue'),
                ResultID: ResultID,
            }
            return data;
        }

        function GetCommentNotesTags(id) {
            $.ajax({
                url: "/QuestionPaper/GetCommentNotesTags/" + id,
                success: function (data) {
                    $("#Notes").val(data.notes);
                    ApplyTags();
                    if (data.tags != null) {
                        $.each(data.tags.split(','), function (i, val) {
                            $("#Tags").tagsinput('add', val);
                        })
                    } else
                        $(".divComments").html("");
                    $.each(data.comments, function (i, val) {
                        AppendComment(val);
                    })

                }
            })
        }

        function SaveComment(id, Comment) {
            $.ajax({
                url: '/QuestionPaper/SaveComment/' + id,
                data: { Comment: Comment },
                dataType: 'Json',
                contentType: 'application/json',
                success: function (response) {
                    if (response) {
                        toastr.success('Data Saved Successfully');
                        AppendComment({
                            User_Pic: '/Images/@user.User_Pic',
                            User_Name: '@user.User_Name',
                            Comment_Body: Comment
                        });
                    }
                },
                error: function (err) { }
            });
        }

        function SaveNotesTags(id , Notes , Tags) {
            $.ajax({
                url: '/QuestionPaper/SaveNotesTags/' + id,
                data: { Notes: Notes, Tags: Tags },
                dataType: 'Json',
                contentType: 'application/json',
                success: function (response) {
                    if (response) { toastr.success('Data Saved Successfully') }
                },
                error: function (err) { }
            });
        }

        function AppendComment(data) {
            var Html =  `
                        <div class="card card-bordered mb-9 w-100">
                            <div class="p-3 card-body">
                                <div class="w-100 d-flex flex-stack mb-4">
                                    <div class="d-flex align-items-center f">
                                        <div class="symbol symbol-50px me-5">
                                            <img src="${data.User_Pic}" />
                                        </div>
                                        <div class="d-flex flex-column fw-semibold fs-5 text-gray-600 text-dark">
                                            <div class="d-flex align-items-center">
                                                <a href="javascript:;" class="text-gray-800 fw-bold text-hover-primary fs-5 me-3">${data.User_Name}</a>
                                                <span class="m-0"></span>
                                            </div>
                                            @*<span class="text-muted fw-semibold fs-6">2 Days ago</span>*@
                                        </div>
                                    </div>
                                </div>
                                <p class="fw-normal fs-5 text-gray-700 m-0">${data.Comment_Body}</p>
                            </div>
                        </div> `
                ;
            $(".divComments").append(Html);
        }

        function CompleteResult(status) {
            IsCompleted = true;
            if (status == "TimeUp")
            Swal.fire(
                'Time Up',
                'Your time has been elasped',
                'warning'
                );
            else Swal.fire(
                'Good Job',
                'You have solved the Question Paper',
                'success'
            );
            if (ResultID > 0) {
                $.ajax({
                    url: "/QuestionPaper/Completed/" + ResultID,
                    success: function () { window.location.href = "/QuestionPaper/Analysis/" + ResultID; }
                });
            }
            else window.location.href = "/QuestionPaper/Analysis/" + ResultID;
        }

        function Suspend(status) {
            Swal.fire(
                'Good Luck Next Time',
                'You have suspended the Question Paper',
                'warning'
            );
            if (ResultID > 0) {
                $.ajax({
                    url: "/QuestionPaper/Suspend/" + ResultID,
                    success: function () { window.location.href = "@Back"; }
                });
            } else window.location.href = "@Back";
        }

        function ToggleCheckBx(This) {
            var el = $(This).closest("tr").find(".option");
            if (!el.data("disabled"))
                el.prop("checked", !el.prop("checked")).change();
        }

        function ToggleModal(action) {
            $("#notes-modal").modal(action);
        }

	</script>

	<script>
		const fullscreenButton = document.getElementById('fullscreenButton');
		const contentContainer = document.getElementById('kt_content_container');

		fullscreenButton.addEventListener('click', () => {
			if (!document.fullscreenElement) {
				contentContainer.requestFullscreen().then(() => {
					$("#kt_content_container").addClass("freeScroll");
					$(".btnnotes-modal").hide();
				}).catch((error) => {
					alert('Error entering fullscreen:', JSON.stringify(error));
				});
			} else if (document.exitFullscreen) {
				document.exitFullscreen();
				$("#kt_content_container").removeClass("freeScroll");
				$(".btnnotes-modal").show();
			}
		});

	</script>


	@if (!AllowInspect)
	{
		<script>

			document.addEventListener('selectstart', function (e) {
				e.preventDefault();
			});
			// Prevent right-click
			document.addEventListener('contextmenu', function (e) {
				e.preventDefault();
				if (e.target.nodeName === 'IMG') {
					// Prevent the "Save image as" option from showing up in the context menu
				}
			});

			// Prevent keyboard shortcuts
			document.addEventListener('keydown', function (e) {
				if (e.ctrlKey && e.shiftKey && (e.keyCode == 73 || e.keyCode == 105)) {
					e.preventDefault();
				}
			});
		</script>
	}
	@if (ViewBag.Mode == "Tutor")
	{
		<script>
			var dt = new Date().getTime();
			var StartTime = new Date().getTime();

			var int = setInterval(function () {
				var now = new Date().getTime();
				var distance = now - StartTime;
				var days = Math.floor(distance / (1000 * 60 * 60 * 24));
				var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
				var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
				var seconds = Math.floor((distance % (1000 * 60)) / 1000);
				document.getElementById("timer").innerHTML = display(hours) + ":" + display(minutes) + ":" + display(seconds);
				if (distance < 0) {
					clearInterval(int);
					CompleteResult("TimeUp");
				}
			}, 1000);
			function display(hours) {
				return hours < 9 ? "0" + hours : hours
			}
		</script>
	}
	else
	{
		<script>
            var dt = new Date().getTime();
            var minutes = @( Result.TimeGiven ?? 40 ) ;
            var countDownDate = new Date(dt + minutes * 60000).getTime();

            var int = setInterval(function () {
                var now = new Date().getTime();
                var distance = countDownDate - now;
                var days = Math.floor(distance / (1000 * 60 * 60 * 24));
                var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);
                document.getElementById("timer").innerHTML = display(hours) + ":" + display(minutes) + ":" + display(seconds);
                if (distance < 0) {
                    clearInterval(int);
                    CompleteResult("TimeUp");
                }
            }, 1000);
            function display(hours) {
                return hours < 9 ? "0" + hours : hours
            }
		</script>
	}
}

