@model List<First_Aid_Made_Easy.DAL.sp_lstApproveComments_Result>
@{
    ViewBag.Title = "Comment";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

    <!-- DateRangePicker -->
    <link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Comment List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Comment List
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Search Filters</div>
                    </div>
                    <div style="margin-top:20px">
                        <div class="row">
                            <div class="col-md-4">
                                <label>Status</label>
                                <select id="Status" class="form-control select2">
                                    <option value="Pending" >Pending</option>
                                    <option value="Approved" >Approved</option>
                                    <option value="UnApproved" >Un-Approved</option>
                                    <option value="All" >All</option>
                                </select>
                            </div>
                            @*<div style="margin-top:25px" class="text-left col-md-4">
                                <button id="btnShow" class="btn btn-outline-primary" onclick="FilterList('Email')">Show</button>
                            </div>*@
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic Information</div>
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        @Html.Partial("_CommentList")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable();
            //$(document).find("#DTable_wrapper").css("display", "");
        })

        $(document).on("click", "#btnAccept", function () {
            var id = $(this).data('id');
            var isapprove = $(this).data('isapprove');
            var tr = $(this).closest("tr");
            Swal.fire({
                title: 'Are you sure?',
                text: "You Want To Approve The Comment?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/QuestionPaper/ApproveComment/" + id + "?IsApproved=" + isapprove,
                        method: "POST",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Loading...</h5>',
                                showConfirmButton: false,
                                onRender: function () {
                                    // there will only ever be one sweet alert open.
                                    $('.swal2-content').prepend(sweet_loader);
                                }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                tr.remove();
                                Swal.fire(
                                    'Accepted!',
                                    'Comment Has Been Accepted.',
                                    'success'
                                )
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })
        $(document).on("change", "#Status", function () {
            FilterList("Date")
        })

        function FilterList(Type) {
            $(".divLoader").show();
            $.ajax({
                url: "/QuestionPaper/FilterApproveComments?IsApproved=" + $("#Status").val() ,
                method: "POST",
                success: function (result) {
                    if (result != null) {
                        $("#DTable").DataTable().destroy();
                        $("#divPartial").html(result);
                        $("#DTable").DataTable();
                        $(".divLoader").hide();
                    }
                }, error: function (err) {
                    alert("Error" + err);
                }
            })
        }
    </script>

}

