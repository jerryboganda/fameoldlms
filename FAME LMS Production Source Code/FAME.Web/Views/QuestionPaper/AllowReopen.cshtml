@model  List<First_Aid_Made_Easy.Models.ResultVM>
@{
    ViewBag.Title = "Allow Reopen";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

    <!-- DateRangePicker -->
    <link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Allow Reopen Result List</h2>
                <p>This List Contains Incomplete List Of Papers that are not expired yet.</p>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        @{
                            int Sr = 0;
                        }
                        <table id="DTable" class="table  table-bordered">
                            <thead>
                                <tr style="background-color: #364e9c">
                                    <th>Email</th>
                                    <th>Paper Name</th>
                                    <th>Attempted On</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model)
                                {
                                    Sr++;
                                    <tr>
                                        <td>@i.StudentID</td>
                                        <td>@i.PaperTitle</td>
                                        <td>@string.Format("{0:dd/MM/yyy hh:mm tt}", i.Datetime)</td>
                                        <td>@(i.IsComplete ? "Completed" : "Incompleted" )</td>
                                        <td>
                                            @if (i.AllowReopen == true)
                                            {
                                                <a href="#" class="text-success"><i class="fa fa-check-circle Font20"></i></a>
                                            }
                                            else
                                            {
                                                <a href="#" data-id="@i.ID" id="btnAccept" vlaue="" class="text-warning"><i class="fa fa-check-circle Font20"></i></a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable();
        })

        $(document).on("click", "#btnAccept", function () {
            var id = $(this).data('id');
            var btn = $(this);
            Swal.fire({
                title: 'Are you sure?',
                text: "Are You Sure You Want To allow to reopen ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/QuestionPaper/Allow/" + id,
                        method: "POST",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Loading...</h5>',
                                showConfirmButton: false,
                                onRender: function () {
                                    // there will only ever be one sweet alert open.
                                    $('.swal2-content').prepend(sweet_loader);
                                }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                btn.hide();
                                Swal.fire(
                                    'Success!',
                                    'Successfully Allowed To Reopen.',
                                    'success'
                                )
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })

    </script>

}

