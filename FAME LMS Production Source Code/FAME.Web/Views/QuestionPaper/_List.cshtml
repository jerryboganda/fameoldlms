@model First_Aid_Made_Easy.Models.QuestionPaperVM
@using First_Aid_Made_Easy.BLL
@{
    int Sr = 0;
}
<table style="width:100% !important" id="DTable" class="table table-bordered">
    <thead>
        <tr style="background-color: #364e9c">
            <th>Sr.</th>
            <th>Pic</th>
            <th>Title</th>
            <th>Time</th>
            <th>Expiry Time</th>
            <th>Mock Test</th>
            <th>Questions</th>
            <th style="min-width:80px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.List)
        {
            Sr++;
            <tr>
                <td>@Sr</td>
                <td> <img style="width:50px;height:50px" src="@Url.Content("~/Images/"+i.Thumbnail)" /> </td>
                <td>@i.PaperTitle</td>
                <td>@i.Time</td>
                <td>@(i.ExpiryDT == null ? "No Expiry": string.Format("{0:dd/MM/yyyy hh:mm tt}", i.ExpiryDT))</td>
                <td>@i.MockTestType</td>
                <td>@i.Questions</td>
                <td>
                    <a href="/QuestionPaper/Index/@i.PaperID" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>|
                    <a href="/QuestionPaper/Preview/@i.PaperID" vlaue="" class="text-info"><i class="fa fa-eye Font20"></i></a>|
                    <a href="javascript:;" id="btnRowDelete" data-name="Question Paper" data-url="/QuestionPaper/Delete/@i.PaperID" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>