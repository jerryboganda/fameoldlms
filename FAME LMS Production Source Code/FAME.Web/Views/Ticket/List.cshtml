@model First_Aid_Made_Easy.Models.TicketVM
@{
	Layout = "~/Views/Shared/_LayoutAgent.cshtml";

	ViewBag.Title = "Ticket List";
}

<!-- DateRangePicker -->
<link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Ticket List</h2>
				<ol class="breadcrumb p-0 m-0">
					<li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
					<li class="breadcrumb-item active">
						Ticket List
					</li>
				</ol>
			</div>
		</div>
	</div>


	<div class="page-section border-bottom-2">
		<div style="margin: 0; max-width: 100%" class="container-fluid page__container">
			<div class="row">
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Search Filters</div>
					</div>
					<div style="margin-top:20px">
						<div class="row">
							<div class="col-md-4">
								<label>Date Range</label>
								<input id="dateRange" type="text" class="form-control" data-daterangepicker-locale-format="DD/MM/YYYY" placeholder="Select A Date Range" data-toggle="daterangepicker" data-daterangepicker-ranges="true" data-daterangepicker-drops="down">
							</div>
							<div class="col-md-2">
								<label>Status</label>
								@Html.DropDownListFor(model => model.Status, new SelectList(First_Aid_Made_Easy.BLL.Common.Status, "Value", "Text"), "Please Select", new { @class = "form-control select2", @required = "required", @data_toggle = "select" })
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Basic Information</div>
					</div>
					<div class="table-responsive" style="margin-top:20px" id="divPartial">
						@Html.Partial("_List")
					</div>
				</div>
			</div>
		</div>
	</div>
</div>



@section scripts {
	<!-- DateRangePicker -->
	<script src="~/Content/assets/vendor/moment.min.js"></script>
	<script src="~/Content/assets/vendor/daterangepicker.js"></script>
	<script src="~/Content/assets/js/daterangepicker.js"></script>
	@Scripts.Render("~/Scripts/List")

	@if (TempData["Success"] != null)
	{
		<script>
			toastr.success("Data Saved Successfully");
		</script>
	}

	<script>
		$(document).ready(function () {
			$("#DTable").DataTable();
		})

		$(document).on("click", "#btnClose", function () {
			var tr = $(this).closest("tr");
			var id = $(this).data("id");
			Swal.fire({
				title: 'Are you sure?',
				text: "You Want To Close the Ticket ?",
				icon: 'warning',
				showCancelButton: false,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Yes!'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "/Ticket/Close/" + id + "?Status=Close",
						method: "GET",
						beforeSend: function () {
							swal.fire({
								html: '<h5>Closing Ticket...</h5>',
								showConfirmButton: false,
								onRender: function () { $('.swal2-content').prepend(sweet_loader); }
							});
						},
						success: function (result) {
							if (result) {
								Swal.fire(
									'Closed!',
									'The Ticket  Has Been Closed.',
									'success'
								)
								tr.remove();
							}
						}, error: function (err) {
							alert("Error" + err);
						}
					})

				}
			})
		})

		$(document).on("change", "#Status", function () {
			FilterList("Status")
		})

		$(document).on("change", "#dateRange", function () {
			FilterList("Date")
		})

		function FilterList(Type) {
			var Status = "", DateFrom = "", DateTo = "";

			Status = $("#Status option:selected").val() || "";

			if (Type == "Date") {
				var range = $("#dateRange").val();
				var Dates = range.split(" to ");
				DateFrom = Dates[0];
				DateTo = Dates[1];
			}

			$(".divLoader").show();
			$.ajax({
				url: "/Ticket/Filter?Status=" + Status + "&DateFrom=" + DateFrom + "&DateTo=" + DateTo,
				method: "POST",
				success: function (result) {
					if (result != null) {
						$("#DTable").DataTable().destroy();
						$("#divPartial").html(result);
						$(".divLoader").hide();
					}
				}, error: function (err) {
					alert("Error" + err);
				}
			})
		}
	</script>

}

