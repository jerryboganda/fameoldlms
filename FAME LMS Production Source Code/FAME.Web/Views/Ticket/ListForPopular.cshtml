@model First_Aid_Made_Easy.Models.TicketVM
@using First_Aid_Made_Easy.BLL
@{ if (User.IsInRole("SuppAgent"))
    {
        Layout = "~/Views/Shared/_LayoutAgent.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    }

    ViewBag.Title = "Popular Tickets";
    int Sr = 0;
}

<!-- DateRangePicker -->
<link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Ticket List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Popular Tickets
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div style="display: none" class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Search Filters</div>
                    </div>
                    <div style="margin-top:20px;">
                        <div class="row">
                            <div class="col-md-4">
                                <label>Date Range</label>
                                <input id="dateRange" type="text" class="form-control" data-daterangepicker-locale-format="DD/MM/YYYY" placeholder="Select A Date Range" data-toggle="daterangepicker" data-daterangepicker-ranges="true" data-daterangepicker-drops="down">
                            </div>
                            <div class="col-md-2">
                                <label>Status</label>
                                @Html.DropDownListFor(model => model.Status, new SelectList(First_Aid_Made_Easy.BLL.Common.Status, "Value", "Text"), "Please Select", new { @class = "form-control select2", @required = "required", @data_toggle = "select" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic Information</div>
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        <table style="width:100% !important" id="DTable" class="table table-bordered">
                            <thead>
                                <tr style="background-color: #364e9c">
                                    <th>Sr.</th>
                                    <th>Student</th>
                                    <th>Subject</th>
                                    <th>Category</th>
                                    <th style="min-width:80px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.List)
                                {
                                    Sr++;
                                    <tr>
                                        <td>@Sr</td>
                                        <td>@i.TicketFrom</td>
                                        <td>@i.Subject</td>
                                        <td>@i.Category</td>
                                        <td>
                                            @if (i.IsPopular == true)
                                            {
                                                <a href="javascript:;" id="btnStatus" data-status="false" data-id="@i.Ticket_ID" class="btn btn-danger">Not Popular</a>
                                            }
                                            else
                                            {
                                                <a href="javascript:;" id="btnStatus" data-status="true" data-id="@i.Ticket_ID" class="btn btn-success">Popular</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable({ "lengthMenu": [[-1, 25, 50, 100], ["All", 25, 50, 100]] });
            //$(document).find("#DTable_wrapper").css("display", "");
        })

        $(document).on("click", "#btnStatus", function () {
            var tr = $(this).closest("tr");
            var id = $(this).data("id");
            var btn = $(this);
            var status = $(this).data("status");
            var Action = status == true ? "popular" : "not popular";
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to make ticket " + Action + " ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Ticket/ChagePopular/" + id + "?isPopular=" + status,
                        method: "GET",
                        success: function (result) {
                            if (result) {
                                Swal.fire(
                                    'Done!',
                                    'Changes Made Successfully.',
                                    'success'
                                )
                                btn.hide();
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })
    </script>

}

