@model First_Aid_Made_Easy.Models.QuestionVM
@{
	ViewBag.Title = "Request";
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

	var Type = Model.TypeS;
	ViewBag.Title = Type + " List";
}

<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">@Type List</h2>
				<ol class="breadcrumb p-0 m-0">
					<li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
					<li class="breadcrumb-item active">
						@Type List
					</li>
				</ol>
			</div>
		</div>
	</div>


	<div class="page-section border-bottom-2">
		<div style="margin: 0; max-width: 100%" class="container-fluid page__container">
			<div class="row">
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Search Filters</div>
					</div>
					<div style="margin-top:20px">
						<div class="row">
							<div class="col-md-3" style="display:none">
								<label>Tags</label>
								<input id="Tags" type="text" class="form-control tags" placeholder="Tags">
							</div>
							<div class="col-md-3" style="display:none">
								<label>Text</label>
								<input id="Text" type="text" class="form-control" placeholder="Text">
							</div>
							<div class="col-md-6">
								<label>System</label>
								@Html.DropDownListFor(model => model.SystemID, new SelectList(ViewBag.Systems, "ID", "Name"), "Please Select", new { @class = "form-control select2", @required = true })
							</div>
							<div class="col-md-3">
								<label>Partitions</label>
								@Html.DropDownListFor(model => model.PartitionID, new SelectList(ViewBag.Partitions, "ID", "Name"), "Please Select", new { @class = "form-control select2", @required = "required", @data_toggle = "select" })
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Basic Information</div>
					</div>
					<div class="table-responsive" style="margin-top:20px" id="divPartial">
						@Html.Partial("_List")
					</div>
				</div>
			</div>
		</div>
	</div>
</div>



@section scripts {
	<!-- DateRangePicker -->
	<script src="~/Content/assets/vendor/moment.min.js"></script>
	<script src="~/Content/assets/vendor/daterangepicker.js"></script>
	<script src="~/Content/assets/js/daterangepicker.js"></script>
	@Scripts.Render("~/Scripts/List")

	@if (TempData["Success"] != null)
	{
		<script>
			toastr.success("Data Saved Successfully");
		</script>
	}

	<script>
        $(document).ready(function () {

            var SystemID = parseInt(localStorage.getItem("QuestionSystemID"));
			var PartitionID = parseInt(localStorage.getItem("QuestionPartitionID"));
            if (SystemID > 0) $("#SystemID").val(SystemID).change();
			if (PartitionID > 0) $("#PartitionID").val(PartitionID).change();
            $("#DTable").DataTable({ "lengthMenu": [[-1, 25, 50, 100], ["All", 25, 50, 100]] });
            //$(document).find("#DTable_wrapper").css("display", "");
        })


		$(document).on("change", "#PartitionID", function () {
			FilterList("PartitionID")
        })
        $(document).on("change", "#SystemID", function () {
            FilterList("SystemID")
        })
        $(document).on("keyup", "#Tags,#Text", function (e) {
            if (e.which == 13) {
                FilterList("Tags")
            }
        })
        $(document).on("change", "#Tags", function (e) {
            FilterList("Tags")
        })

        function FilterList(Type) {

			var PartitionID = $("#PartitionID").val() ||0;
            var SystemID = $("#SystemID").val() || 0;
            localStorage.setItem("QuestionSystemID", SystemID)
			localStorage.setItem("QuestionPartitionID", PartitionID)
            var Tags = $("#Tags").val() || "";
            var Text = $("#Text").val() || "";

			if (SystemID == 0) {
				Swal.fire({
					position: 'top-end',
					icon: 'success',
					title: 'Please select a System For searching Questions',
					showConfirmButton: false,
					timer: 1500
				})
				return;
			}
            $(".divLoader").show();
            $.ajax({
				url: "/Questions/FilterQuestions?Type=@Model.Type&PartitionID=" + PartitionID + "&Tags=" + Tags + "&Text=" + Text + "&SystemID=" + SystemID,
                method: "POST",
                success: function (result) {
                    if (result != null) {
                        $("#DTable").DataTable().destroy();
                        $("#divPartial").html(result);
                        $("#DTable").DataTable();
                        $(".divLoader").hide();
                    }
                }, error: function (err) {
                    alert("Error" + err);
                }
            })
        }
	</script>

}

