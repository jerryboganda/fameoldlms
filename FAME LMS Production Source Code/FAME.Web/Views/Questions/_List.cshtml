@model First_Aid_Made_Easy.Models.QuestionVM
@using First_Aid_Made_Easy.BLL
@{
    int Sr = 0;
}
<table style="width:100% !important" id="DTable" class="table table-bordered">
    <thead>
        <tr style="background-color: #364e9c">
            <th >Question</th>
            <th >Partition</th>
            <th>Review By</th>
            <th style="min-width:80px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.List)
        {
            Sr++;
            <tr>
                <td> <div title="@i.Question"  class=" mw-650px limit-text">@(i.Question) </div> </td>
                <td>@i.PartitionName</td>
                <td>@i.CreatedByName</td>
                <td>
                    <a href="/Questions/Index?Type=@Model.Type&id=@i.Question_Id" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>
                    <a href="javascript:;" id="btnRowDelete" data-name="Question" data-url="/Questions/Delete/@i.Question_Id" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>