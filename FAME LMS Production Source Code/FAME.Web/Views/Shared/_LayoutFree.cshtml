    <style>
        .divLoader {
            position: fixed;
            background-color: #5e5e5e;
            z-index: 2147483647 !important;
            opacity: 0.5;
            overflow: hidden;
            text-align: center;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            padding-top: 10%;
            display: none;
        }

        div.limit-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .divLoader.show {
            display: block !important;
        }

        .show-Imp {
            display: block !important;
        }
    </style>
    <style>
        .upload-btn-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
        }

            .upload-btn-wrapper input[type="file"] {
                font-size: 80px;
                position: absolute;
                left: 0;
                top: 0;
                opacity: 0;
            }
    </style>
    <style>

