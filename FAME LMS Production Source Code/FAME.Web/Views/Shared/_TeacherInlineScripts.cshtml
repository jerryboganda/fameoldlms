    <script>

        //=======================================================
        //====== Search Boxes ( Menu Search And DB Search ) =====
        //=======================================================

        $(document).on("keyup", "#inputSearchMenu", function () {
            var html = ` <div class="dropdown-header"><strong>Available Menues</strong></div>`;
            var icon = ` <span class="material-icons sidebar-menu-icon sidebar-menu-icon--left">school</span>`;
            var Hrefs = [];
            var Text = $(this).val().toLowerCase().trim();
            if (Text.length > 1) {
                $("#MenuSearch").addClass("show");
                $("a").each(function (i, el) {
                    if ((el.text.toLowerCase().includes(Text)) && (!el.href.includes("#")) && (Hrefs.indexOf(el.href) == -1)) {
                        Hrefs.push(el.href);
                        if ($(el).html().includes('material-icons'))
                            html += ` <a class="dropdown-item limit-text" href="${el.href}">${$(el).html()}</a>`;
                        else
                            html += ` <a class="dropdown-item limit-text" href="${el.href}">${icon}${$(el).html()}</a>`;
                    }
                })
                $("#MenuSearch").html(html);
            }
            else
                $("#MenuSearch").removeClass("show").html('');
        })

        $("#inputSearchMenu").focusout(function () {
            $("#MenuSearch").removeClass("show");
        });

        $("#btnDBSearch").click(function () {
            var text = $("#inputDBSearch").val();
            if (text != "") {
                window.location.href = "/Home/DBSearch?Text=" + encodeURIComponent(text);
            }
        });
    </script>
