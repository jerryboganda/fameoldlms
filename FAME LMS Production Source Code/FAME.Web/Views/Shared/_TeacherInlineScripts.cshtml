    <script>

        $.fn.selectListToHtml = function (firstOption) {
            var selectList = this;
            var Options = '';
            if (firstOption) Options += `<option value=""> ${firstOption} </option>`;
            $.each(selectList, function (i, val) {
                Options += `<option value="${val.Value}"> ${val.Text} </option>`;
            })
            return Options;
        };
        $(document).on("click", "#btnRowDelete", function () {
            var tr = $(this).closest("tr");
            var url = $(this).data("url");
            var Name = $(this).data("name");
            Swal.fire({
                title: 'Are you sure?',
                text: "You Want To Delete the " + Name + " ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: url,
                        method: "GET",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Deleting ' + Name + '...</h5>',
                                showConfirmButton: false,
                                onRender: function () { $('.swal2-content').prepend(sweet_loader); }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                tr.remove();
                                Swal.fire(
                                    'Deleted!',
                                    'The ' + Name + '  Has Been Deleted.',
                                    'success'
                                )
                            } else {
                                Swal.fire(
                                    'Sorry!',
                                    'The ' + Name + '  Has Been Used and cannot be deleted.',
                                    'warning'
                                )
                            }
                        }, error: function (err) {
                            Swal.fire(
                                'Sorry!',
                                'The ' + Name + '  Has Been Used and cannot be deleted.',
                                'warning'
                            )
                            var win = window.open("");
                            win.document.write(err.responseText);
                        }
                    })

                }
            })
        })

    </script>
    <script>

        function toggle_loader() {
            $('.divLoader').toggleClass('show');
        }

        function DataSaved() {
            Swal.fire({
                position: 'top-end',
                icon: 'success',
                title: 'Data Saved Successfully',
                showConfirmButton: false,
                timer: 1500
            })
        }
    </script>
    <script>
        // http://bootstrap-tagsinput.github.io/bootstrap-tagsinput/examples/

        $(document).ready(function () {
            $('.select2').select2();
            $('.tags').tagsinput({
                trimValue: true,
                confirmKeys: [13, 44],
                focusClass: 'my-focus-class'
            });

            $('.bootstrap-tagsinput input').on('focus', function () {
                $(this).closest('.bootstrap-tagsinput').addClass('has-focus');
            }).on('blur', function () {
                $(this).closest('.bootstrap-tagsinput').removeClass('has-focus');
            });

        });

    </script>

