                </a>
            </li>
            <li class="fame-nav-item">
                <a href="@Url.Action("MyProgress", "Student")" class="fame-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "MyProgress" ? "active" : "")">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
