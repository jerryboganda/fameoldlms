                        <circle cx="12" cy="12" r="10"></circle>
                        <polygon points="10 8 16 12 10 16 10 8"></polygon>
                    </svg>
                    <span>My Courses</span>
                </a>
            </li>
            <li class="fame-nav-item">
                <a href="@Url.Action("MyMeetings", "Student")" class="fame-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "MyMeetings" ? "active" : "")">
