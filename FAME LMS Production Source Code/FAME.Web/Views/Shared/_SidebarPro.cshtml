                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span>Progress Tracker</span>
                </a>
            </li>
            <li class="fame-nav-item">
                <a href="@Url.Action("Index", "Student", new { area = "Certificate" })" class="fame-nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "Certificate" && ViewContext.RouteData.Values["controller"]?.ToString() == "Student" ? "active" : "")">
