            <li class="fame-nav-item">
                <a href="@Url.Action("SupportOverView", "Home")" class="fame-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "SupportOverView" && ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
