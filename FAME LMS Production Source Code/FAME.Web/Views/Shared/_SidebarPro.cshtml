@* FAME Student Dashboard 2026: Mobile-First Sidebar *@
<!-- Mobile Overlay -->
<div class="fame-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<div class="fame-sidebar" id="fameSidebar">
    <div class="fame-sidebar-logo">
        <img src="@Url.Content("~/Images/FAME_Logo_Final.png")" alt="First Aid Made Easy" />
        <button type="button" class="fame-sidebar-close" onclick="toggleSidebar()" aria-label="Close menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <nav class="fame-nav-menu" aria-label="Main navigation">
        <ul>
            <li class="fame-nav-item">
                <a href="@Url.Action("Index", "Student")" class="fame-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Index" && ViewContext.RouteData.Values["controller"].ToString() == "Student" ? "active" : "")">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Dashboard</span>
                </a>
            </li>
            
            <li style="padding: 16px 14px 8px; font-size: 0.6875rem; font-weight: 700; color: var(--fame-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Learning</li>

            <li class="fame-nav-item">
                <a href="@Url.Action("MyCourses", "Student")" class="fame-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "MyCourses" ? "active" : "")">
