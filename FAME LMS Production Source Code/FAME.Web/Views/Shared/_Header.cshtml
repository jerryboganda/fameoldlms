                {
                    foreach (var b in ViewBag.BreadCrumb)
                    {
                        <li class="breadcrumb-item text-muted">@b</li>
                    }
                }
            </ul>
            <!--end::Breadcrumb-->
        </div>
        <!--end::Page title=-->
