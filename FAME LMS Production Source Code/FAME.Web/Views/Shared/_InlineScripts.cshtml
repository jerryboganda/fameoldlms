    <!--=================================================-->
    <!--========= Check Unseen Notifications ============-->
    <!--=================================================-->
    @if ((bool?)ViewBag.ShowNotification == true)
    {
        <script>
            $(document).ready(function () {
                $('.select2').select2();

                $.ajax({
                    url: '/Student/CheckForNotification',
                    success: function (response) {
                        if (response != null) {
                            ShowPopup(response);
                        }
                    },
                    error: function (err) {
                    }
                });
                setInterval(function () { console.clear(); }, 300000);

                $("div.limit-text").each(function () {
                    $(this).attr("title", $(this).text());
                });
            })

            function ShowPopup(response) {
                $.each(response, function (i, val) {
                    if (val.PicturePath != null && val.PicturePath != "") {
                        Swal.fire({
                            title: val.MessageTitle,
                            html: val.MaessageBody,
                            imageUrl: '/Images/' + val.PicturePath,
                            imageWidth: 400,
                            imageHeight: 200,
                            showCloseButton: true,
                        }).then(HaveSeen(val.ID));
                    } else {
                        Swal.fire({
                            title: val.MessageTitle,
                            text: val.MaessageBody,
                            showClass: {
                                popup: 'animate__animated animate__fadeInDown'
                            },
                            hideClass: {
                                popup: 'animate__animated animate__fadeOutUp'
                            }
                        }).then(HaveSeen(val.ID));
                    }
                })
            }
            function HaveSeen(id) {
                if (id > 0) {
                    $.ajax({
                        url: '/Student/HaveSeen/' + id,
                        success: function (response) {
                            if (response == true) {
                            }
                        },
                        error: function (err) {
                        }
                    });
                }
            }

            $(function () {
                $('[data-toggle="popover"]').popover()
            })
        </script>
    }

