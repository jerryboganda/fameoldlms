    <script>
        $(document).on("keyup", ".search-element-input", function () {
            var Text = $(this).val().toLowerCase().trim();
            if (Text.length > 2) {
                $(".search-element-spinner").addClass("show-Imp")
                $.ajax({
                    url: "/General/Search?t=" + Text,
                    success: function (html) {
                        ShowContentDiv();
                        $("#search-element-results").html(html);
                        $(".search-element-spinner").removeClass("show-Imp")
                    },
                    error: function (err) {

                    }
                })
            }
            else {
                if (!$("#search-element-toggle").is(":visible"))
                    $("#search-element-content").removeClass("show");
                $("#search-element-results").html('');
            }
        })

        $(document).click(function () {
            if (!$("#search-element-toggle").is(":visible"))
                $("#search-element-content").removeClass("show");
        });
        $(document).on("click", "#search-element-toggle", function () {
            if ($("#search-element-content").hasClass('show')) {
                $("#search-element-content").removeClass("show");
            } else {
                ShowContentDiv();
            }
        });
        function ShowContentDiv() {

            $("#search-element-content").addClass("show");

            if ($("#search-element-toggle").is(":visible"))
                $("#search-element-content").css("transform", "translate(-18px, 58px)");
            else
                $("#search-element-content").css("transform", "translate(-249px, 110px)");
            $(".search-element-input:visible").focus();

        }
    </script>
