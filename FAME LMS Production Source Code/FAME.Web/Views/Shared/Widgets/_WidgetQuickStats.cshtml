@using First_Aid_Made_Easy.BLL
@using Microsoft.AspNet.Identity
@using System.Linq
@{
    var courses = ViewBag.Courses as IEnumerable<dynamic>;
    var liveClasses = ViewBag.LiveClasses as IEnumerable<dynamic>;
    var enrollment = ViewBag.Enrollment as dynamic;
    var enrolls = ViewBag.Enrolls as IEnumerable<dynamic>;
    
    int courseCount = courses?.Count() ?? 0;
    int liveCount = liveClasses?.Count() ?? 0;
    
    // Calculate overall progress
    int overallProgress = 0;
    if (courses != null && courses.Any())
    {
        try
        {
            var progressValues = courses.Where(c => c.Progress != null).Select(c => (int)c.Progress);
            if (progressValues.Any()) 
            {
                overallProgress = (int)progressValues.Average();
            }
        }
        catch { }
    }
    
    // Calculate days remaining
    int daysRemaining = 0;
    if (enrollment?.Enrollment_EndDate != null)
    {
        try { daysRemaining = Math.Max(0, ((DateTime)enrollment.Enrollment_EndDate - DateTime.Now).Days); }
        catch { }
    }
    
    // Get completed tests count (placeholder - would come from controller)
    int testsCompleted = 0;
    try { testsCompleted = enrolls?.Count() ?? 0; } catch { }
}

<div class="fame-stats-grid-pro">
    <!-- Courses -->
    <div class="fame-stat-card-pro">
        <div class="fame-stat-icon-wrap gradient-primary">
            <i data-feather="book-open"></i>
        </div>
        <div class="fame-stat-details">
            <div class="fame-stat-value-pro">@courseCount</div>
            <div class="fame-stat-label-pro">Enrolled Courses</div>
        </div>
        <div class="fame-stat-trend">
            <i data-feather="arrow-up-right" style="width: 14px; height: 14px;"></i>
        </div>
    </div>
    
    <!-- Progress -->
    <div class="fame-stat-card-pro">
        <div class="fame-stat-icon-wrap gradient-success">
            <i data-feather="trending-up"></i>
        </div>
        <div class="fame-stat-details">
            <div class="fame-stat-value-pro">@overallProgress<span class="fame-stat-unit">%</span></div>
            <div class="fame-stat-label-pro">Overall Progress</div>
        </div>
        <div class="fame-stat-ring">
            <svg viewBox="0 0 36 36">
                <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                <path class="ring-progress" stroke-dasharray="@overallProgress, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
            </svg>
        </div>
    </div>
    
    <!-- Live Classes -->
    <div class="fame-stat-card-pro">
        <div class="fame-stat-icon-wrap gradient-danger">
            <i data-feather="video"></i>
            @if (liveCount > 0)
            {
                <span class="fame-stat-pulse"></span>
            }
        </div>
        <div class="fame-stat-details">
            <div class="fame-stat-value-pro">@liveCount</div>
            <div class="fame-stat-label-pro">Live Classes</div>
        </div>
        @if (liveCount > 0)
        {
            <a href="@Url.Action("MyMeetings", "Student")" class="fame-stat-action">Join</a>
        }
    </div>
    
    <!-- Subscription -->
    <div class="fame-stat-card-pro @(daysRemaining <= 7 ? "fame-stat-warning" : "")">
        <div class="fame-stat-icon-wrap @(daysRemaining <= 7 ? "gradient-warning" : "gradient-info")">
            <i data-feather="calendar"></i>
        </div>
        <div class="fame-stat-details">
            <div class="fame-stat-value-pro">@daysRemaining</div>
            <div class="fame-stat-label-pro">Days Remaining</div>
        </div>
        @if (daysRemaining <= 7)
        {
            <span class="fame-stat-badge warning">Renew Soon</span>
        }
    </div>
</div>

<style>
.fame-stats-grid-pro {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: var(--fame-space-lg);
}

.fame-stat-card-pro {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    background: var(--fame-bg-secondary);
    border: 1px solid var(--fame-border);
    border-radius: var(--fame-radius-xl);
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
}

.fame-stat-card-pro::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--fame-primary), var(--fame-secondary));
    opacity: 0;
    transition: opacity 300ms;
}

.fame-stat-card-pro:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
}

.fame-stat-card-pro:hover::before {
    opacity: 1;
}

.fame-stat-icon-wrap {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: var(--fame-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.fame-stat-icon-wrap i,
.fame-stat-icon-wrap svg {
    width: 24px;
    height: 24px;
    color: white;
}

.gradient-primary { background: linear-gradient(135deg, #6366F1, #8B5CF6); }
.gradient-success { background: linear-gradient(135deg, #10B981, #059669); }
.gradient-danger { background: linear-gradient(135deg, #EF4444, #DC2626); }
.gradient-warning { background: linear-gradient(135deg, #F59E0B, #D97706); }
.gradient-info { background: linear-gradient(135deg, #3B82F6, #2563EB); }

.fame-stat-pulse {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 10px;
    height: 10px;
    background: #22C55E;
    border: 2px solid var(--fame-bg-secondary);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
}

.fame-stat-details {
    flex: 1;
    min-width: 0;
}

.fame-stat-value-pro {
    font-size: 28px;
    font-weight: 700;
    color: var(--fame-text-primary);
    line-height: 1.1;
    margin-bottom: 4px;
}

.fame-stat-unit {
    font-size: 16px;
    font-weight: 600;
    color: var(--fame-text-tertiary);
}

.fame-stat-label-pro {
    font-size: 13px;
    color: var(--fame-text-tertiary);
    font-weight: 500;
}

.fame-stat-trend {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.1);
    color: #10B981;
    display: flex;
    align-items: center;
    justify-content: center;
}

.fame-stat-ring {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
}

.fame-stat-ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
}

.fame-stat-ring .ring-bg {
    fill: none;
    stroke: var(--fame-bg-tertiary);
    stroke-width: 3;
}

.fame-stat-ring .ring-progress {
    fill: none;
    stroke: #10B981;
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke-dasharray 1s ease-out;
}

.fame-stat-action {
    padding: 6px 14px;
    background: linear-gradient(135deg, #EF4444, #DC2626);
    color: white;
    font-size: 12px;
    font-weight: 600;
    border-radius: 20px;
    text-decoration: none;
    transition: all 200ms;
}

.fame-stat-action:hover {
    transform: scale(1.05);
}

.fame-stat-badge {
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    border-radius: 12px;
}

.fame-stat-badge.warning {
    background: rgba(245, 158, 11, 0.15);
    color: #D97706;
}

.fame-stat-warning {
    border-color: rgba(245, 158, 11, 0.3);
}

@@media (max-width: 1200px) {
    .fame-stats-grid-pro {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 640px) {
    .fame-stats-grid-pro {
        grid-template-columns: 1fr;
    }
    
    .fame-stat-card-pro {
        padding: 20px;
    }
}
</style>
