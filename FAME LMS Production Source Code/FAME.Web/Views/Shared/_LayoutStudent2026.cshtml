<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover">
    <meta name="theme-color" content="#0F766E" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>@ViewBag.Title - FAME Student Panel</title>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Bootstrap 5 (CDN for utility classes) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- FAME 2026 Mobile-First CSS -->
    <link href="@Url.Content("~/Content/fame-student-2026.css?v=" + DateTime.Now.Ticks)" rel="stylesheet" />
    
    <!-- Critical Mobile Styles (Inline for performance) -->
    <style>
        /* Prevent layout shift while loading */
        body { opacity: 1; }
        .fame-app-wrapper { min-height: 100vh; min-height: 100dvh; }
    </style>
    @Html.Partial("_TrackingPixels")
</head>
<body>
    <div class="fame-app-wrapper">
        <!-- Sidebar (Mobile Drawer) -->
        @Html.Partial("_SidebarPro")

        <!-- Main Content Area -->
        <main class="fame-main-content">
            <!-- Header with Mobile Toggle -->
            @Html.Partial("_HeaderPro")

            <!-- Page Content -->
            <div class="fame-container">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Disable zoom on double-tap for better mobile UX
        document.addEventListener('touchend', function(e) {
            var now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                e.preventDefault();
            }
            lastTouchEnd = now;
        }, false);
        var lastTouchEnd = 0;
        
        // Smooth scroll behavior
        document.documentElement.style.scrollBehavior = 'smooth';
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>