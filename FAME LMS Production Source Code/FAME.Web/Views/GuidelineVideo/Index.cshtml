@model First_Aid_Made_Easy.Models.GuidelineVideoVM
@{
    ViewBag.Title = "Guideline Videos Management";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Guideline Videos Management</h3>
            </div>
            <div class="panel-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <select class="form-control" id="packageFilter" onchange="filterByPackage()">
                            <option value="">All Packages</option>
                            @foreach (var pkg in ViewBag.Packages)
                            {
                                <option value="@pkg.PackageID" @(ViewBag.SelectedPackageId == pkg.PackageID ? "selected" : "")>@pkg.PackageName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-8 text-right">
                        <a href="@Url.Action("Save", new { packageId = ViewBag.SelectedPackageId })" class="btn btn-success">
                            <i class="fa fa-plus"></i> Add Guideline Video
                        </a>
                    </div>
                </div>

                @if (Model.List != null && Model.List.Count > 0)
                {
                    <table class= "table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Package</th>
                                <th>Video Title</th>
                                <th>Description</th>
                                <th>Sort Order</th>
                                <th>Status</th>
                                <th width="150">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var video in Model.List)
                            {
                                <tr>
                                    <td>@video.PackageName</td>
                                    <td>@video.VideoTitle</td>
                                    <td>@(string.IsNullOrEmpty(video.VideoDescription) ? "-" : video.VideoDescription)</td>
                                    <td>@video.SortOrder</td>
                                    <td>
                                        @if (video.IsActive)
                                        {
                                            <span class="label label-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Save", new { id = video.GuidelineVideoID })" class="btn btn-sm btn-primary">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = video.GuidelineVideoID })" 
                                           class="btn btn-sm btn-danger" 
                                           onclick="return confirm('Are you sure you want to delete this guideline video?')">
                                            <i class="fa fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i> No guideline videos found. Click "Add Guideline Video" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function filterByPackage() {
        var packageId = $('#packageFilter').val();
        var url = '@Url.Action("Index")';
        if (packageId) {
            url += '?packageId=' + packageId;
        }
        window.location.href = url;
    }
</script>
