@model First_Aid_Made_Easy.Models.SectionSubVM
@{
    ViewBag.Title = "Course Save";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}




<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Edit Course</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Define Sub Section
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="page-section border-bottom-2">
    <div class="container-fluid page__container">

        <div class="row">
            <div class="col-md-12">

                <div class="page-separator">
                    <div class="page-separator__text">Basic information</div>
                </div>
                @Html.ValidationSummary("", new { @class = "text-danger" })
                <form action="/Course/SectionSubIndex" method="post">
                    @Html.HiddenFor(model => model.ID)
                    @Html.HiddenFor(model => model.Course_Fid)
                    @Html.HiddenFor(model => model.Section_Fid)
                    <label class="form-label">Sub Section title</label>
                    <div class="form-group mb-24pt">
                        @Html.TextBoxFor(model => model.SectionSub_Name, new { @class = "form-control form-control-lg", @placeholder = "Section Title", @required = "required" })
                        <small class="form-text text-muted"></small>
                    </div>
                    <div class="card">
                        <div class="card-header text-center">
                            <div class="card-header text-center">
                                <a href="@Url.Action("SectionSubIndex","Course",new {id=0,CourseFid = Model.Course_Fid })" class="btn btn-outline-accent-electric-violet"><i class="fa fa-recycle"></i>&nbsp; New</a>
                                @if (Model.ID > 0)
                                {
                                    <input type="submit" class="btn btn-outline-accent-red" value="Update" />
                                    <a href="javascript:;" id="btnDelete" data-name="@Model.SectionSub_Name" data-id="@Model.ID" class="btn btn-outline-accent-red"><i class="fa fa-trash"></i>&nbsp;  Delete</a>
                                }
                                else
                                {
                                    <input type="submit" class="btn btn-outline-success" value="Save" />
                                }
                                <a href="@Url.Action("SectionSubIndex","Course",new { id = Model.Course_Fid })" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i>&nbsp; Back To Course</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            position: 'top-end',
            icon: 'success',
            title: 'Data Saved Successfully',
            showConfirmButton: false,
            timer: 1500
        })
    </script>
}
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    $(document).on("click", "#btnDelete", function () {
        var btn = $(this);
        var id = btn.data("id");
        var Name = btn.data("name");
        Swal.fire({
            title: 'Are you sure?',
            text: "You Want To Delete the Section '" + Name + "' ?",
            icon: 'warning',
            showCancelButton: false,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "/Course/DeleteSectionSub/" + id,
                    method: "GET",
                    beforeSend: function () {
                        swal.fire({
                            html: '<h5>Deleting Section...</h5>',
                            showConfirmButton: false,
                            onRender: function () {
                                // there will only ever be one sweet alert open.
                                $('.swal2-content').prepend(sweet_loader);
                            }
                        });
                    },
                    success: function (result) {
                        if (result) {
                            btn.hide();
                            Swal.fire(
                                'Delete!',
                                'The Section ' + Name +' Has Been Deleted.',
                                'success'
                            )
                            window.location.href = "/Course/CourseIndex/@Model.Course_Fid";
                        }
                    }, error: function (err) {
                        alert("Error" + err);
                    }
                })

            }
        })
    })
    </script>

}