@model First_Aid_Made_Easy.Models.CourseVM
@{
	ViewBag.Title = "Course Preview";
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
	int i = 0;
	var sid = Request.QueryString["sectionID"];
}

<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center">
			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Edit Course</h2>
				<ol class="breadcrumb p-0 m-0">
					<li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
					<li class="breadcrumb-item active">
						Edit Course
					</li>
				</ol>
			</div>
		</div>
		<div class="ml-lg-16pt">
			<a href="/Course/Courses" class="btn btn-light">Back</a>
		</div>
		<div class="ml-lg-16pt">
			<a href="/Teacher/CoursePreview/@Model.Course_Id" class="btn btn-light">Preview</a>
		</div>
	</div>
</div>


<div class="page-section border-bottom-2">
	<div class=" page__container">
		<div class="row">
			<div class="col-md-8">
				<div class="page-separator">
					<div class="page-separator__text">Sections</div>
				</div>
				<div class="accordion js-accordion accordion--boxed mb-24pt" id="parent">
					@foreach (var s in Model.SectionList)
					{
						i++;
						<div id="sec-@s.Section_ID" class="accordion__item @(s.Section_ID.ToString() == sid ? "open" : "")">
							<a href="#" class="accordion__toggle" data-toggle="collapse" data-target="#course-toc-@i" data-parent="#parent">
								<span class="flex">@s.Section_Name</span>
								<span class="accordion__toggle-icon material-icons">keyboard_arrow_down</span>
							</a>
							<div class="accordion__menu collapse course-toc @(s.Section_ID.ToString() == sid ? "show" : "")" id="course-toc-@i">

								@foreach (var sub in s.SectionSubList)
								{
									<div id="subsec-@sub.ID" class="accordion__item" style="margin-left:50px;margin-right:50px">
										<a href="#" class="accordion__toggle" data-toggle="collapse" data-target="#sub-toc-@sub.ID" data-parent="#course-toc-@i">
											<span class="flex">@sub.SectionSub_Name</span>
											<span class="accordion__toggle-icon material-icons">keyboard_arrow_down</span>
										</a>
										<div class="accordion__menu collapse course-toc" id="sub-toc-@sub.ID">
											@foreach (var v in sub.VideoList)
											{
												<div id="@v.Video_Id" class="accordion__menu-link">
													<i class="material-icons text-70 icon-16pt icon--left">drag_handle</i>
													<a class="flex" href="@Url.Action("VideoIndex","Course", new {id = v.Video_Id,ContentType=v.Type??1 })">@v.Video_Name</a>
													<span class="text-muted">(@v.TypeS) @v.Video_Length m</span>
												</div>
											}

											<div class="accordion__menu-link">
												<a class="btn btn-outline-primary" href="@Url.Action("SectionSubIndex", "Course", new {id = sub.ID, SectionFid = s.Section_ID})">Edit Sub-Section</a>
												<a class="btn btn-outline-primary" href="@Url.Action("VideoIndex", "Course", new {id = 0, SectionFid = s.Section_ID, SectionSubId = sub.ID, ContentType = 1})">Add Video</a>
												<a class="btn btn-outline-primary" onclick="ShowCopyModal(@sub.Section_Fid , @sub.ID, @s.Course_Fid)" href="javascript:;">Copy Videos</a>
											</div>
										</div>
									</div>
								}

								@foreach (var v in s.VideoList)
								{
									<div id="@v.Video_Id" class="accordion__menu-link">
										<i class="material-icons text-70 icon-16pt icon--left">drag_handle</i>
										<a class="flex" href="@Url.Action("VideoIndex","Course",new {id=v.Video_Id,ContentType=v.Type??1 })">@v.Video_Name</a>
										<span class="text-muted">(@v.TypeS)  @v.Video_Length m</span>
									</div>
								}


								<div class="accordion__menu-link">
									<a class="btn btn-outline-primary" href="@Url.Action("SectionIndex", "Course", new {id = s.Section_ID, CourseFid = s.Course_Fid})">Edit Section</a>
									<a class="btn btn-outline-primary" href="@Url.Action("VideoIndex", "Course", new {id = 0, SectionFid = s.Section_ID, ContentType = 1})">Add Video</a>
									<a class="btn btn-outline-primary" href="@Url.Action("SectionSubIndex", "Course", new {id = 0, SectionFid = s.Section_ID})">Add Sub-Section</a>
									<a class="btn btn-outline-primary" onclick="ShowCopyModal(@s.Section_ID,null, @s.Course_Fid)" href="javascript:;">Copy Videos</a>
								</div>
							</div>
						</div>
					}
				</div>
				<a href="@Url.Action("SectionIndex", "Course", new {id = 0, CourseFid = Model.Course_Id})" class="btn btn-outline-secondary mb-24pt mb-sm-0">Add Section</a>
			</div>

			<div class="col-md-4">
				<div class="card">
					<div class="list-group list-group-flush">
						<div class="list-group-item">
							<a href="#" id="btn-Save-Sorting" class="text-success"><strong>Save Sorting</strong></a>
						</div>
						<div class="list-group-item d-flex">
							<a class="flex" href="/Course/CourseSave/@Model.Course_Id"><strong>Edit Course</strong></a>
							<i class="material-icons text-muted">edit</i>
						</div>
						<div class="list-group-item">
							<a href="#" class="text-danger"><strong>Delete Course</strong></a>
							<i class="material-icons text-muted">trash</i>
						</div>
					</div>
				</div>


				<div class="page-separator">
					<div class="page-separator__text">Chapters</div>
				</div>

				<div class="card">
					<div class="card-body">

						<div class="list-group list-group-flush">
							<div class="list-group-item d-flex">
								<a class="flex" href="/Course/ChapterBlog/@Model.Course_Id"><strong>Add Chapter Blog</strong></a>
								<a href="/Course/ChapterBlog/@Model.Course_Id"><i class="material-icons text-muted">add</i></a>
							</div>
							@foreach (var a in Model.ChapterList)
							{
								<div class="list-group-item d-flex">
									<a class="flex" href="/Course/ChapterBlog/@Model.Course_Id?ChapterID=@a.ChapterID"><strong>@a.Title</strong></a>
									<a href="/Course/ChapterBlog/@Model.Course_Id?ChapterID=@a.ChapterID"><i class="material-icons text-muted">edit</i></a>
								</div>
							}
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>
@section modals {


	<!-- Modal -->
	<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<div class="row">
						<div class="col-md-6">
							<label class="form-label">From Course</label>
							<div class="form-group mb-24pt">
								@Html.DropDownList("FromCourse", new SelectList(ViewBag.Courses, "Value", "Text"), "Select Course From", new { @class = "form-control  select2", @required = "required", @data_toggle = "select" })
								<div id="FromCourseVal" style="display:none" class="text-danger">Please Select Course</div>
							</div>
						</div>
						<div class="col-md-12" id="divPartial">

						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
					<button type="button" id="btnCopySelected" onclick="CopySelected()" class="btn btn-primary">Copy Selected</button>
				</div>
			</div>
		</div>
	</div>
}

@section scripts {
	@Scripts.Render("~/bundles/jqueryval")

	@if (TempData["Success"] != null)
	{
		<script>
        toastr.success("@TempData["Success"]");
		</script>
	}
	@*@Scripts.Render("~/Scripts/List")*@
	<script>
		function CopySelected() {
			var selectedValues = $(".isSelectedForCopy:checked")
				.map(function () {
					return $(this).val();
				})
				.get()
				.join(",");

			if (selectedValues) {
				$("#divLoaderid").show();
				$.ajax({
					url: "/Course/CopyVideos",
					data: {
						VideoIds: selectedValues,
						SectionId: $("#exampleModal").data('sid'),
						SectionSubID: $("#exampleModal").data('subsid'),
					},
					success: function (succ) {
						if (succ) {
							location.reload();
						} else {
							$("#divLoaderid").hide();
						}
					}, error: function () {
						$("#divLoaderid").hide();
					}
				})
			} else {
			}
		}

		function ShowCopyModal(sid,sub_sID,cid){
			$("#exampleModal")
				.attr("data-subsid", sub_sID)
				.attr("data-sid", sid)
				.modal('show');
		}

		$(document).on("change", "#FromCourse", function () {
			$("#divLoaderid").show();

			$.ajax({
				url: "/Course/GetFromCourse/" + $(this).val(),
				success: function (data) {
					$("#divPartial").html(data);
					$("#divLoaderid").hide();
				}, error: function () {
					$("#divLoaderid").hide();
				}
			})
		})
		$(document).ready(function () {
			aplly("parent", "Section");
			$(".course-toc").each(function () {
				aplly($(this).attr("id"));
			})

		});

		function aplly(id, Type) {

			var sortableOptions = {
				axis: "y", // Only allow sorting along the y-axis (up and down)
				update: function (event, ui) {
					var sortedIDs = $("#" + id).sortable("toArray");
					SaveSorting({
						Ids: sortedIDs,
						Type: Type
					})
				}
			};
			// For video containers, only allow dragging video items (those with numeric IDs), not action buttons
			if (!Type) {
				sortableOptions.items = "> div[id]:not([id^='subsec-'])";
			}
			$("#" + id).sortable(sortableOptions);
			$("#" + id).disableSelection(); // Prevent text selection while dragging
		}


		function SaveSorting(data) {
			debugger;
			$.ajax({
				url: "/Course/SaveSorting",
				data: JSON.stringify(data),
				method: 'POST',
				dataType: 'Json',
				contentType: 'application/json',
				success: function () {

				}
			})
		}

		$(document).ready(function () {
			var element = $('#sec-@sid');
			if (element.length) {
				$("html, body").animate({
					scrollTop: element.offset().top
				}, 1000); // Adjust the duration (in milliseconds) as needed
			}
		})

	</script>
}