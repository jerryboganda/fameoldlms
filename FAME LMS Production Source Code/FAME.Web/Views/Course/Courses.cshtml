@model First_Aid_Made_Easy.Models.CourseVM
@{
	Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
	ViewBag.Title = "Courses";
	Func<decimal?, string> HrsMin = First_Aid_Made_Easy.BLL.Common.HrsMins;
	int Sr = 0;
}

<div class="pt-32pt">
	<div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
		<div class="flex d-flex flex-column flex-sm-row align-items-center mb-24pt mb-md-0">

			<div class="mb-24pt mb-sm-0 mr-sm-24pt">
				<h2 class="mb-0">Courses</h2>

				<ol class="breadcrumb p-0 m-0">
					<li class="breadcrumb-item"><a href="index.html">Home</a></li>

					<li class="breadcrumb-item active">

						Courses

					</li>

				</ol>

			</div>
		</div>


		<div class="row" role="tablist">
			<div class="col-auto">
				<a href="/Course/CourseSave" class="btn btn-outline-secondary">Add Course</a>
			</div>
		</div>

	</div>

	<div class="page-section border-bottom-2">
		<div style="margin: 0;max-width: 100%" class="container-fluid page__container">
			<div class="row">
				<div class="col-md-12">
					<div class="page-separator">
						<div class="page-separator__text">Basic information</div>
					</div>
					<table id="DTable" class="table  table-bordered">
						<thead>
							<tr style="background-color: #364e9c">
								<th>Course Name</th>
								<th>Course Description</th>
								<th>No. Lectures</th>
								<th style="min-width:80px">Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var i in Model.CorList)
							{
								Sr++;
								<tr>
									<td>@i.Course_Name</td>
									<td>@i.Course_Description</td>
									<td>@i.Lessons</td>
									<td>
										<a href="/Course/CourseIndex/@i.Course_Id" vlaue="" class="text-warning"><i class="fa fa-edit Font20"></i></a>
										@*<a href="#" id="btnDelete" data-id="@i.PackageID" class="text-danger"><i class="fa fa-trash Font20"></i></a>*@
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

</div>



@section scripts {
	@Scripts.Render("~/Scripts/List")


	@if (TempData["Success"] != null)
	{
		<script>
			Swal.fire({
				position: 'top-end',
				icon: 'success',
				title: 'Data Saved Successfully',
				showConfirmButton: false,
				timer: 1500
			})
		</script>
	}

	<script>
		$(document).ready(function () {
			$("#DTable").DataTable({ "lengthMenu": [[-1, 25, 50, 100], ["All", 25, 50, 100]] });
		})

		$(document).on("click", "#btnDelete", function () {
			var id = $(this).data('id');
			var btn = $(this);
			Swal.fire({
				title: 'Are you sure?',
				text: " You Want To Delete The Package?",
				icon: 'warning',
				showCancelButton: false,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Yes!'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "/Course/Delete/" + id,
						method: "POST",
						beforeSend: function () {
							swal.fire({
								html: '<h5>Loading...</h5>',
								showConfirmButton: false,
								onRender: function () {
									// there will only ever be one sweet alert open.
									$('.swal2-content').prepend(sweet_loader);
								}
							});
						},
						success: function (result) {
							if (result) {
								btn.hide();
								Swal.fire(
									'Deletes!',
									'The Package Has Been Removed.',
									'success'
								)
								window.location.href = "/Package/List";
							}
						}, error: function (err) {
							alert("Error" + err);
						}
					})

				}
			})
		})
	</script>

}

