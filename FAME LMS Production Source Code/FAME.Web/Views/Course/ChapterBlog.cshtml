@model First_Aid_Made_Easy.Models.ChapterVM
@using System.Web.Configuration;

@{
    ViewBag.Title = "Course Save";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}


<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Chapter Notes</h2>
            </div>
        </div>
    </div>
</div>


<div class="page-section border-bottom-2">
    <div class="container-fluid page__container">
        <div class="row">
            <div class="col-md-12">
                @Html.HiddenFor(x=>x.ChapterID)
                @Html.HiddenFor(x=>x.Course_Id)
                <div class="page-separator">
                    <div class="page-separator__text">Basic information</div>
                </div>
                <div class="card">
                    <div class="form-group mb-24pt">
                        <label class="form-label">Title</label>
                        <input type="text" name="Title" id="Title" class="form-control form-control-lg" placeholder="Chapter Title" value="@Model.Title">
                        <div class="text-accent-red" id="Titleval"></div>
                    </div>
                    <textarea class="tinymce" id="tiny"></textarea>
                </div>
                <div class="card">
                    <div class="card-header text-center">
                        @if (Model.ChapterID > 0)
                        {
                            <a href="#" id="btnSave" class="btn btn-outline-success">&nbsp; Update</a>
                            <a href="#" id="btnDelete" class="btn btn-outline-danger">&nbsp; Delete</a>
                        }
                        else
                        {
                            <a href="#" id="btnSave" class="btn btn-outline-success">&nbsp; Save</a>
                        }
                        <a href="/Course/CourseIndex/@Model.Course_Id" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i> &nbsp; Back To Courses</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/tinymce/tinymce.js"></script>
    <script>


        var model = @Html.Raw(Json.Encode(Model));
        $(document).ready(function () {
            tinymce.init({
                selector: 'textarea#tiny',
                statusbar: true,
                plugins: 'code,wordcount',
                toolbar: "undo redo | styleselect | forecolor | bold italic | alignleft aligncenter alignright alignjustify | outdent indent | link image | removeformat",
                force_br_newlines: true,
                force_p_newlines: false,
                forced_root_block: '', // Needed for 3.x
                height: 500,
                init_instance_callback: function (editor) {
                    editor.on('keydown', function (e) {
                        //KeyDownEvent(e, editor);
                    });
                    editor.on('paste', function (e) {
                        //e.preventDefault();
                        //Swal.fire('Sorry!', 'Cannot Paste Here. Please Type Manualy', 'warning');
                    });
                }
            });

            $("#tiny").html(model.Content);
        })
        $(document).on("click", "#btnSave", function () {

            var result = ValidateForm();
            DetailList = [];
            if (result) {
                var data = {
                    ChapterID: $("#ChapterID").val(),
                    Course_Id: $("#Course_Id").val(),
                    Title: $("#Title").val(),
                    Content: tinyMCE.get('tiny').getContent(),
                }

                Save(data);
            }

        })
        function Save(data) {
            $("#btnSave").hide();
            $.ajax({
                url: '/Course/SaveChapter',
                method: 'POST',
                data: JSON.stringify(data),
                dataType: 'Json',
                contentType: 'application/json',
                success: function (response) {
                    if (response == true) {
                        window.location.href = "/Course/CourseIndex/@Model.Course_Id";
                    }
                },
                error: function (err) { }
            });
        }

        function ValidateForm() {

            var Title = $("#Title").val();

            if (Title == "" ) {

                if (Title == "") {
                    $("#Titleval").html("Title Is Required");
                }
                return false;
            }
            return true;
        }


    $(document).on("click", "#btnDelete", function () {
        var btn = $(this);
        var id = btn.data("id");
        var Name = btn.data("name");
        Swal.fire({
            title: 'Are you sure?',
            text: "You Want To Delete the chapter' ?",
            icon: 'warning',
            showCancelButton: false,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "/Course/DeleteChapter/" + id,
                    method: "GET",
                    beforeSend: function () {
                        swal.fire({
                            html: '<h5>Deleting chapter...</h5>',
                            showConfirmButton: false,
                            onRender: function () {
                                // there will only ever be one sweet alert open.
                                $('.swal2-content').prepend(sweet_loader);
                            }
                        });
                    },
                    success: function (result) {
                        if (result) {
                            btn.hide();
                            Swal.fire(
                                'Delete!',
                                'The chapter Has Been Deleted.',
                                'success'
                            )
                            window.location.href = "/Course/CourseIndex/@Model.Course_Id";
                        }
                    }, error: function (err) {
                        alert("Error" + err);
                    }
                })

            }
        })
    })


    </script>



}

