@model List<First_Aid_Made_Easy.Models.VideoVM>
@{
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

    ViewBag.Title = "Trial Video List";
    int Sr = 0;
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Trial Video List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Trial Video List
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        <table style="width:100% !important" id="DTable" class="table table-bordered">
                            <thead>
                                <tr style="background-color: #364e9c">
                                    <th>Sr.</th>
                                    <th>Title</th>
                                    <th style="min-width:80px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model)
                                {
                                    Sr++;
                                    <tr>
                                        <td>@Sr</td>
                                        <td>@i.Video_Name</td>
                                        <td>
                                            <a href="@Url.Action("VideoIndex","Course",new {id=i.Video_Id,SectionFid = 0,ContentType=4 })" class="text-warning"><i class="fa fa-edit Font20"></i></a>
                                            <a href="javascript:;" id="btnRowDelete" data-name="Tutorial" data-url="/Course/DeleteVideo/@i.Video_Id" class="text-danger"><i class="fa fa-trash Font20"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable({ "lengthMenu": [[-1, 25, 50, 100], ["All", 25, 50, 100]] });
            //$(document).find("#DTable_wrapper").css("display", "");
        })

    </script>

}

