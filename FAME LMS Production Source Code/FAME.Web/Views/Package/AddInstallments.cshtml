@model First_Aid_Made_Easy.Models.InstallmentVM
@{
    ViewBag.Title = "ADD Installments";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    var Duration = First_Aid_Made_Easy.BLL.Common.DurationInst;
}

<!-- Select2 -->
<link type="text/css" href="~/Content/assets/css/select2.css" rel="stylesheet">
<link type="text/css" href="~/Content/assets/vendor/select2/select2.min.css" rel="stylesheet">

<!-- DateRangePicker -->
<link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Describe Package</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Describe Installments
                    </li>
                </ol>
            </div>
        </div>
    </div>
    <div class="page-section border-bottom-2">
        <div class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <form action="/Package/Index" method="post">
                        @Html.HiddenFor(model => model.PackageDurationID)


                        <div class="row">
                            <div class="col-md-4">
                                <label style="padding:4px; background-color: #364e9c ;color:white"> <b>Total Price</b> : @Model.PackageDuration.Price </label>
                            </div>
                            <div class="col-md-4">
                                <label style="padding:4px; background-color: #364e9c ;color:white"> Total Duration : @Model.PackageDuration.DurationS </label>
                            </div>
                        </div>
                        <table id="tblDetail" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Inst No. </th>
                                    <th>Gap Duration </th>
                                    <th>Installment Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.List != null)
                                {
                                    int sr = 0;
                                    foreach (var d in Model.List)
                                    {
                                        sr++;
                                        <tr>
                                            <td>@sr</td>
                                            <td>
                                                <select class="form-control" id="Duration" name="Duration">
                                                    <option disabled selected>Please Select</option>
                                                    @foreach (var o in Duration)
                                                    {
                                                        <option @(o.Value == d.DurationS ? "selected" : "" ) value="@o.Value">@o.Text</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>@Html.TextBox("InstallmentPrice", d.InstallmentPrice, new { @class = "form-control form-control-lg", @placeholder = "Package Price Here", @required = "required" })</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="text-sm-center form-group mb-32pt">
                            <small class="form-text text-muted"><a id="btn-AddDetail" class="btn btn-success">Add Installment</a></small>
                        </div>
                        <div class="card">
                            <div class="card-header text-center">
                                <a href="#" id="btnSave" class="btn btn-outline-success">&nbsp; Save</a>
                                <a href="/Package/Index/@Model.PackageID" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i>&nbsp; Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Select2 -->
    <script src="~/Content/assets/vendor/select2/select2.min.js"></script>
    <script src="~/Content/assets/js/select2.js"></script>
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                position: 'top-end',
                icon: 'success',
                title: 'Data Saved Successfully',
                showConfirmButton: false,
                timer: 1500
            })
        </script>
    }

    <script>
        $(document).on("click", "#btn-AddDetail", function () {
            var sr = parseInt($("#tblDetail > tbody > tr").length) + 1;
            $("#tblDetail > tbody").append(`
                <tr>
                    <td>${sr}</td>
                    <td>@Html.DropDownList("Duration", new SelectList(Duration, "Value", "Text"), "Please Select", new { @class = "form-control  select2", @required = "required", @data_toggle = "select" })</td>
                    <td>@Html.TextBox("InstallmentPrice", "", new { @class = "form-control form-control-lg", @placeholder = "Package Price Here", @required = "required" })</td>
                </tr>
            `);
        })

        $(document).on("click", "#btnSave", function () {

            var result = ValidateForm();
            Durations = [];
            if (result) {

                $("#tblDetail > tbody > tr").each(function () {
                    var Duration = $(this).find("#Duration option:selected").val();
                    var Price = $(this).find("#InstallmentPrice").val();
                    if (Duration != "" && Price != "") {
                        Durations.push({
                            Duration: Duration,
                            InstallmentPrice: Price
                        })
                    }
                });
                var data = {
                    PackageDurationID: $("#PackageDurationID").val(),
                    List: Durations
                }
            }

            Save(data);

        })
        function Save(data) {
            $("#btnSave").hide();
            $.ajax({
                url: '/Package/AddInstallments',
                method: 'POST',
                data: JSON.stringify(data),
                dataType: 'Json',
                contentType: 'application/json',
                success: function (response) {
                    if (response == true) {
                        window.location.href = "/Package/Index/" + "@Model.PackageID";
                    }
                },
                error: function (err) {
                    Swal.fire({
                        position: 'top-end',
                        icon: 'error',
                        title: 'Something Went Wrong',
                        showConfirmButton: false,
                        timer: 1500
                    })
                }
            });
        }

        function ValidateForm() {

            var PackageName = $("#PackageName").val();
            var PackageDescription = $("#PackageDescription").val();
            var Course_Price = $("#Course_Price").val();

            if (PackageName == "" || PackageDescription == "" || Course_Price == "") {

                if (PackageName == "") {
                    $("#PackageNameval").html(" Package Name Is Required");
                }

                if (PackageDescription == "") {
                    $("#PackageDescriptionval").html("Package Description Is Required");
                }

                if (PackagePrice == "") {
                    $("#PackagePriceval").html("Package Price Is Required");
                }

                return false;
            }
            return true;
        }

    $(document).on("click", "#btnDelete", function () {
        var id = $(this).data('id');
        var btn = $(this);
        Swal.fire({
            title: 'Are you sure?',
            text: " You Want To Delete The Package?",
            icon: 'warning',
            showCancelButton: false,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "/Package/Deactivate/" + id,
                    method: "POST",
                    beforeSend: function () {
                        swal.fire({
                            html: '<h5>Loading...</h5>',
                            showConfirmButton: false,
                            onRender: function () {
                                // there will only ever be one sweet alert open.
                                $('.swal2-content').prepend(sweet_loader);
                            }
                        });
                    },
                    success: function (result) {
                        if (result) {
                            btn.hide();
                            Swal.fire(
                                'Deletes!',
                                'The Package Has Been Removed.',
                                'success'
                            )
                            window.location.href = "/Package/List";
                        }
                    }, error: function (err) {
                        alert("Error" + err);
                    }
                })

            }
        })
    })
    </script>

}

