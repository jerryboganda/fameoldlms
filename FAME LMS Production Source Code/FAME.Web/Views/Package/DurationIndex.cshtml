@model First_Aid_Made_Easy.Models.PackageDurationVM
@{
    ViewBag.Title = "ADD Package";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
}
}

<!-- Select2 -->
<link type="text/css" href="~/Content/assets/css/select2.css" rel="stylesheet">
<link type="text/css" href="~/Content/assets/vendor/select2/select2.min.css" rel="stylesheet">

<!-- DateRangePicker -->
<link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">Describe Duration</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        Describe Duration
                    </li>
                </ol>
            </div>
        </div>
    </div>
    <div class="page-section border-bottom-2">
        <div class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <form action="/Package/DurationIndex" method="post">
                        @Html.HiddenFor(model => model.PackageID)
                        @Html.HiddenFor(model => model.ID)
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Duration</label>
                                <div class="form-group mb-24pt">

                                    <select required class="form-control" id="Duration" name="Duration">
                                        <option disabled selected>Please Select</option>
                                        @foreach (var o in First_Aid_Made_Easy.BLL.Common.Duration)
                                        {
                                            <option @(o.Value == Model.DurationS ? "selected" : "" ) value="@o.Value">@o.Text</option>
                                        }
                                    </select>
                                    <div class="text-accent-red" id="Durationval"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Duration Price</label>
                                <div class="form-group mb-24pt">
                                    @Html.TextBoxFor(model => model.Price, new { @class = "form-control form-control-lg", @placeholder = "Package Short Description Here", @required = "required" })
                                    <div class="text-accent-red" id="Priceval"></div>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header text-center">
                                <input type="submit" id="btnSave" class="btn btn-outline-success" value=" Save">
                                <a href="/Package/Index/@Model.PackageID" class="btn btn-outline-accent-dodger-blue"><i class="fa fa-backward"></i>&nbsp; Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Select2 -->
    <script src="~/Content/assets/vendor/select2/select2.min.js"></script>
    <script src="~/Content/assets/js/select2.js"></script>
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                position: 'top-end',
                icon: 'success',
                title: 'Data Saved Successfully',
                showConfirmButton: false,
                timer: 1500
            })
        </script>
    }


}

