
@model First_Aid_Made_Easy.Models.SectionVM
@using Microsoft.AspNet.Identity
@using First_Aid_Made_Easy.BLL
@{
    ViewBag.Title = "Take Course";
    int i = 0;
}
<style>
    .video-container {
        position: relative;
    }

    .video {
        width: 100%;
        height: 100%;
    }
    #vid-cont{
        display:flex;
        align-items:center
    }
    .image {
        display: block;
        position: relative;
        background: transparent;
        z-index: 9999 !important;
        text-align: center;
        margin-left: auto;
        margin-right: auto;
        width: 80%;
        height: auto;
        opacity: 0.13;
    }

    .WaterMark {
        position: absolute;
        color: #808080 !important;
        font-size: 1.5vmin !important;
    }

    video::-webkit-media-controls-fullscreen-button {
        display: none !important;
    }

    .fullscreen-button {
        position: absolute;
        top: 2%;
        left: 90%;
        z-index: 10;
    }
</style>

<div class="page-section bg-alt border-bottom-2">
    <div class="container page__container">

        <div class="d-flex flex-column flex-lg-row align-items-center">
            <div class="d-flex flex-column flex-md-row align-items-center flex mb-16pt mb-lg-0 text-center text-md-left">
                <div class="flex">
                    <h1 class="h2 m-0">@Model.Section_Name</h1>
                </div>
            </div>
            <div class="ml-lg-16pt">
                <a href="/Student/MyCourses" class="btn btn-light">Library</a>
                <a href="/Student/DisplaySections/@Model.Course_Fid" class="btn btn-light">Back</a>
            </div>
        </div>

    </div>
</div>
<div class="page-section border-bottom-2">
    <div class="container page__container">
        <div class="row">

            @if (Model.isEnrolled && (!Model.isExpired))
            {
                <div class="col-lg-10">
                    <div class="js-player card bg-primary embed-responsive embed-responsive-16by9 mb-24pt">
                        <div class="player embed-responsive-item">
                            <div class="player__content">
                                <div class="player__image" style="--player-image: url(@Url.Content(Server.MapPath("~/Images/" + Model.Course_Name)))"></div>
                                <a href="" class="player__play bg-primary">
                                    <span class="material-icons">play_arrow</span>
                                </a>
                            </div>
                            <div id="vid-cont" class="player__embed d-none" style="position: relative;">
                                <img src="~/Images/Logo Light.png" class="image" />
                                <iframe src="#"
                                        id="MyIframe"
                                        class="embed-responsive-item"
                                        loading="lazy"
                                        style="border: none;"
                                        allow="accelerometer; gyroscope; autoplay; encrypted-media;">
                                </iframe>
                                <!-- Secure Canvas Watermark will be injected here by watermark-secure.js -->
                                <button class="fullscreen-button" onclick="toggleFullscreen()">
                                    <i class="material-icons">fullscreen</i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <p id="videoName" style="font-weight:bolder" class="lead measure-lead text-70 mb-24pt"></p>

                    <div class="mb-24pt">
                        <span class="chip chip-outline-secondary d-inline-flex align-items-center">
                            <i class="material-icons icon--left">schedule</i> <span id="VideoLenght"> </span>
                        </span>
                        <span class="chip chip-outline-secondary d-inline-flex align-items-center" onclick="toggleFullscreen()">
                            <i class="material-icons">fullscreen</i>
                            Full Screen
                        </span>
                    </div>
                </div>
            }
            <div class="col-lg-8">
                <div class="page-separator">
                    <div class="page-separator__text">Table of contents</div>
                </div>
                <div class="accordion js-accordion accordion--boxed " id="parent">
                    <div class="accordion__menu collapse show" id="course-toc-@i">
                        @foreach (var v in Model.VideoList)
                        {

                            <div class="accordion__menu-link">
                                <!-- <span class="material-icons icon-16pt icon--left text-muted">lock</span> -->
                                @if ((!Model.isEnrolled) || Model.isExpired)
                                {
                                    if (v.IsWatched)
                                    {
                                        <input name="progress" value="@v.Video_Id" class="form-check-label progress" disabled checked type="checkbox" />
                                    }
                                    else
                                    {
                                        <input name="progress" value="@v.Video_Id" class="form-check-label progress" disabled type="checkbox" />
                                    }
                                    <a href="#" class="flex btnplayVideo"><strong>&nbsp;&nbsp;@v.Video_Name</strong></a>
                                }
                                else
                                {
                                    if (v.IsWatched)
                                    {
                                        <input name="progress" value="@v.Video_Id" class="form-check-label progress" checked type="checkbox" />
                                    }
                                    else
                                    {
                                        <input name="progress" value="@v.Video_Id" class="form-check-label progress" type="checkbox" />
                                    }
                                    <a href="#" class="flex btnplayVideo" data-id="@v.Video_Id"><strong>&nbsp;&nbsp;@v.Video_Name</strong></a>
                                }
                                <span class="text-muted">
                                    <span class="material-icons icon-16pt text-black-50 mr-4pt">access_time</span>@v.Video_Length min
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                @if (Model.isEnrolled)
                {<div class="card">
                        <div class="card-body py-16pt text-center">
                            <span class="icon-holder icon-holder--outline-secondary rounded-circle d-inline-flex mb-8pt">
                                <i class="material-icons">timer</i>
                            </span>
                            <p class="card-subtitle text-70 mb-24pt">Your Subscription will Expire on</p>
                            <button type="button" class="btn btn-accent mb-8pt">@string.Format("{0:dd MMM yyyy}", Model.EndDate)</button>
                        </div>
                    </div>

                    if (Model.NextInstallment != null)
                    {
                        <div class="card">
                            <div class="card-body py-16pt text-center">
                                <span class="icon-holder icon-holder--outline-secondary rounded-circle d-inline-flex mb-8pt">
                                    <span class="material-icons">payment</span>
                                </span>
                                <p class="card-subtitle text-70 mb-24pt">Rs. @Model.InstallmentPrice</p>
                                <p class="card-subtitle text-70 mb-24pt">Your Next Installment Date Is</p>
                                <button type="button" class="btn btn-accent mb-8pt">@string.Format("{0:dd MMM yyyy}", Model.NextInstallment)</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card">
                        <div class="card-body py-16pt text-center">
                            <span class="icon-holder icon-holder--outline-secondary rounded-circle d-inline-flex mb-8pt">
                                <i class="material-icons">timer</i>
                            </span>
                            <h4 class="card-title"><strong>Unlock Section</strong></h4>
                            <p class="card-subtitle text-70 mb-24pt">Get access to all videos in This Section</p>
                            <button type="button" class="btn btn-accent mb-8pt" data-id="@Model.Section_ID" id="btnUnlockSec">Unlock - Only Rs.@Model.Section_Price/mo</button>
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>
</div>


@section scripts {
    <script>

        var SecID = @Model.Section_ID;

        $(document).ready(function () {
            $(".WaterMark").hide();
            $(".accordion__toggle").trigger("click");
            loadVideo(0);
            //showWaterMark();
        })

        $(document).ready(function () {
            $.ajax({
                url: '/Student/CheckForNotification',
                success: function (response) {
                    if (response != null) {
                        ShowPopup(response);
                    }
                },
                error: function (err) {
                }
            });
        })
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.getElementById('vid-cont').requestFullscreen();
            } else if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }

        $(".progress").change(function () {
            var el = $(this);
            videoid = el.val();
            isWatched(videoid);
        })

        $(".btnplayVideo").click(function () {
            var videoID = $(this).data().id;
            loadVideo(videoID);
        })
        function loadVideo(videoID) {
            $.ajax({
                url: "/Student/GetVideoPath",
                dataType: 'json',
                type: "GET",
                data: { VideoID: videoID, SecID: SecID},
                success: function (result) {
                    //$("#MyIframe").attr("src", result.Video_Path);
                    $("#videoName").html("<strong>" + result.Video_Name + "</strong>");
                    $("#VideoLenght").html(result.Video_Length + " min");
                    //showWaterMark();
                    @*window.history.replaceState("object or string", "Title", "/Student/DisplaySections/"+@Model.Course_Fid);*@

                    const parentNode = document.querySelector('#vid-cont');
                    const oldIframe = document.querySelector('#MyIframe');
                    const newIframe = oldIframe.cloneNode();
                    newIframe.src = result.Video_Path;
                    parentNode.replaceChild(newIframe, oldIframe);
                    $(".preloader").hide();
                }
            });
        }
        function isWatched(videoID) {

            $.ajax({
                url: "/Student/IsWatched",
                dataType: 'json',
                type: "GET",
                data: { VideoID: videoID },
                success: function (result) {
                    return;
                }
            });
        }
        function isNotWatched(videoID) {

            $.ajax({
                url: "/Student/IsNotWatched",
                dataType: 'json',
                type: "GET",
                data: { VideoID: videoID },
                success: function (result) {
                    return;
                }
            });
        }
    </script>

    <script>


        $(document).on("click", "#btnUnlockSec ", function () {
            var id = $(this).data("id");
            Enroll("ST", id);
        })
        function Enroll(For, id) {
            Swal.fire({
                title: 'Enter Your Coupon Secret',
                input: 'text',
                inputAttributes: {
                    autocapitalize: 'off'
                },
                showCancelButton: true,
                confirmButtonText: 'Submit',
                showLoaderOnConfirm: true,
                preConfirm: (login) => {
                    return fetch(`/Enrollment/Enroll/${id}?Method=CP&EnrollFor=${For}&Secret=${login}`, {
                        method: 'POST',
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText)
                            }
                            return response.json()
                        })
                        .catch(error => {
                            Swal.showValidationMessage(
                                `Request failed: ${error}`
                            )
                        })
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value == "Success") {
                        Swal.fire({
                            title: `Success`,
                            text: 'Enrollment Succefull Please Visit "Our Courses" Page.Thank You',
                        })
                        window.location.href = "/Student/MyCourses";
                    }
                    if (result.value == "Error") {
                        Swal.fire({
                            title: `Error`,
                            text: 'Sorry! Something Went Wrong',
                        })
                    }
                    if (result.value > 0) {
                        Swal.fire({
                            title: `Success`,
                            text: 'Your Amount IS Discounted by ' + result.value + "%",
                        })
                    }
                }
            })
        }

        function LoadWaterMark() {
            // Legacy function - now handled by watermark-secure.js
            return;
        }

        // Remove old interval-based watermark - now using secure canvas watermark
        // setInterval removed - watermark-secure.js handles this securely

    </script>
    
    <!-- Secure Watermark Module -->
    <script src="~/Scripts/watermark-secure.js?v=20260111-4"></script>
    <script>
        // Initialize secure watermark when video loads
        $(document).ready(function() {
            if (window.FAMEWatermark) {
                window.FAMEWatermark.init({ videoId: 0, videoName: '' });
            }
        });
        
        // Update watermark context when video changes
        var _origLoadVideo = loadVideo;
        loadVideo = function(videoID) {
            _origLoadVideo(videoID);
            setTimeout(function() {
                if (window.FAMEWatermark) {
                    window.FAMEWatermark.setVideoContext(videoID, $("#videoName").text());
                }
            }, 500);
        };
    </script>
}