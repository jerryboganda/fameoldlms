@using Microsoft.AspNet.Identity
@using First_Aid_Made_Easy.BLL
@model First_Aid_Made_Easy.Models.UserVM

@{
    Layout = "~/Views/Shared/_LayoutStudent2026.cshtml";
    ViewBag.Title = "My Profile";
    var email = User.Identity.GetUserName();
    bool IsAccepted = Common.IsRequestAccepted(User.Identity.GetUserId());
}

<style>
    .profile-card {
        background: var(--fame-bg-card);
        border: 1px solid var(--fame-border);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .profile-hero {
        background: linear-gradient(135deg, var(--fame-primary) 0%, #134e4a 100%);
        padding: 2rem 1.5rem 3.5rem;
        text-align: center;
        position: relative;
    }

    .profile-hero h3 { color: #fff; font-weight: 700; margin-bottom: 0.25rem; }
    .profile-hero p  { color: rgba(255,255,255,0.75); font-size: 0.85rem; margin: 0; }

    .profile-avatar-wrapper {
        position: relative;
        width: 110px;
        height: 110px;
        margin: 0 auto 1rem;
    }

    .profile-avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.3);
        box-shadow: 0 4px 14px rgba(0,0,0,0.2);
    }

    .profile-avatar-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 2.5rem;
        font-weight: 700;
    }

    .avatar-edit-badge {
        position: absolute;
        bottom: 2px;
        right: 2px;
        background: #fff;
        color: var(--fame-primary);
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.18);
        transition: transform 0.2s ease;
    }

    .avatar-edit-badge:hover { transform: scale(1.1); }

    .profile-nav {
        display: flex;
        border-bottom: 1px solid var(--fame-border);
        margin-top: -1.5rem;
        background: var(--fame-bg-card);
        border-radius: 16px 16px 0 0;
        position: relative;
        z-index: 2;
        padding: 0 1rem;
    }

    .profile-nav a {
        flex: 1;
        text-align: center;
        padding: 1rem 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--fame-text-muted);
        text-decoration: none;
        border-bottom: 3px solid transparent;
        transition: all 0.2s ease;
    }

    .profile-nav a.active {
        color: var(--fame-primary);
        border-bottom-color: var(--fame-primary);
    }

    .profile-nav a:hover { color: var(--fame-primary); }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--fame-text-main);
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--fame-border);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title svg {
        width: 20px;
        height: 20px;
        color: var(--fame-primary);
    }

    .form-label-fame {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--fame-text-secondary);
        margin-bottom: 0.4rem;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .form-control-fame {
        background: #f8fafc !important;
        border: 1px solid var(--fame-border) !important;
        color: var(--fame-text-main) !important;
        border-radius: 10px !important;
        padding: 0.7rem 1rem !important;
        font-size: 0.9rem !important;
        transition: all 0.2s ease !important;
    }

    .form-control-fame:focus {
        border-color: var(--fame-primary) !important;
        background: #fff !important;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1) !important;
    }

    .form-control-fame[readonly] {
        background: #eef2f6 !important;
        color: var(--fame-text-muted) !important;
        cursor: not-allowed;
    }

    .field-hint {
        font-size: 0.75rem;
        color: var(--fame-text-muted);
        margin-top: 0.3rem;
    }

    .cnic-img-preview {
        width: 120px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--fame-border);
    }

    .upload-zone {
        border: 2px dashed var(--fame-border);
        border-radius: 12px;
        padding: 1.25rem;
        text-align: center;
        background: #fafbfc;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .upload-zone:hover {
        border-color: var(--fame-primary);
        background: rgba(15, 118, 110, 0.03);
    }

    .upload-zone svg {
        width: 28px;
        height: 28px;
        color: var(--fame-text-muted);
        margin-bottom: 0.5rem;
    }

    .upload-zone p {
        font-size: 0.8rem;
        color: var(--fame-text-muted);
        margin: 0;
    }

    .btn-fame-save {
        background: var(--fame-primary);
        color: #fff;
        font-weight: 600;
        padding: 0.75rem 2.5rem;
        border-radius: 10px;
        border: none;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(15, 118, 110, 0.3);
    }

    .btn-fame-save:hover {
        background: #0d6b64;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(15, 118, 110, 0.35);
    }

    .profile-alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: #dc2626;
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    @@media (max-width: 767px) {
        .profile-hero { padding: 1.5rem 1rem 3rem; }
        .profile-avatar-wrapper { width: 90px; height: 90px; }
        .profile-nav a { font-size: 0.8rem; padding: 0.85rem 0.25rem; }
        .form-section { padding: 1.25rem !important; }
    }
</style>

@Html.ValidationSummary("", new { @class = "profile-alert", @style = "margin-bottom: 1rem;" })

<form action="/Profile/MyProfile" method="post" enctype="multipart/form-data">
    @Html.HiddenFor(x => x.User_Id)
    @Html.HiddenFor(x => x.User_Pic)
    @Html.HiddenFor(x => x.CNICFront)
    @Html.HiddenFor(x => x.CNICBack)
    @Html.HiddenFor(x => x.Type)
    @Html.HiddenFor(x => x.User_AspUser)
    @Html.HiddenFor(x => x.User_Mobile)

    <div class="profile-card mb-4">
        <!-- Hero section with avatar -->
        <div class="profile-hero">
            <div class="profile-avatar-wrapper">
                @if (!string.IsNullOrEmpty(Model.User_Pic) && Model.User_Pic != "userLogo.jpg")
                {
                    <img src="@Url.Content("~/Images/" + Model.User_Pic)" class="profile-avatar" alt="Profile" id="avatarPreview" />
                }
                else
                {
                    <div class="profile-avatar-placeholder" id="avatarPlaceholder">
                        @(Model.User_Name != null && Model.User_Name.Length > 0 ? Model.User_Name.Substring(0, 1).ToUpper() : "S")
                    </div>
                }
                <label for="User_PicFile" class="avatar-edit-badge" title="Change Photo">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                </label>
                <input type="file" name="User_PicFile" id="User_PicFile" accept=".png,.jpg,.jpeg" style="display:none;" />
            </div>
            <h3>@Model.User_Name</h3>
            <p>@email</p>
        </div>

        <!-- Tab navigation -->
        <div class="profile-nav">
            <a href="/Profile/MyProfile" class="active">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Settings
            </a>
            <a href="/Manage/ChangePassword">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Password
            </a>
        </div>
    </div>

    <!-- NRE-specific fields -->
    @if (Model.Type == (int)UserType.NRETest)
    {
        if (Model.StuCardFront == null)
        {
            <div class="profile-card mb-4">
                <div class="form-section p-4 p-md-5">
                    <div class="section-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        NRE Verification
                    </div>
                    <div class="profile-alert mb-3">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Please upload your Roll Slip / Payment Slip to verify your NRE/FCPS-1 status. Wait for Admin approval.
                    </div>
                    <label class="upload-zone d-block" for="StuCardFrontFile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <p>Click to upload Roll Slip (PNG, JPG)</p>
                        <input type="file" name="StuCardFrontFile" id="StuCardFrontFile" accept=".png,.jpg,.jpeg" style="display:none;" />
                    </label>
                </div>
            </div>
        }
        if (Model.ExamType == null)
        {
            <div class="profile-card mb-4">
                <div class="form-section p-4 p-md-5">
                    <div class="section-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        Exam Selection
                    </div>
                    <div class="profile-alert mb-3">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Please select the exam you are preparing for.
                    </div>
                    <label class="form-label-fame">Exam Type</label>
                    @Html.DropDownListFor(item => item.ExamType, new SelectList(First_Aid_Made_Easy.BLL.Common.ExamTypes, "Value", "Text"), "Select Exam", new { @class = "form-control form-control-fame" })
                    @Html.ValidationMessageFor(m => m.ExamType, "", new { @class = "text-danger small mt-1" })
                </div>
            </div>
        }
    }

    <!-- Personal Information -->
    <div class="profile-card mb-4">
        <div class="form-section p-4 p-md-5">
            <div class="section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Personal Information
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label-fame">13 Digit CNIC *</label>
                    @if (Model.CNIC == null)
                    {
                        @Html.TextBoxFor(m => m.CNIC, new { @class = "form-control form-control-fame", @placeholder = "3410XXXXXXXXX", @maxlength = "13" })
                        @Html.ValidationMessageFor(m => m.CNIC, "", new { @class = "text-danger small mt-1" })
                        <div class="field-hint">Enter 13 digits without hyphens (-)</div>
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.CNIC, new { @class = "form-control form-control-fame", @readonly = true })
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Email</label>
                    @Html.TextBox("Mail", email, new { @class = "form-control form-control-fame", @readonly = "readonly" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Full Name *</label>
                    @Html.TextBoxFor(m => m.User_Name, new { @class = "form-control form-control-fame Name", @placeholder = "Enter your full name", @maxlength = "100" })
                    @Html.ValidationMessageFor(m => m.User_Name, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Country *</label>
                    @Html.DropDownListFor(item => item.CountryID, new SelectList(First_Aid_Made_Easy.BLL.Common.Country, "Code", "Name"), "Select Country", new { @class = "form-control form-control-fame" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Mobile Number</label>
                    @Html.TextBoxFor(m => m.User_Mobile, new { @class = "form-control form-control-fame", @readonly = true })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">City</label>
                    @Html.TextBoxFor(m => m.City, new { @class = "form-control form-control-fame", @placeholder = "Your city" })
                    @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger small mt-1" })
                </div>
            </div>
        </div>
    </div>

    <!-- Family & Sponsor -->
    <div class="profile-card mb-4">
        <div class="form-section p-4 p-md-5">
            <div class="section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Family & Sponsor
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label-fame">Father's Name *</label>
                    @Html.TextBoxFor(m => m.User_FatherName, new { @class = "form-control form-control-fame Name", @placeholder = "Father's full name", @maxlength = "200" })
                    @Html.ValidationMessageFor(m => m.User_FatherName, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Father/Sponsor Profession</label>
                    @Html.TextBoxFor(m => m.FatherProfession, new { @class = "form-control form-control-fame", @placeholder = "Profession", @maxlength = "200" })
                    @Html.ValidationMessageFor(m => m.FatherProfession, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Sponsor Name (if other than father)</label>
                    @Html.TextBoxFor(m => m.SponserProfession, new { @class = "form-control form-control-fame", @placeholder = "Sponsor name & profession", @maxlength = "200" })
                    @Html.ValidationMessageFor(m => m.SponserProfession, "", new { @class = "text-danger small mt-1" })
                </div>
            </div>
        </div>
    </div>

    <!-- Professional Information -->
    <div class="profile-card mb-4">
        <div class="form-section p-4 p-md-5">
            <div class="section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                Professional Information
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label-fame">Job Designation</label>
                    @Html.DropDownListFor(item => item.OccupationID, new SelectList(ViewBag.Occupation, "Master_ID", "Master_Value"), "Select Designation", new { @class = "form-control form-control-fame" })
                    @Html.ValidationMessageFor(m => m.OccupationID, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Job Location</label>
                    @Html.TextBoxFor(m => m.JobLocation, new { @class = "form-control form-control-fame", @placeholder = "Where you work" })
                    @Html.ValidationMessageFor(m => m.JobLocation, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Year of Graduation</label>
                    @Html.TextBoxFor(m => m.YearOfMBBS, new { @class = "form-control form-control-fame", @placeholder = "e.g. 2024", @maxlength = "4" })
                    @Html.ValidationMessageFor(m => m.YearOfMBBS, "", new { @class = "text-danger small mt-1" })
                </div>

                <div class="col-md-6">
                    <label class="form-label-fame">Institute</label>
                    @Html.TextBoxFor(m => m.Institute, new { @class = "form-control form-control-fame", @placeholder = "Medical college / university" })
                    @Html.ValidationMessageFor(m => m.Institute, "", new { @class = "text-danger small mt-1" })
                </div>
            </div>
        </div>
    </div>

    <!-- CNIC Documents -->
    <div class="profile-card mb-4">
        <div class="form-section p-4 p-md-5">
            <div class="section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="4" x2="9" y2="20"/></svg>
                CNIC Documents
            </div>

            <div class="row g-4">
                <div class="col-sm-6">
                    <label class="form-label-fame">CNIC Front</label>
                    @if (IsAccepted && !string.IsNullOrEmpty(Model.CNICFront))
                    {
                        <div><img src="@Url.Content("~/Images/" + Model.CNICFront)" class="cnic-img-preview" alt="CNIC Front" /></div>
                    }
                    else
                    {
                        <label class="upload-zone d-block" for="CNICFrontFile">
                            @if (!string.IsNullOrEmpty(Model.CNICFront))
                            {
                                <img src="@Url.Content("~/Images/" + Model.CNICFront)" style="max-height:80px;border-radius:6px;margin-bottom:0.5rem;" />
                                <p>Click to change</p>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                <p>Upload CNIC Front (PNG, JPG)</p>
                            }
                            <input type="file" name="CNICFrontFile" id="CNICFrontFile" accept=".png,.jpg,.jpeg" style="display:none;" />
                        </label>
                    }
                </div>
                <div class="col-sm-6">
                    <label class="form-label-fame">CNIC Back</label>
                    @if (IsAccepted && !string.IsNullOrEmpty(Model.CNICBack))
                    {
                        <div><img src="@Url.Content("~/Images/" + Model.CNICBack)" class="cnic-img-preview" alt="CNIC Back" /></div>
                    }
                    else
                    {
                        <label class="upload-zone d-block" for="CNICBackFile">
                            @if (!string.IsNullOrEmpty(Model.CNICBack))
                            {
                                <img src="@Url.Content("~/Images/" + Model.CNICBack)" style="max-height:80px;border-radius:6px;margin-bottom:0.5rem;" />
                                <p>Click to change</p>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                <p>Upload CNIC Back (PNG, JPG)</p>
                            }
                            <input type="file" name="CNICBackFile" id="CNICBackFile" accept=".png,.jpg,.jpeg" style="display:none;" />
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Save button -->
    <div class="d-flex justify-content-end mb-5">
        <button type="submit" class="btn-fame-save">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-3px;margin-right:6px;"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save Changes
        </button>
    </div>
</form>

@section scripts{
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Profile Updated!',
                text: 'Your account details have been saved successfully.',
                confirmButtonColor: '#0F766E'
            })
        </script>
    }
    @if (Model != null)
    {
        <script>
            $(document).ready(function () {
                $("#CountryID").val(@Model.CountryID).change();
                var yom = "@Model.YearOfMBBS";
                if (yom && yom !== "") { $("#YearOfMBBS").val(yom); }
            });
        </script>
    }
    <script>
        $(document).ready(function () {
            // Name fields: letters and spaces only
            $(".Name").keypress(function (event) {
                return /[a-z ]/i.test(event.key);
            });

            // Numeric-only fields
            $(document).on("keypress", "#User_Mobile, #YearOfMBBS, #CNIC", function (event) {
                return /[0-9]/.test(event.key);
            });

            // Avatar preview on file select
            $("#User_PicFile").change(function () {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        var existing = document.getElementById('avatarPreview');
                        var placeholder = document.getElementById('avatarPlaceholder');
                        if (existing) {
                            existing.src = e.target.result;
                        } else if (placeholder) {
                            var img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'profile-avatar';
                            img.id = 'avatarPreview';
                            img.alt = 'Profile';
                            placeholder.parentNode.replaceChild(img, placeholder);
                        }
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        });
    </script>
}
