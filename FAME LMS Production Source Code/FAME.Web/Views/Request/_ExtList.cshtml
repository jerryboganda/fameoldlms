@model First_Aid_Made_Easy.Models.RequestVM
@{
    int Sr = 0;
    var list = Model.List.OrderByDescending(x => x.RequestDate).ToList();
}
<table id="DTable" class="table  table-bordered">
    <thead>
        <tr style="background-color: #364e9c">
            <th>Date</th>
            <th>Name</th>
            <th>Email/Ph. No.</th>
            <th style="min-width:150px">Package</th>
            <th title="Duration">Dur</th>
            <th>Price</th>
            <th>Payment</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in list)
        {
            Sr++;
            <tr>
                <td>@string.Format("{0:dd/MM/yyy}", i.RequestDate)</td>
                <td><a href="/Admin/StudentDetail/@i.User_Id">@(i.StudentName)</a></td>
                <td>@i.StudentEmail<br />@i.Student_Mobile</td>
                <td>@i.PackageName</td>
                <td>@(new First_Aid_Made_Easy.BLL.PackageRepository().getText(i.Duration).Replace("--- Rs.", ""))</td>
                <td>@string.Format("{0:n0}", i.Price)</td>
                <td>@i.Payment</td>
                <td>
                    @if (i.IsAccepted == true)
                    {
                        <a href="#" class="text-success"><i class="fa fa-check-circle Font20"></i><i class="fa fa-check-circle Font20"></i></a>
                    }
                    else
                    {
                        <a href="#" data-packid="@i.PackageID" data-id="@i.RequestID" id="btnAccept" vlaue="" class="text-warning"><i class="fa fa-check-circle Font20"></i></a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>