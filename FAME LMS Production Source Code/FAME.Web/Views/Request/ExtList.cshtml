@model First_Aid_Made_Easy.Models.RequestVM
@{
    ViewBag.Title = "Request";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

    <!-- DateRangePicker -->
    <link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">@(ViewBag.Type == 2 ? "AMI " : "" ) Ext. Request List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        @(ViewBag.Type == 2 ? "AMI " : "" ) Ext. Request List
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <div class="col-md-4">
                        <input id="dateRange" type="text" class="form-control" data-daterangepicker-locale-format="MM/DD/YYYY" placeholder="Select A Date Range" data-toggle="daterangepicker" data-daterangepicker-ranges="true" data-daterangepicker-drops="down">
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        @Html.Partial("_ExtList")
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="accept-modal" class="w3-modal">
        <div class="w3-modal-content">
            <header class="w3-container w3-indigo">
                <span onclick="document.getElementById('accept-modal').style.display='none'"
                      class="w3-button w3-display-topright">&times;</span>
                <h2 class="modal-title" style="color:white" id="accept-modal-title">Accept Extension Request</h2>
            </header>
            <div class="w3-container">
                @Html.Hidden("ReqID")
                <div class="form-row">
                    <div class="col-12 col-md-12 mb-3">
                        <label class="form-label">Price</label>
                        @Html.TextBox("Price", "", new { @class = "form-control", @type = "number", @placeholder = "Price for subscription", })
                    </div>
                    <div class="col-12 col-md-12 mb-3">
                        <label class="form-label">Duration</label>
                        @Html.DropDownList("Duration", new SelectList(new List<SelectListItem>(), "Value", "Text"), "Select Duration", new { @class = "form-control" })
                    </div>
                </div>
                <div class="modal-footer pb-0 px-0">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('accept-modal').style.display='none'">Close</button>
                    <button type="button" class="btn btn-primary" id="start-Accept">Accept</button>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->

    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable();
        })
        var btn;
        $(document).on("click", "#btnAccept", function () {
            var id = $(this).data('id');
            var Packid = $(this).data('packid');
            btn = $(this)
            LoadDurations(Packid);
            $("#ReqID").val(id);
            $("#accept-modal").show();
        })

        $(document).on("click", "#start-Accept", function () {
            var reqID = $("#ReqID").val();
            var Price = $("#Price").val();
            var Duration = $("#Duration option:selected").val();
            if (reqID > 0 && Price > 0 && Duration > 0) {
                $("#accept-modal").hide();
                $.ajax({
                    url: "/Enrollment/AcceptExtRequest/" + reqID,
                    data: { Price: Price, Duration: Duration },
                    beforeSend: function () {
                        swal.fire({
                            html: '<h5>Loading...</h5>',
                            showConfirmButton: false,
                            onRender: function () {
                                $('.swal2-content').prepend(sweet_loader);
                            }
                        });
                    },
                    success: function (result) {
                        if (result) {
                            btn.hide();
                            Swal.fire(
                                'Accepted!',
                                'The Request Has Been Accepted.',
                                'success'
                            )
                        }
                    }, error: function (err) {
                        $("#accept-modal").show();
                        alert("Error" + err);
                    }
                })
            }
        })

        $(document).on("change", "#dateRange", function () {
            var id = $(this).data('id');
            var range = $(this).val();

            var Dates = range.split(" to ");
            var DateFrom = Dates[0];
            var DateTo = Dates[1];

            $("#divLoaderid").show();
            $.ajax({
                url: "/Request/ExtFilterList?DateFrom=" + DateFrom + "&DateTo=" + DateTo + "&Type=" + @ViewBag.Type ,
                method: "POST",
                success: function (result) {
                    if (result != null) {
                        $("#DTable").DataTable().destroy();
                        $("#divPartial").html(result);
                        $("#DTable").DataTable();
                    }
                    $("#divLoaderid").hide();
                }, error: function (err) {
                    alert("Error" + err);
                    $("#divLoaderid").hide();
                }
            })
        })


    function LoadDurations(PackID) {

        $.ajax({
            url: "/Package/LoadDuration/" + PackID,
            type: "GET",
            success: function (result) {
                var option = '<option selected disabled value="">Please Select</option>';
                $.each(result, function (i, val) {
                    option = option + `<option data-id="${val.ID}" value="${val.Value}">${val.Text}</option>`;
                })
                $("#Duration").html(option);
            },
            error: function (err) {
            }
        })
    }
    </script>

}

