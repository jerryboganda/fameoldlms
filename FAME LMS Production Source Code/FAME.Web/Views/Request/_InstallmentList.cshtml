@model First_Aid_Made_Easy.Models.StudentInstallmentVM
@{
    int Sr = 0;
}
<table style="width:100% !important" id="DTable" class="table table-bordered">
    <thead>
        <tr style="background-color: #364e9c">
            <th>Ins No.</th>
            <th>Date</th>
            <th>Email</th>
            <th>Price</th>
            <th>Status</th>
            <th>Package</th>
            <th style="min-width:80px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.List)
        {
            Sr++;
            <tr>
                <td>@i.InstallmentNo</td>
                <td>@string.Format("{0:dd/MM/yyy}", i.InstallmentDate)</td>
                <td>@i.Student</td>
                <td>@string.Format("{0:n0}", i.InstallmentPrice)</td>
                <td>@i.IsPaid</td>
                <td>@i.PackageName</td>
                <td>
                    @if (i.IsPaid == true)
                    {
                        <a href="#" class="text-success"><i class="fa fa-check-circle Font20"></i><i class="fa fa-check-circle Font20"></i></a>
                    }
                    else
                    {
                        <a href="#" data-id="@i.ID" id="btnAccept" vlaue="" class="text-warning"><i class="fa fa-check-circle Font20"></i></a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>