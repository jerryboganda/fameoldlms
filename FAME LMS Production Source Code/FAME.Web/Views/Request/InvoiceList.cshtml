@using First_Aid_Made_Easy.DAL
@model List<sp_lstEnrollStatus_Result>
@{
    ViewBag.Title = "Invoice";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";

    <!-- DateRangePicker -->
    <link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
}

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">@(ViewBag.Type == 2 ? "AMI " : "" ) Invoice List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        @(ViewBag.Type == 2 ? "AMI " : "" )  Invoice List
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <input id="dateRange" type="text" class="form-control" data-daterangepicker-locale-format="MM/DD/YYYY" placeholder="Select A Date Range" data-toggle="daterangepicker" data-daterangepicker-ranges="true" data-daterangepicker-drops="down">
                </div>

                <div class="col-md-5">
                    <label><input type="radio" value="true" name="IsEmailSent" /> Email Sent</label>&emsp;
                    <label><input type="radio" value="false" checked name="IsEmailSent" /> Not Sent</label>&emsp;
                    <label><input type="radio" value="" name="IsEmailSent" /> All </label>
                </div>
                <div class="col-md-12">
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        @Html.Partial("_InvoiceList")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable();
        })

        $(document).on("click", "#btnAccept", function () {
            var id = $(this).data('id');
            var tr = $(this).closest('tr');
            var Price = tr.find("#Price").val();
            var Status = tr.find("#Status").val();
            var btn = $(this);
            Swal.fire({
                title: 'Are you sure?',
                text: "Are You Sure You Want To Save The Changes ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Request/InvoiceSend/" + id + "?Price=" + Price + "&Status=" + Status,
                        method: "POST",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Loading...</h5>',
                                showConfirmButton: false,
                                onRender: function () {
                                    // there will only ever be one sweet alert open.
                                    $('.swal2-content').prepend(sweet_loader);
                                }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                btn.hide();
                                Swal.fire(
                                    'Accepted!',
                                    'The Invoice Has Been Sent.',
                                    'success'
                                )
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })

        $(document).on("click", "#btnDelete", function () {
            var id = $(this).data('id');
            var tr = $(this).closest('tr');
            Swal.fire({
                title: 'Are you sure?',
                text: "Are You Sure You Want To Delete The Invoice ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#858383',
                confirmButtonText: 'Yes Delete It!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Enrollment/DeleteInvoice/" + id,
                        method: "POST",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Loading...</h5>',
                                showConfirmButton: false,
                                onRender: function () {
                                    // there will only ever be one sweet alert open.
                                    $('.swal2-content').prepend(sweet_loader);
                                }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                tr.remove();
                                Swal.fire(
                                    'Deleted!',
                                    'The Invoice Has Been Deleted.',
                                    'success'
                                )
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })

        $(document).on("change", "#dateRange,input[name=IsEmailSent]", function () {
            var range = $(this).val();
            var IsEmailSent = $("input[name=IsEmailSent]:checked").val();
            var Dates = range.split(" to ");
            var DateFrom = Dates[0];
            var DateTo = Dates[1];

            $("#divLoaderid").show();
            $.ajax({
                url: "/Request/FilterInvoiceList?DateFrom=" + DateFrom + "&DateTo=" + DateTo + "&IsEmailSent=" + IsEmailSent,
                method: "POST",
                success: function (result) {
                    if (result != null) {
                        $("#DTable").DataTable().destroy();
                        $("#divPartial").html(result);
                        $("#DTable").DataTable();
                    }
                    $("#divLoaderid").hide();
                }, error: function (err) {
                    alert("Error" + err);
                    $("#divLoaderid").hide();
                }
            })
        })
    </script>

}

