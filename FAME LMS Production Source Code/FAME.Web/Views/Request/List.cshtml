@model First_Aid_Made_Easy.Models.RequestVM
@{
    ViewBag.Title = "Request";
    Layout = "~/Views/Shared/_LayoutTeacher.cshtml";
    string name = First_Aid_Made_Easy.BLL.Common.Universities.FirstOrDefault(y => y.Value == (int)ViewBag.Type).Text;

    <!-- DateRangePicker -->
    <link type="text/css" href="~/Content/assets/vendor/daterangepicker.css" rel="stylesheet">
}
    <style>
        .swal2-input{
            margin:auto !important;
        }
    </style>

<div class="pt-32pt">
    <div class="container-fluid page__container d-flex flex-column flex-md-row align-items-center text-center text-sm-left">
        <div class="flex d-flex flex-column flex-sm-row align-items-center">
            <div class="mb-24pt mb-sm-0 mr-sm-24pt">
                <h2 class="mb-0">@(name ) Request List</h2>
                <ol class="breadcrumb p-0 m-0">
                    <li class="breadcrumb-item"><a href="/Teacher/Index">Home</a></li>
                    <li class="breadcrumb-item active">
                        @(name )  Request List
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <div class="page-section border-bottom-2">
        <div style="margin: 0; max-width: 100%" class="container-fluid page__container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-separator">
                        <div class="page-separator__text">Basic information</div>
                    </div>
                    <div class="col-md-4">
                        <input id="dateRange" type="text" class="form-control" data-daterangepicker-locale-format="MM/DD/YYYY" placeholder="Select A Date Range" data-toggle="daterangepicker" data-daterangepicker-ranges="true" data-daterangepicker-drops="down">
                    </div>
                    <div class="table-responsive" style="margin-top:20px" id="divPartial">
                        @Html.Partial("_List")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <!-- DateRangePicker -->
    <script src="~/Content/assets/vendor/moment.min.js"></script>
    <script src="~/Content/assets/vendor/daterangepicker.js"></script>
    <script src="~/Content/assets/js/daterangepicker.js"></script>
    @Scripts.Render("~/Scripts/List")

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success("Data Saved Successfully");
        </script>
    }

    <script>
        $(document).ready(function () {
            $("#DTable").DataTable();
        })

        $(document).on("click", "#btnAccept", function () {
            var id = $(this).data('id');
            var btn = $(this);
            Swal.fire({
                title: 'Enter Price',
                input: 'number',
                inputLabel: 'Please enter the price for this enrollment:',
                inputAttributes: {
                    min: 0,
                    step: 0.01
                },
                showCancelButton: true,
                confirmButtonText: 'Submit',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value || isNaN(value) || value <= 0) {
                        return 'Please enter a valid price';
                    }
                }
            }).then((inputResult) => {
                if (inputResult.isConfirmed) {
                    var price = inputResult.value;
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "Are You Sure You Want To Accept The Enrollment ?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: "/Enrollment/AcceptRequest/" + id + "?price=" + price,
                                method: "POST",
                                beforeSend: function () {
                                    swal.fire({
                                        html: '<h5>Loading...</h5>',
                                        showConfirmButton: false,
                                        onRender: function () {
                                            // there will only ever be one sweet alert open.
                                            $('.swal2-content').prepend(sweet_loader);
                                        }
                                    });
                                },
                                success: function (result) {
                                    if (result) {
                                        btn.hide();
                                        Swal.fire(
                                            'Accepted!',
                                            'The Request Has Been Accepted.',
                                            'success'
                                        )
                                    }
                                }, error: function (err) {
                                    alert("Error" + err);
                                }
                            })
                        }
                    })
                }
            })
        })

        $(document).on("click", "#btnDelete", function () {
            var id = $(this).data('id');
            var tr = $(this).closest('tr');
            Swal.fire({
                title: 'Are you sure?',
                text: "Are You Sure You Want To Delete The Request ?",
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#858383',
                confirmButtonText: 'Yes Delete It!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Enrollment/DeleteRequest/" + id,
                        method: "POST",
                        beforeSend: function () {
                            swal.fire({
                                html: '<h5>Loading...</h5>',
                                showConfirmButton: false,
                                onRender: function () {
                                    // there will only ever be one sweet alert open.
                                    $('.swal2-content').prepend(sweet_loader);
                                }
                            });
                        },
                        success: function (result) {
                            if (result) {
                                tr.remove();
                                Swal.fire(
                                    'Deleted!',
                                    'The Request Has Been Deleted.',
                                    'success'
                                )
                            }
                        }, error: function (err) {
                            alert("Error" + err);
                        }
                    })

                }
            })
        })

        $(document).on("change", "#dateRange", function () {
            var id = $(this).data('id');
            var range = $(this).val();

            var Dates = range.split(" to ");
            var DateFrom = Dates[0];
            var DateTo = Dates[1];

            $("#divLoaderid").show();
            $.ajax({
                url: "/Request/FilterList?DateFrom=" + DateFrom + "&DateTo=" + DateTo + "&Type=" + @ViewBag.Type ,
                method: "POST",
                success: function (result) {
                    if (result != null) {
                        $("#DTable").DataTable().destroy();
                        $("#divPartial").html(result);
                        $("#DTable").DataTable();
                    }
                    $("#divLoaderid").hide();
                }, error: function (err) {
                    alert("Error" + err);
                    $("#divLoaderid").hide();
                }
            })
        })
    </script>

}

