    <add name="FAME_CodeFirst" connectionString="data source=SERVER_OR_INSTANCE;initial catalog=FAME_DB;Integrated Security=True;MultipleActiveResultSets=True;Connection Timeout=60" providerName="System.Data.SqlClient" />
